    "image_with_text_jV7zEV": {
      "type": "image-with-text",
      "blocks": {
        "heading_QeHVLB": {
          "type": "heading",
          "settings": {
            "heading": "Free Pick Up",
            "heading_size": "h1"
          }
        },
        "text_xLU8D9": {
          "type": "text",
          "settings": {
            "text": "<p>Want to save on delivery fees?<br/>You can collect your order from one of our <strong>30+ pickup points across Brisbane with no delivery fee</strong>. The minimum order for pick-up is $50, and a $2 temporary fuel levy applies<br/></p><p>These locations are hosted by our wonderful customers who open their homes or businesses to help make fresh food more accessible in their community.</p><p>Each pickup location has a scheduled delivery day. We'll send you a text message before your collection day with an estimated delivery time and another message once your order has arrived.</p><p>If your order includes chilled or frozen items, we pack them carefully with ice packs to keep them cold until you collect.</p><p>We simply ask that you collect your box within <strong>a few hours of delivery</strong> to keep everything fresh.</p>",
            "text_style": "body"
          }
        },
        "button_TyT9eB": {
          "type": "button",
          "settings": {
            "button_label": "How Pick-up works",
            "button_link": "shopify://pages/collecting-from-a-pick-up-point",
            "button_style_secondary": false
          }
        }
      },
