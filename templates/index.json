{"sections":{"slideshow_new_we9MgY":{"type":"slideshow-new","blocks":{"slide_tW3NnC":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Colourful_fruit_and_veg.jpg","heading":"real Food, Real Joy","heading_size":"h0","subheading":"Better food, straight to your door","button_label":"Shop with Joy","link":"shopify:\/\/collections","button_style_secondary":false,"box_align":"middle-left","show_text_box":true,"text_alignment":"left","image_overlay_opacity":0,"color_scheme":"accent-2","text_alignment_mobile":"center","image_alignment_mobile":"ccenter"}},"slide_rK7ydC":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Ultimate_Organic_Farm_Box.jpg","heading":"Food You Can Trust","heading_size":"h0","subheading":"No nasties. No mystery sprays. Just honest food from real farmers.","button_label":"Shop Now","link":"shopify:\/\/collections","button_style_secondary":false,"box_align":"middle-left","show_text_box":true,"text_alignment":"left","image_overlay_opacity":0,"color_scheme":"accent-2","text_alignment_mobile":"left","image_alignment_mobile":"ccenter"}},"slide_xLXeEY":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Randall_Breen_Echo_Valley_Farm.jpg","heading":"Grown with Care","heading_size":"h0","subheading":"Every box supports real farmers and food makers who nurture their soil with care.","button_label":"Meet the Farmers","link":"https:\/\/joywholefoods.com.au\/blogs\/farmers-and-makers","button_style_secondary":false,"box_align":"middle-left","show_text_box":true,"text_alignment":"left","image_overlay_opacity":0,"color_scheme":"accent-2","text_alignment_mobile":"left","image_alignment_mobile":"ccenter"}},"slide_9gC8xq":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Big_Harvest_Box.jpg","heading":"Taste the Difference","heading_size":"h0","subheading":"Crunchy, juicy, full of life. The kind of flavour that makes you smile.","button_label":"Shop Fruit & Veg","link":"shopify:\/\/collections\/farm-fresh-organics-spray-