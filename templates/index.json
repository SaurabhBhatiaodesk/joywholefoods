":{"type":"featured_collection","settings":{"collection":"spray-free-organic-fruit-and-veg-box-delivery","custom_title":""}},"featured_collection_amKw9i":{"type":"featured_collection","settings":{"collection":"organic-spray-free-fruit-and-veggie-store-brisbane-gold-coast","custom_title":""}},"featured_collection_8JLUMg":{"type":"featured_collection","settings":{"collection":"meal-kits","custom_title":""}},"0a2798a6-f012-4773-af09-2135d33ff829":{"type":"featured_collection","settings":{"collection":"local-organic-meat-delivery","custom_title":"Butcher"}},"b1acab25-d782-4532-b0fa-04fb8574cb1a":{"type":"featured_collection","settings":{"collection":"local-organic-fridge-food-delivery","custom_title":"Fridge & Freezer"}},"da0104ae-ab74-4ffb-a302-4816f65da021":{"type":"featured_collection","settings":{"collection":"local-organic-bakery-bread-delivery","custom_title":""}},"208c00ef-1853-49e3-9e1c-dde5607a3b82":{"type":"featured_collection","settings":{"collection":"pantry-preservative-free-fresh-made-healthy-natural-ingredients","custom_title":"Pantry"}},"c1b16b7e-0b51-458e-8350-3f8dad0d07b5":{"type":"featured_collection","settings":{"collection":"local-organic-drinks-beverages-delivery","custom_title":"Beverages"}},"bf61f302-6099-43c0-9c1c-91b2af777867":{"type":"featured_collection","settings":{"collection":"organic-spray-free-fruit-and-vegetable-shops-delivery-brisbane-gold-coast","custom_title":""}},"01313ec3-fad2-464b-9685-688e56e483b3":{"type":"featured_collection","settings":{"collection":"organic-household-personal-care-delivery","custom_title":"Home & Body"}}},"block_order":["6527ad36-298a-4fd0-abc0-edeccebdacfd","template--16842321985751__99325616-fda7-4ecc-b862-78354c16640e-featured_collection-3","template--16842321985751__99325616-fda7-4ecc-b862-78354c16640e-featured_collection-1","featured_collection_amKw9i","featured_collection_8JLUMg","0a2798a6-f012-4773-af09-2135d33ff829","b1acab25-d782-4532-b0fa-04fb8574cb1a","da0104ae-ab74-4ffb-a302-4816f65da021","208c00ef-1853-49e3-9e1c-dde5607a3b82","c1b16b7e-0b51-458e-8350-3f8dad0d07b5","bf61f302-6099-43c0-9c1c-91b2af777867","01313ec3-fad2-464b-9685-688e56e483b3"],"custom_css":[],"settings":{"title":"Healthy Food Made Easy","sub-title":"Shop spray-free and certified organic produce, regenerative meats, pantry staples and more.","heading_size":"h1","image_ratio":"portrait","columns_desktop":4,"color_scheme":"background-1","show_view_all":false,"columns_mobile":"2","swipe_on_mobile":false,"padding_top":36,"padding_bottom":36,"button_text_color":"#ffffff","css_class":"home__collection-list"}},"d75925f5-537c-422d-b75b-c5ff80dbd16b":{"type":"image-with-text","blocks":{"template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-heading-1":{"type":"heading","settings":{"heading":"Meet the Founders","heading_size":"h2"}},"template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-text-1":{"type":"text","settings":{"text":"<p><strong>Hey, we’re Kristen and Trevor.<\/strong><\/p><p>What began in 2015 with a boot full of produce and a desire to feed our own family better food quickly grew into Spray-Free Farmacy, a community of farmers and families who care about how food is grown.<\/p><p>Today, as Joy Wholefoods, we work directly with farmers who nurture healthy soil, care for their animals and provide incredible food for families across South East Queensland.<\/p>","text_style":"body"}},"sub_heading_block_H7KPcR":{"type":"sub_heading_block","disabled":true,"settings":{"sub_heading_block_image":"shopify:\/\/shop_images\/1_dbb58d65-12d8-4220-bd3c-dd6682353cb6.png","sub_heading_block_title":"Local Farmers Who Care","sub_heading_block_text":"<p>We work directly with organic and spray free growers who farm with care and respect for the land. Good soil. Good food. Good health. For all of us.<br\/><\/p>"}},"sub_heading_block_a4ec4j":{"type":"sub_heading_block","disabled":true,"settings":{"sub_heading_block_image":"shopify:\/\/shop_images\/6_78f7aa9f-7085-4616-8ade-a1055848a7f7.png","sub_heading_block_title":"Easy Ordering & Delivery","sub_heading_block_text":"<p>Free pickup from 30+ locations<br\/>Home delivery for just $12.50<br\/>Free delivery for Brisbane orders over $200<\/p>"}},"template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-button-1":{"type":"button","settings":{"button_label":"Our Story","button_link":"shopify:\/\/pages\/our-story","button_style_secondary":false}}},"block_order":["template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-heading-1","template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-text-1","sub_heading_block_H7KPcR","sub_heading_block_a4ec4j","template--16842321985751__d75925f5-537c-422d-b75b-c5ff80dbd16b-button-1"],"custom_css":[".image-with-text__content {padding-right: 0;}","@media (max-width: 767px) {.image-with-text__content {padding-left: 0; padding-right: 0; }}"],"settings":{"image":"shopify:\/\/shop_images\/Spray_Free_Farmacy_1.png","height":"medium","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"accent-1","image_behavior":"none","mobile_content_alignment":"center","padding_top":64,"padding_bottom":36,"mobile_padding_top":40,"mobile_padding_bottom":0}},"rich_text_RDR9Cz":{"type":"rich-text","blocks":{"heading_qqhN3i":{"type":"heading","settings":{"heading":"Why choose organic?","heading_size":"h1"}},"text_ayh3Eg":{"type":"text","settings":{"text":"<p>Food gets its nutrients from the soil it grows in. When that soil is heavily treated with pesticides and chemicals, it affects the food we eat and washing produce can’t change that.<\/p><p>Organic, spray-free and regenerative farming focuses on building healthy soil, which produces more nutrient dense food. That means better flavour, better nutrition and better health.<\/p><p><strong>Choose wisely. Your future self will thank you.<\/strong><\/p>"}},"button_qyLeCY":{"type":"button","settings":{"button_label":"Why it matters","button_link":"shopify:\/\/pages\/why-spray-free","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["heading_qqhN3i","text_ayh3Eg","button_qyLeCY"],"name":"t:sections.rich-text.presets.name","settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"scheme-1ddcb3b1-8f57-401e-88aa-a2139636431e","full_width":true,"padding_top":40,"padding_bottom":52}},"image_with_text_mYCzX4":{"type":"image-with-text","blocks":{"caption_HT3WEN":{"type":"caption","settings":{"caption":"The Breen Family from Echo Valley FArm","text_style":"caption-with-letter-spacing","text_size":"medium"}},"heading_ePK8Lf":{"type":"heading","settings":{"heading":"Know your farmer","heading_size":"h2"}},"text_pPrPFW":{"type":"text","settings":{"text":"<p><strong>Most people have no idea where their food comes from.<\/strong><\/p><p>At Joy Wholefoods, we believe food should have a face. When you know the farmers behind your food and how it’s grown, eating becomes something deeper and more joyful.<\/p><p>We work directly with farmers who care for their soil, animals and land, and we pay them fairly for the incredible work they do rebuilding soil health and growing truly nourishing food.<\/p><p>Supporting these farmers is more than buying food. It’s casting a vote for a healthier future for our children and the generations that follow.<\/p><p>Pay the farmer now, or the doctor later.<\/p>","text_style":"body"}},"button_7tPRpD":{"type":"button","settings":{"button_label":"Meet the Farmers","button_link":"shopify:\/\/blogs\/farmers-and-makers","button_style_secondary":false}}},"block_order":["caption_HT3WEN","heading_ePK8Lf","text_pPrPFW","button_7tPRpD"],"custom_css":[".image-with-text__content {padding-right: 40px;}","@media (max-width: 767px) {.image-with-text__content {padding-left: 0; padding-right: 0; }}"],"settings":{"image":"shopify:\/\/shop_images\/Echo_Valley_Farm_1.jpg","height":"medium","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"accent-1","image_behavior":"none","mobile_content_alignment":"center","padding_top":64,"padding_bottom":36,"mobile_padding_top":40,"mobile_padding_bottom":0}},"testimonial_DHnNQi":{"type":"testimonial","blocks":{"review_nynUyR":{"type":"review","settings":{"title":"Since I started ordering the seasonal boxes from Joy Wholefoods, I’ve been trying so many different vegetables that I would never normally buy at the supermarket. It has inspired me to get creative and think of new ways to cook and enjoy them.\n\nThe quality of the vegetables is amazing. The skins are so tender, and even my kids, who used to be picky, now love eating fresh salads. Even capsicums, which can sometimes taste bitter, are so fresh and tender that I can slice them very thinly and we enjoy them raw in our salads.\n\nThank you, Joy Wholefoods, for always providing such fresh, delicious produce. We truly appreciate it!","reviewer_name":"Yoko Anderson","rating":5}},"review_hP6cFR":{"type":"review","settings":{"title":"I’ve been ordering from Joy Wholefoods for almost a year now, and the quality is always 10\/10. Every order arrives fresh and you can really taste the difference.\n\nIt’s been so hard to find a company that delivers organic food to our rural country town, so finding Joy Wholefoods has been amazing.\n\nI love supporting Australian farmers, and it feels so good knowing that the food I’m putting into my body is good for me and good for my family. Choosing organic has been one of the best decisions we’ve made.\n\nA huge thank you as well for the occasional little free goodies you include in my order. It’s such a thoughtful touch and always makes my day. It really makes me feel appreciated as a loyal customer.\n\nOrganic food is definitely the way to go and I couldn’t recommend Joy Wholefoods enough! 🍓🥑🍇🍉","reviewer_name":"Samantha Bayne","rating":5}},"review_GJgNCz":{"type":"review","settings":{"title":"The ordering is easy, delivery is reliable, and I love knowing exactly where my food comes from. It feels great to support a store that values health, quality, and sustainability 💚💚","reviewer_name":"Emil Raju","rating":5}},"review_trTF77":{"type":"review","settings":{"title":"Every week I am impressed by the quality of the produce, excited by the taste and thrilled how well my fruit and vegetables store. Absolutely outstanding.","reviewer_name":"Elyza Wilson","rating":5}},"review_ABQgwm":{"type":"review","settings":{"title":"Fantastic fresh food and fantastic service. Highly recommend.","reviewer_name":"Marcelle Holdaway","rating":5}},"review_h66qBC":{"type":"review","settings":{"title":"Spray Free Farmacy boxes have really fresh beautiful fruit and veg, plus have a good range of different meats and milk, I love it! Ordering is easy and making swaps is also easy. Great communication about farming methods and sprays are very transparent and helpful, I would highly recommend!","reviewer_name":"Laura Mahadevan","rating":5}},"review_V8Mhpd":{"type":"review","settings":{"title":"I love ordering from SFF! All the food and produce is great quality. Ordering is easy and beats going to the shops with kids!","reviewer_name":"Serena Willems","rating":5}},"review_iLmjtp":{"type":"review","settings":{"title":"I've been getting our fruit and veg from Spray Free Farmacy for several weeks, and I'm consistently impressed with the quality. The produce is always fresh, full of flavour, and clearly grown with care. Ordering is easy, and deliveries are always on time. You can tell how good it is the moment you open the box — the aroma alone speaks to its freshness. It's healthy, locally sourced, and better for people and the planet.","reviewer_name":"Brett Christensen","rating":5}},"review_JXVpYm":{"type":"review","settings":{"title":"I love purchasing my Spray Free Organic Fresh food from Spray Free Farmacy. Fruit and veges are fresh and very good quality. Love the grass-fed meat and other products in their shop too. We are very fortunate to have this service. A+ very nice people, awesome communication, and delivery service is very reliable. Spray Free Farmacy thank you!","reviewer_name":"Maria N","rating":5}},"review_3JMcN9":{"type":"review","settings":{"title":"I have been using Spray Free Farmacy for over a month now and I love the quality of the produce and the fact I can swap out a few things if needed. It’s wonderful to have options for ethically sourced safe food so close to home. I do a combination of pickup or delivery depending on my schedule and will continue to use these guys in future.","reviewer_name":"Simone Johnston","rating":5}},"review_khFYcD":{"type":"review","settings":{"title":"It makes such a difference eating produce you know has been lovingly grown and lovingly handled by the SFF team. I’ve just received a delivery and it was bursting with vitality. Awesome!","reviewer_name":"Vitali Roberts","rating":5}},"review_aEadxb":{"type":"review","settings":{"title":"I’ve been using Spray Free Farmacy for about a year now and couldn’t be happier. The produce is always incredibly fresh, high quality, and genuinely organic and spray-free — you can really taste the difference. Their communication is excellent, with informative emails and great educational content that help me make better food choices.","reviewer_name":"Candice Kennedy","rating":5}},"review_eq4Xne":{"type":"review","settings":{"title":"I love knowing that no harmful chemicals are used to grow my fruit and vege. The quality at Sprayfree Farmacy is always fantastic (even my picky hubby agrees!). We love the meat too (after trying other companies my hubby didn't like). The food has so much more flavour. I love the convenience of my box being dropped at my door without any fuss.","reviewer_name":"Jillian Sison","rating":5}}},"block_order":["review_nynUyR","review_hP6cFR","review_GJgNCz","revie