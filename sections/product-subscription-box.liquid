
{% schema %}
{
  "name": "Customise Your Box",
  "class": "Waste cycle",
  "settings": [
      {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lorem ipsum"
      },
      {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#043D22"
      },         
      {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 36
      },
      {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 36
      }
  ],
  "blocks":[
    {
        "type": "Card",
        "name": "Card",
        "limit": 4 , 
        "settings": [
            {
                "type": "image_picker",
                "id": "card_image",
                "label": "Image"  
            },
            {
                "type": "text",
                "id": "card_title",
                "label": "Card title",
                "default": "Lorem ipsum"
            },
            {
                "type": "text",
                "id": "tag_day",
                "label": "Day",
                "default": "Lorem ipsum"
            }, 
            {
                "type": "text",
                "id": "sub_heading",
                "label": "Sub Heading",
                "default": "Lorem ipsum"
            }
        ]
    }
  ],
  "presets": [
    {
        "name": "Waste cycle",
        "category": "Waste cycle"
    }
  ]
}
{% endschema %}  