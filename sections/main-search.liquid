{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 3rem;
  }

  .quick-add {
    width: 100%;
  }

  .article-card-wrapper .card--standard > .card__content .card__information {
    padding-left: 0;
    padding-right: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 0;
  }

  .collection .badge {
    background: #9bb83c;
    color: white;
  }

  .card__badge,
  .restocking-soon-product-os a {
    font-family: "DM Sans 9pt" !important;
  }

  a.button.button--primary,
  a.button {
    font-size: 16px;
    letter-spacing: -0.6px;
    font-weight: 500;
    height: 40px;
    text-decoration: none !important;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search__search .search {
    margin-top: 3rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 5rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }

  /* Keep every blog/article result card consistent on the search page. */
  .template-search #product-grid .article-card-wrapper {
    width: 100%;
    height: 100%;
  }

  .template-search #product-grid .article-card-wrapper .article-card,
  .template-search #product-grid .article-card-wrapper > .card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Force the same square media area, regardless of the uploaded image ratio. */
  .template-search #product-grid .article-card-wrapper .card__inner.ratio {
    --ratio-percent: 100% !important;
  }

  .template-search #product-grid .article-card-wrapper .card__media,
  .template-search #product-grid .article-card-wrapper .article-card__image-wrapper,
  .template-search #product-grid .article-card-wrapper .article-card__image,
  .template-search #product-grid .article-card-wrapper .media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .template-search #product-grid .article-card-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .template-search #product-grid .article-card-wrapper .card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .template-search #product-grid .article-card-wrapper .card__information {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  .template-search #product-grid .article-card-wrapper .button,
  .template-search #product-grid .article-card-wrapper [class*="read-more" i] {
    margin-top: auto;
    width: 100%;
  }

  /* Search product cards use the same Joy card structure as the collection page. */
  .template-search .product-grid > .grid__item {
    display: flex;
  }

  .template-search .product-grid > .grid__item > .card-wrapper-os,
  .template-search #product-grid .card-wrapper-os,
  .template-search #product-grid .card-wrapper-os .card,
  .template-search #product-grid .card-wrapper-os .product-notification {
    width: 100%;
    height: 100%;
  }

  .template-search #product-grid .card-wrapper-os .card {
    display: flex;
    flex-direction: column;
  }

  .template-search #product-grid .card-wrapper-os .product-notification {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .template-search #product-grid .card-wrapper-os .qty-atc-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: auto;
  }

  .template-search #product-grid .card-wrapper-os .quick-add.no-js-hidden,
  .template-search #product-grid .card-wrapper-os product-form,
  .template-search #product-grid .card-wrapper-os product-form form {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  .template-search #product-grid .card-wrapper-os .swap-product-btn-os {
    align-self: stretch;
    margin-top: auto;
  }

  .template-search .joy-product-card {
    width: 100%;
    height: 100%;
    border: 1px solid #9abf3f;
    border-radius: 8px;
    overflow: hidden;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    font-family: 'DM Sans', sans-serif;
  }

  .template-search .joy-product-image-link {
    position: relative;
    display: block;
    overflow: hidden;
    background: #f4f4f4;
    color: inherit;
    text-decoration: none;
  }

  .template-search .joy-product-image-link::before {
    content: "";
    display: block;
    padding-bottom: 100%;
  }

  .template-search .joy-product-image-link img,
  .template-search .joy-product-image-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .template-search .joy-product-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f2f3ed;
    color: #5d7434;
    font-size: 13px;
    text-align: center;
    padding: 18px;
  }

  .template-search .joy-product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    border-radius: 6px;
    background: #087840;
    color: #ffffff;
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .template-search .joy-product-quick-view {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: #ffffff;
    color: #789536;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
  }

  .template-search .joy-product-quick-view svg {
    width: 17px;
    height: 17px;
  }

  .template-search .joy-product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px 20px;
  }

  .template-search .joy-product-vendor {
    margin: 0 0 8px;
    color: #555555;
    font-size: 14px;
    line-height: 1.3;
  }

  .template-search .joy-product-title {
    margin: 0 0 16px;
    color: #005c25;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .template-search .joy-product-title a {
    color: inherit;
    text-decoration: none;
  }

  .template-search .joy-product-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .template-search .joy-card-variant-box {
    min-height: 147px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin-top: 0;
  }

  .template-search .joy-card-price-range {
    margin: 0;
    color: #111111;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
  }

  .template-search .joy-variant-form {
    display: grid;
    gap: 12px;
    margin-top: auto;
  }

  .template-search .joy-variant-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .template-search .joy-variant-label {
    color: #00733f;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }

  .template-search .joy-variant-select-wrap {
    position: relative;
  }

  .template-search .joy-variant-select {
    display: block;
    width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 0 42px 0 18px;
    border: 1px solid #b8d8ca;
    border-radius: 8px;
    background: #ffffff;
    color: #00735a;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    appearance: none;
    -webkit-appearance: none;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .template-search .joy-variant-select:focus,
  .template-search .joy-variant-select:focus-visible {
    border: 1px solid #b8d8ca !important;
    outline: none;
    box-shadow: none;
  }

  .template-search .joy-variant-select-wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 16px;
    width: 9px;
    height: 9px;
    border-right: 2px solid #00735a;
    border-bottom: 2px solid #00735a;
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }

  .template-search .joy-add-to-cart {
    width: 100%;
    min-height: 44px;
    border: 0;
    border-radius: 6px;
    background: #087840;
    color: #ffffff;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    transition: background .2s ease, opacity .2s ease;
  }

  .template-search .joy-add-to-cart:hover {
    background: #006b37;
  }

  .template-search .joy-add-to-cart:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  .template-search .joy-variant-message {
    min-height: 16px;
    color: #087840;
    font-size: 12px;
    line-height: 1.3;
  }

  .template-search .joy-variant-message.is-error {
    color: #b3261e;
  }

  .template-search #product-grid .card-wrapper-os .custom-addToCart-os,
  .template-search #product-grid .card-wrapper-os .quantity-selector-and-buyNow-wrapper-os,
  .template-search #product-grid .card-wrapper-os .restocking-soon-product-os,
  .template-search #product-grid .card-wrapper-os .view-product-os {
    display: none;
  }

  .template-search #product-grid .card-wrapper-os .custom-addToCart-os.active,
  .template-search #product-grid .card-wrapper-os .quantity-selector-and-buyNow-wrapper-os.active,
  .template-search #product-grid .card-wrapper-os .restocking-soon-product-os.active,
  .template-search #product-grid .card-wrapper-os .view-product-os.active {
    display: block;
    width: 100%;
  }

  .template-search #product-grid .card-wrapper-os .custom-add-to-cart-btn-os,
  .template-search #product-grid .card-wrapper-os .swap-product-btn-os {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    min-width: 0 !important;
    max-width: none !important;
    min-height: 40px;
    height: auto;
    padding: 10px 16px;
    border: 1px solid #086c3f !important;
    border-radius: 6px;
    background-color: #086c3f !important;
    color: #ffffff !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-indent: 0;
    text-decoration: none;
    white-space: normal;
    writing-mode: horizontal-tb;
    overflow: visible;
    box-sizing: border-box;
  }

  .template-search #product-grid .card-wrapper-os .custom-add-to-cart-btn-os.is-notify,
  .template-search #product-grid .card-wrapper-os .custom-add-to-cart-btn-os[data-notify-label] {
    min-height: 44px;
    border: 0;
    border-radius: 6px;
    background: #087840 !important;
    color: #ffffff !important;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    transition: background .2s ease, opacity .2s ease;
  }

  .template-search #product-grid .card-wrapper-os .custom-add-to-cart-btn-os.is-notify:hover,
  .template-search #product-grid .card-wrapper-os .custom-add-to-cart-btn-os[data-notify-label]:hover {
    background: #006b37 !important;
  }

  .template-search .joy-card-product-variant-picker {
    display: grid;
    gap: 8px;
    margin: 0 0 12px;
    font-family: 'DM Sans', sans-serif;
  }

  .template-search .joy-card-product-variant-picker__label {
    color: #00733f;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
  }

  .template-search .joy-card-product-variant-picker__select-wrap {
    position: relative;
  }

  .template-search .joy-card-product-variant-picker__select {
    width: 100%;
    min-height: 44px;
    padding: 0 42px 0 16px;
    border: 1px solid #b8d8ca;
    border-radius: 8px;
    background: #ffffff;
    color: #00735a;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    appearance: none;
    -webkit-appearance: none;
  }

  .template-search .joy-card-product-variant-picker__select-wrap::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 16px;
    width: 9px;
    height: 9px;
    border-right: 2px solid #00735a;
    border-bottom: 2px solid #00735a;
    transform: translateY(-65%) rotate(45deg);
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .template-search .joy-variant-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .template-search .joy-variant-select {
      min-height: 44px;
    }

    .template-search .joy-product-info {
      padding: 14px 14px 16px;
    }

    .template-search .joy-card-price-range {
      margin-bottom: 24px;
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="h2 center">
        {%- if search.performed -%}
          {{- 'templates.search.title' | t -}}
        {%- else -%}
          {{- 'general.search.search' | t -}}
        {%- endif -%}
      </h1>

      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}

        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >

              <label class="field__label" for="Search-In-Template">
                {{ 'general.search.search' | t }}
              </label>

              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  <div class="predictive-search__loading-state">
                    <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <svg class="icon icon-close" aria-hidden="true" focusable="false">
                  <use xlink:href="#icon-reset">
                </svg>
              </button>

              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <svg class="icon icon-search" aria-hidden="true" focusable="false">
                  <use xlink:href="#icon-search">
                </svg>
              </button>
            </div>
          </form>
        </main-search>

        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>

      {%- if search.performed -%}
        {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
          {%- if search.results_count > 0 -%}
            <p role="status">
              {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endif -%}
        {%- endunless -%}

        {%- if search.results_count == 0 and search.filters == empty -%}
          <p role="status">
            {{ 'templates.search.no_results' | t: terms: search.terms }}
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' and search.filters != empty -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide no-js-hidden">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>

                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>

                  {% render 'icon-caret' %}
                </div>
              </div>

              <noscript>
                <button type="submit" class="facets__button-no-js button button--secondary">
                  {{ 'products.facets.sort_button' | t }}
                </button>
              </noscript>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if search.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                  {%- elsif search.products_count == search.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                  {%- else -%}
                    {{ 'products.facets.product_count' | t: product_count: search.products_count, count: search.all_products_count }}
                  {%- endif -%}
                </span>
              </h2>

              <div class="loading-overlay__spinner">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div{% if section.settings.filter_type == 'vertical' %} class="facets-vertical page-width"{% endif %}>
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>

              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t }}<br>
                  {{ 'sections.collection_template.use_fewer_filters_html' | t: link: search_url, class: 'underlined-link link' }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>

              <ul
                class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {% assign product_items = search.results | where: 'object_type', 'product' %}
                {% assign article_items = search.results | where: 'object_type', 'article' %}
                {% assign page_items = search.results | where: 'object_type', 'page' %}

                {%- for item in product_items -%}
                  {%- if item.metafields.custom.hide_from_listings.value == true -%}{%- continue -%}{%- endif -%}
                  {%- if item != blank and item.object_type == 'product' and item.title != blank and item.url != blank -%}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}

                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                      {% endif %}
                    >
                      {% render 'card-product',
                        card_product: item,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        lazy_load: lazy_load,
                        skip_styles: false,
                        show_quick_add: section.settings.enable_quick_add,
                        section_id: section.id
                      %}

                      {%- unless item.has_only_default_variant -%}
                        <script type="application/json" data-joy-card-variant-data>
                          {
                            "productId": {{ item.id | json }},
                            "optionName": {{ item.options_with_values.first.name | default: 'Variant' | json }},
                            "fromPrice": {{ item.price_min | money | json }},
                            "selectedVariantId": {{ item.selected_or_first_available_variant.id | json }},
                            "variants": [
                              {%- for variant in item.variants -%}
                                {
                                  "id": {{ variant.id | json }},
                                  "title": {{ variant.title | json }},
                                  "price": {{ variant.price | money | json }},
                                  "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                                  "available": {{ variant.available | json }},
                                  "inventoryQuantity": {% if variant.inventory_quantity < 0 %}1000000{% else %}{{ variant.inventory_quantity | json }}{% endif %},
                                  "cartQuantity": {{ cart | item_count_for_variant: variant.id | json }},
                                  "min": {{ variant.quantity_rule.min | json }},
                                  "max": {% if variant.quantity_rule.max != null %}{{ variant.quantity_rule.max | json }}{% else %}null{% endif %},
                                  "step": {{ variant.quantity_rule.increment | json }}
                                }{% unless forloop.last %},{% endunless %}
                              {%- endfor -%}
                            ]
                          }
                        </script>
                      {%- endunless -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}

                {%- for item in article_items -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    {% render 'article-card',
                      article: item,
                      show_image: true,
                      show_date: section.settings.article_show_date,
                      show_author: section.settings.article_show_author,
                      show_badge: true,
                      media_aspect_ratio: 'square',
                      lazy_load: lazy_load
                    %}
                  </li>
                {%- endfor -%}

                {%- for item in page_items -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    <div class="article-card-wrapper card-wrapper underline-links-hover">
                      <div class="card card--card card--text ratio color-{{ settings.blog_card_color_scheme }}" style="--ratio-percent: 100%;">
                        <div class="card__content">
                          <div class="card__information">
                            <h3 class="card__heading">
                              <a href="{{ item.url }}" class="full-unstyled-link">
                                {{ item.title | truncate: 50 | escape }}
                              </a>
                            </h3>
                          </div>

                          <div class="card__badge {{ settings.badge_position }}">
                            <span class="badge color-{{ settings.color_schemes | first }}">
                              {{ 'templates.search.page' | t }}
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

{% if section.settings.image_shape == 'arch' %}
  {% render 'mask-arch' %}
{%- endif -%}

{% render 'swap_popup' %}

<script>
(function () {
  function initializeTabs(root) {
    const scope = root || document;

    scope.querySelectorAll('[data-joy-tabs-wrapper]').forEach(function (wrapper) {
      if (wrapper.dataset.joyTabsInitialized === 'true') return;

      wrapper.dataset.joyTabsInitialized = 'true';

      const scrollBox = wrapper.querySelector('[data-joy-tabs-scroll]');
      const prevBtn = wrapper.querySelector('[data-joy-tabs-prev]');
      const nextBtn = wrapper.querySelector('[data-joy-tabs-next]');

      if (!scrollBox || !prevBtn || !nextBtn) return;

      const getScrollAmount = function () {
        return Math.max(220, Math.floor(scrollBox.clientWidth * 0.65));
      };

      prevBtn.addEventListener('click', function () {
        scrollBox.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });
      });

      nextBtn.addEventListener('click', function () {
        scrollBox.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });
      });
    });
  }

  function updateCartCountBubble(itemCount) {
    const cartIcon = document.getElementById('cart-icon-bubble');
    const count = Number(itemCount) || 0;

    if (!cartIcon) return;

    let bubble = cartIcon.querySelector('.cart-count-bubble');

    if (count <= 0) {
      if (bubble) bubble.remove();
      return;
    }

    if (!bubble) {
      bubble = document.createElement('div');
      bubble.className = 'cart-count-bubble';
      cartIcon.appendChild(bubble);
    }

    bubble.textContent = '';

    const visibleCount = document.createElement('span');
    visibleCount.setAttribute('aria-hidden', 'true');

    const hiddenCount = document.createElement('span');
    hiddenCount.className = 'visually-hidden';

    visibleCount.textContent = count < 100 ? count : '';
    hiddenCount.textContent = count + ' item' + (count === 1 ? '' : 's');

    bubble.appendChild(visibleCount);
    bubble.appendChild(hiddenCount);
  }

  function refreshCartUi() {
    return fetch('/cart.js', {
      method: 'GET',
      headers: {
        Accept: 'application/json'
      }
    })
      .then(function (response) {
        if (!response.ok) return null;
        return response.json();
      })
      .then(function (cart) {
        if (!cart) return;

        updateCartCountBubble(cart.item_count);

        document.dispatchEvent(new CustomEvent('cart:refresh', {
          detail: { cart: cart }
        }));

        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { cart: cart }
        }));

        document.dispatchEvent(new CustomEvent('joy:cart-added', {
          detail: { cart: cart }
        }));

        return cart;
      });
  }

  function closeJoyPdpNotifyOverlay() {
    const overlay = document.querySelector('[data-joy-pdp-notify-overlay]');

    if (overlay) {
      overlay.remove();
    }

    document.body.classList.remove('joy-pdp-notify-overlay-open');
  }

  function isElementVisible(element, frameWindow) {
    if (!element || !frameWindow) return false;

    const style = frameWindow.getComputedStyle(element);
    const rect = element.getBoundingClientRect();

    return (
      style.display !== 'none' &&
      style.visibility !== 'hidden' &&
      Number(style.opacity || 1) !== 0 &&
      rect.width > 0 &&
      rect.height > 0
    );
  }

  function findPopupRoot(frameDocument, frameWindow) {
    if (!frameDocument || !frameWindow) return null;

    const directThemePopup =
      frameDocument.querySelector('modal-dialog[open]') ||
      frameDocument.querySelector('.product-popup-modal[open]') ||
      frameDocument.querySelector('[role="dialog"][open]');

    if (directThemePopup && isElementVisible(directThemePopup, frameWindow)) {
      return directThemePopup;
    }

    const emailInput = Array.from(
      frameDocument.querySelectorAll('input[type="email"], input[name*="email" i]')
    ).find(function (input) {
      return isElementVisible(input, frameWindow);
    });

    const dialogCandidates = Array.from(
      frameDocument.querySelectorAll(
        '[role="dialog"], .klaviyo-form, .needsclick, [data-testid*="modal" i]'
      )
    ).filter(function (element) {
      return isElementVisible(element, frameWindow);
    });

    let sourceElement = null;

    if (emailInput) {
      sourceElement =
        emailInput.closest('[role="dialog"]') ||
        emailInput.closest('.klaviyo-form') ||
        emailInput.closest('.needsclick') ||
        emailInput;
    } else if (dialogCandidates.length) {
      sourceElement = dialogCandidates[0];
    }

    if (!sourceElement) return null;

    let current = sourceElement;
    let bestRoot = sourceElement;

    while (current && current !== frameDocument.body) {
      const style = frameWindow.getComputedStyle(current);
      const rect = current.getBoundingClientRect();
      const coversViewport =
        rect.width >= frameWindow.innerWidth * 0.75 &&
        rect.height >= frameWindow.innerHeight * 0.75;

      if (style.position === 'fixed' && coversViewport) {
        bestRoot = current;
      }

      current = current.parentElement;
    }

    return bestRoot;
  }

  function clickExistingPdpNotifyButton(frameDocument, frameWindow) {
    if (!frameDocument || !frameWindow) return false;

    const exactButton =
      frameDocument.querySelector('.direct-add-to-cart-btn.joy-pdp-notify-state') ||
      frameDocument.querySelector('.klaviyo-bis-trigger');

    if (exactButton && isElementVisible(exactButton, frameWindow)) {
      exactButton.click();
      return true;
    }

    const notifyButton = Array.from(
      frameDocument.querySelectorAll('button, a')
    ).find(function (element) {
      if (!isElementVisible(element, frameWindow)) return false;

      const text = (element.textContent || '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

      return text === 'notify me' || text === 'get notified';
    });

    if (notifyButton) {
      notifyButton.click();
      return true;
    }

    return false;
  }

  function isolatePopupInsideFrame(frameDocument, frameWindow, popupRoot) {
    if (!frameDocument || !frameWindow || !popupRoot) return false;

    const styleId = 'JoyEmbeddedNotifyPopupStyle';

    if (!frameDocument.getElementById(styleId)) {
      const style = frameDocument.createElement('style');
      style.id = styleId;
      style.textContent = [
        'html, body {',
        '  width: 100% !important;',
        '  height: 100% !important;',
        '  min-height: 100% !important;',
        '  margin: 0 !important;',
        '  padding: 0 !important;',
        '  overflow: hidden !important;',
        '  background: transparent !important;',
        '}',
        'body > *:not(.joy-embedded-notify-popup-root) {',
        '  display: none !important;',
        '}',
        '.joy-embedded-notify-popup-root {',
        '  display: block !important;',
        '  visibility: visible !important;',
        '  opacity: 1 !important;',
        '  z-index: 2147483647 !important;',
        '}'
      ].join('\\n');

      frameDocument.head.appendChild(style);
    }

    if (popupRoot.parentElement !== frameDocument.body) {
      frameDocument.body.appendChild(popupRoot);
    }

    popupRoot.classList.add('joy-embedded-notify-popup-root');

    return true;
  }

  function openJoyPdpNotifyOverlay(productUrl, variantId) {
    if (!productUrl || !variantId) return;

    closeJoyPdpNotifyOverlay();

    const separator = productUrl.indexOf('?') === -1 ? '?' : '&';
    const notifyUrl =
      productUrl +
      separator +
      'variant=' +
      encodeURIComponent(variantId) +
      '&notify=true&joy_notify_embed=1';

    const overlay = document.createElement('div');
    overlay.className = 'joy-pdp-notify-overlay';
    overlay.setAttribute('data-joy-pdp-notify-overlay', '');
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute(
      'aria-label',
      'Get notified when this product is back in stock'
    );

    const loading = document.createElement('p');
    loading.className = 'joy-pdp-notify-overlay__loading';
    loading.textContent = 'Loading notification form...';

    const frame = document.createElement('iframe');
    frame.className = 'joy-pdp-notify-overlay__frame';
    frame.src = notifyUrl;
    frame.title = 'Back in stock notification form';
    frame.setAttribute(
      'sandbox',
      'allow-same-origin allow-scripts allow-forms allow-popups'
    );

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.className = 'joy-pdp-notify-overlay__close';
    closeButton.setAttribute('aria-label', 'Close notification form');
    closeButton.innerHTML = '&times;';

    closeButton.addEventListener('click', closeJoyPdpNotifyOverlay);

    frame.addEventListener('load', function () {
      let attempts = 0;
      let popupRoot = null;
      let notifyClickAttempted = false;
      const maximumAttempts = 80;

      const watcher = window.setInterval(function () {
        attempts += 1;

        if (!document.body.contains(overlay)) {
          window.clearInterval(watcher);
          return;
        }

        try {
          const frameWindow = frame.contentWindow;
          const frameDocument = frame.contentDocument ||
            (frameWindow ? frameWindow.document : null);

          if (!frameWindow || !frameDocument || !frameDocument.body) {
            return;
          }

          popupRoot = findPopupRoot(frameDocument, frameWindow);

          if (!popupRoot && !notifyClickAttempted && attempts >= 4) {
            notifyClickAttempted = clickExistingPdpNotifyButton(
              frameDocument,
              frameWindow
            );
          }

          if (popupRoot) {
            isolatePopupInsideFrame(
              frameDocument,
              frameWindow,
              popupRoot
            );

            overlay.classList.add('is-ready');
            window.clearInterval(watcher);

            const closeWatcher = window.setInterval(function () {
              if (!document.body.contains(overlay)) {
                window.clearInterval(closeWatcher);
                return;
              }

              try {
                const stillVisible =
                  popupRoot.isConnected &&
                  isElementVisible(popupRoot, frameWindow);

                if (!stillVisible) {
                  window.clearInterval(closeWatcher);
                  closeJoyPdpNotifyOverlay();
                }
              } catch (error) {
                window.clearInterval(closeWatcher);
              }
            }, 300);

            return;
          }

          if (attempts >= maximumAttempts) {
            window.clearInterval(watcher);
            loading.textContent =
              'Notification form could not be loaded. Please try again.';
          }
        } catch (error) {
          window.clearInterval(watcher);
          loading.textContent =
            'Notification form could not be loaded. Please try again.';
        }
      }, 250);
    });

    overlay.appendChild(loading);
    overlay.appendChild(frame);
    overlay.appendChild(closeButton);

    document.body.appendChild(overlay);
    document.body.classList.add('joy-pdp-notify-overlay-open');

    closeButton.focus();
  }

  window.openJoyPdpNotifyOverlay = openJoyPdpNotifyOverlay;

  function initializeVariantForm(form) {
    if (!form || form.dataset.joyVariantInitialized === 'true') return;

    form.dataset.joyVariantInitialized = 'true';

    const select = form.querySelector('[data-joy-variant-select]');
    const variantInput = form.querySelector('[data-joy-variant-id]');
    const addButton = form.querySelector('[data-joy-add-button]');
    const message = form.querySelector('[data-joy-variant-message]');
    const card = form.closest('[data-joy-card-product]');
    const priceEl = card ? card.querySelector('[data-joy-price]') : null;
    const addLabel = addButton ? (addButton.dataset.addLabel || 'Add to cart') : 'Add to cart';
    const notifyLabel = addButton ? (addButton.dataset.notifyLabel || 'Get notified') : 'Get notified';
    const defaultAvailable = form.dataset.defaultAvailable === 'true';

    function setMessage(text, isError) {
      if (!message) return;

      message.textContent = text || '';
      message.classList.toggle('is-error', Boolean(isError));
    }

    function updateStateFromOption() {
      const option = select ? select.options[select.selectedIndex] : null;
      const hasSelectedVariant = !select || Boolean(option && option.value);
      const isAvailable = select
        ? Boolean(hasSelectedVariant && option && option.dataset.available === 'true')
        : defaultAvailable;

      if (variantInput && select) {
        variantInput.value = hasSelectedVariant && option ? option.value : '';
      }

      if (priceEl) {
        if (hasSelectedVariant && option && option.dataset.price) {
          priceEl.textContent = option.dataset.price;
        } else {
          priceEl.textContent =
            (priceEl.dataset.pricePrefix || '') +
            (priceEl.dataset.defaultPrice || '');
        }
      }

      if (addButton) {
        addButton.disabled = false;
        addButton.textContent = hasSelectedVariant && !isAvailable ? notifyLabel : addLabel;
        addButton.classList.toggle('is-notify', Boolean(hasSelectedVariant && !isAvailable));
      }

      setMessage('');

      return {
        option: option,
        hasSelectedVariant: Boolean(hasSelectedVariant),
        isAvailable: Boolean(isAvailable)
      };
    }

    if (select) {
      Array.from(select.options).forEach(function (option) {
        if (option.value !== '') option.disabled = false;
      });

      select.addEventListener('change', updateStateFromOption);
    }

    updateStateFromOption();

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      if (!variantInput || !addButton) return;

      const currentState = updateStateFromOption();
      const option = currentState.option;

      if (!currentState.hasSelectedVariant) {
        const label = select && select.previousElementSibling
          ? select.previousElementSibling.textContent.trim().toLowerCase()
          : 'variant';

        setMessage('Please select ' + label + '.', true);

        if (select) select.focus();
        return;
      }

      if (!currentState.isAvailable) {
        const productUrl =
          form.dataset.productUrl ||
          (option ? option.dataset.variantUrl : '') ||
          '';

        openJoyPdpNotifyOverlay(
          productUrl,
          variantInput.value
        );

        return;
      }

      const originalText = addButton.textContent;
      const formData = new FormData(form);

      addButton.disabled = true;
      addButton.textContent = 'Adding...';
      setMessage('');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          Accept: 'application/json'
        },
        body: formData
      })
        .then(function (response) {
          if (!response.ok) {
            return response.json().then(function (error) {
              throw error;
            });
          }

          return response.json();
        })
        .then(function () {
          addButton.textContent = 'Added';
          setMessage('Added to cart');

          return refreshCartUi();
        })
        .then(function () {
          window.setTimeout(function () {
            updateStateFromOption();
            setMessage('');
          }, 1800);
        })
        .catch(function (error) {
          const errorMessage = error && error.description
            ? error.description
            : 'Could not add this item. Please try again.';

          addButton.textContent = originalText;
          addButton.disabled = false;
          setMessage(errorMessage, true);
        });
    });
  }

  function initializeVariantForms(root) {
    const scope = root || document;

    scope.querySelectorAll('[data-joy-variant-form]').forEach(function (form) {
      initializeVariantForm(form);
    });
  }

  function formatVariantOptionText(variant) {
    if (!variant) return '';

    return variant.title + (variant.available ? '' : ' (Sold Out)');
  }

  function findCardPriceElement(card) {
    if (!card) return null;

    return (
      card.querySelector('.price__regular .price-item--regular') ||
      card.querySelector('.price .price-item--regular') ||
      card.querySelector('.price__sale .price-item--sale') ||
      card.querySelector('.price-item')
    );
  }

  function updateCardPriceDisplay(card, variant) {
    if (!card || !variant) return;

    const priceWrapper = card.querySelector('.price');
    const regularPrice = card.querySelector('.price__regular .price-item--regular');
    const salePrice = card.querySelector('.price__sale .price-item--sale');
    const compareAtPrice = card.querySelector('.price__sale .price-item--regular');
    const fallbackPrice = findCardPriceElement(card);
    const hasCompareAtPrice = Boolean(variant.compareAtPrice);

    if (priceWrapper) {
      priceWrapper.classList.toggle('price--on-sale', hasCompareAtPrice);
    }

    if (hasCompareAtPrice) {
      if (salePrice) {
        salePrice.textContent = variant.price;
      } else if (fallbackPrice) {
        fallbackPrice.textContent = variant.price;
      }

      if (compareAtPrice) {
        compareAtPrice.textContent = variant.compareAtPrice;
      }
    } else {
      if (regularPrice) {
        regularPrice.textContent = variant.price;
      } else if (salePrice) {
        salePrice.textContent = variant.price;
      } else if (fallbackPrice) {
        fallbackPrice.textContent = variant.price;
      }

      if (compareAtPrice) {
        compareAtPrice.textContent = '';
      }
    }
  }

  function updateCardVariantState(listItem, data, variant, options) {
    if (!listItem || !data || !variant) return;

    const settings = options || {};
    const card = listItem.querySelector('.card-wrapper-os') || listItem;
    const priceElement = findCardPriceElement(card);
    const hiddenVariantInput = card.querySelector('input[name="id"], .product-variant-id');
    const addToCartWrapper = card.querySelector('.custom-addToCart-os');
    const addToCartButton = card.querySelector('.custom-add-to-cart-btn-os');
    const submitButtons = card.querySelectorAll('button[name="add"]');
    const quantityInput = card.querySelector('.quantity__input');

    if (priceElement && !settings.keepFromPrice) {
      updateCardPriceDisplay(card, variant);
    }

    if (hiddenVariantInput) {
      hiddenVariantInput.value = variant.id;
      hiddenVariantInput.removeAttribute('disabled');
    }

    if (addToCartWrapper) {
      addToCartWrapper.dataset.variantId = variant.id;
      addToCartWrapper.dataset.available = String(Boolean(variant.available));
    }

    if (addToCartButton) {
      const addLabel = addToCartButton.dataset.addLabel || 'Add to cart';
      const notifyLabel = addToCartButton.dataset.notifyLabel || 'Get notified';

      addToCartButton.textContent = variant.available ? addLabel : notifyLabel;
      addToCartButton.classList.toggle('is-notify', !variant.available);
      addToCartButton.disabled = false;
    }

    if (quantityInput) {
      const min = variant.min || 1;
      const step = variant.step || 1;

      quantityInput.dataset.totalQuantity = String(variant.inventoryQuantity || 1000000);
      quantityInput.dataset.cartQuantity = String(variant.cartQuantity || 0);
      quantityInput.dataset.min = String(min);
      quantityInput.min = String(min);
      quantityInput.step = String(step);
      quantityInput.value = String(min);

      if (variant.max) {
        quantityInput.dataset.max = String(variant.max);
        quantityInput.max = String(variant.max);
      } else {
        quantityInput.removeAttribute('data-max');
        quantityInput.removeAttribute('max');
      }

      const quantityValue = card.querySelector('.custom-quantity-value-os span');

      if (quantityValue) {
        quantityValue.textContent = String(min);
      }
    }

    submitButtons.forEach(function (button) {
      button.disabled = !variant.available;
    });
  }

  function requireCardVariantSelection(listItem) {
    if (!listItem) return;

    const card = listItem.querySelector('.card-wrapper-os') || listItem;
    const hiddenVariantInput = card.querySelector('input[name="id"], .product-variant-id');
    const addToCartButton = card.querySelector('.custom-add-to-cart-btn-os');
    const submitButtons = card.querySelectorAll('button[name="add"]');

    if (hiddenVariantInput) {
      hiddenVariantInput.setAttribute('disabled', 'disabled');
    }

    if (addToCartButton) {
      addToCartButton.disabled = true;
    }

    submitButtons.forEach(function (button) {
      button.disabled = true;
    });
  }

  function initializeEnhancedCustomAddToCartHandler() {
    const selector = {
      wrapper: '.custom-addToCart-os[data-variant-id]',
      button: '.custom-add-to-cart-btn-os',
      quantityWrap: '.quantity-selector-and-buyNow-wrapper-os',
      quantityInput: '.quantity__input',
      quantityPlus: '.quantity__button[name="plus"]',
      quantityMinus: '.quantity__button[name="minus"]',
      quantityText: '.custom-quantity-value-os',
      restock: '.restocking-soon-product-os',
      view: '.view-product-os'
    };

    const activate = function (element) {
      if (!element) return;
      element.classList.add('active');
      element.setAttribute('aria-hidden', 'false');
    };

    const deactivate = function (element) {
      if (!element) return;
      element.classList.remove('active');
      element.setAttribute('aria-hidden', 'true');
    };

    let cartCache = new Map();
    let quantityDebounce = null;

    const findCard = function (element) {
      const wrapper = element ? element.closest(selector.wrapper) : null;
      const quantityWrap = element ? element.closest(selector.quantityWrap) : null;
      const root = element ? element.closest('.qty-atc-container') || element.closest('.card-wrapper-os') : null;
      const addWrapper = wrapper || (root ? root.querySelector(selector.wrapper) : null);

      if (!root || !addWrapper) return null;

      const quantityElement = root.querySelector(selector.quantityWrap);
      const input = quantityElement ? quantityElement.querySelector(selector.quantityInput) : null;

      return {
        root: root,
        wrapper: addWrapper,
        button: addWrapper.querySelector(selector.button),
        quantityWrap: quantityElement,
        quantityInput: input,
        quantityPlus: quantityElement ? quantityElement.querySelector(selector.quantityPlus) : null,
        quantityMinus: quantityElement ? quantityElement.querySelector(selector.quantityMinus) : null,
        quantityText: quantityElement ? quantityElement.querySelector(selector.quantityText) : null,
        restock: root.querySelector(selector.restock),
        view: root.querySelector(selector.view)
      };
    };

    const getVariantId = function (card) {
      if (!card || !card.root) return 0;

      const selectedPicker = card.root.querySelector('[data-joy-card-product-variant-picker] select');

      if (selectedPicker && selectedPicker.value) {
        return Number(selectedPicker.value);
      }

      const hiddenInput = card.root.querySelector('input[name="id"], .product-variant-id');

      if (hiddenInput && hiddenInput.value && !hiddenInput.disabled) {
        return Number(hiddenInput.value);
      }

      return Number(card.wrapper ? card.wrapper.dataset.variantId : 0);
    };

    const isAvailable = function (card) {
      return Boolean(card && card.wrapper && card.wrapper.dataset.available === 'true');
    };

    const updateQuantityLabel = function (card, value) {
      if (!card || !card.quantityText) return;

      const count = Number(value || 0);
      card.quantityText.innerHTML = 'Added: <span>' + count + '</span> ' + (count === 1 ? 'item' : 'items');
    };

    const refreshQuantityButtons = function (card) {
      if (!card || !card.quantityInput) return;

      const input = card.quantityInput;
      const value = Number(input.value || 0);
      const min = Number(input.getAttribute('min') || input.dataset.min || 0);
      const maxAttr = input.getAttribute('max');
      const hasMax = maxAttr !== null && maxAttr !== '';
      const max = hasMax ? Number(maxAttr) : Infinity;

      updateQuantityLabel(card, value);

      if (card.quantityMinus) {
        const disableMinus = value <= 0;
        card.quantityMinus.disabled = disableMinus;
        card.quantityMinus.classList.toggle('disabled', disableMinus);
      }

      if (card.quantityPlus) {
        const disablePlus = hasMax && Number.isFinite(max) && value >= max;
        card.quantityPlus.disabled = disablePlus;
        card.quantityPlus.classList.toggle('disabled', disablePlus);
      }
    };

    const setQuantityBusy = function (card, busy) {
      if (!card) return;

      card.root.dataset.joyQtyBusy = busy ? 'true' : 'false';

      if (card.quantityInput) {
        card.quantityInput.setAttribute('aria-busy', busy ? 'true' : 'false');
      }

      refreshQuantityButtons(card);
    };

    const applyCartState = function (cart) {
      cartCache = new Map((cart.items || []).map(function (item) {
        return [Number(item.variant_id), {
          key: item.key,
          quantity: Number(item.quantity)
        }];
      }));

      updateCartCountBubble(cart.item_count);

      document.dispatchEvent(new CustomEvent('cart:refresh', {
        detail: { cart: cart }
      }));

      return cart;
    };

    const fetchCart = function () {
      return fetch('/cart.js', {
        headers: { Accept: 'application/json' }
      })
        .then(function (response) {
          if (!response.ok) throw new Error('Failed to fetch cart');
          return response.json();
        })
        .then(applyCartState);
    };

    const syncCardFromCart = function (card) {
      if (!card || card.root.querySelector('[data-joy-card-quantity-control]')) return;

      const variantId = getVariantId(card);
      const item = cartCache.get(variantId);

      if (!isAvailable(card)) {
        activate(card.restock);
        deactivate(card.view);
        deactivate(card.quantityWrap);
        deactivate(card.wrapper);
        return;
      }

      deactivate(card.view);
      deactivate(card.restock);

      if (item && item.quantity > 0) {
        activate(card.quantityWrap);
        deactivate(card.wrapper);

        if (card.quantityInput) {
          card.quantityInput.value = String(item.quantity);
          card.quantityInput.dataset.cartQuantity = String(item.quantity);
          card.quantityInput.dataset.productMin = card.quantityInput.dataset.productMin || card.quantityInput.dataset.min || card.quantityInput.getAttribute('min') || '1';
          card.quantityInput.dataset.min = '0';
          card.quantityInput.setAttribute('min', '0');
        }

        refreshQuantityButtons(card);
      } else {
        if (card.quantityInput && card.quantityInput.dataset.productMin) {
          card.quantityInput.dataset.min = card.quantityInput.dataset.productMin;
          card.quantityInput.setAttribute('min', card.quantityInput.dataset.productMin);
        }

        activate(card.wrapper);
        deactivate(card.quantityWrap);
      }
    };

    const syncAllCardsFromCart = function () {
      return fetchCart()
        .then(function () {
          document.querySelectorAll(selector.wrapper).forEach(function (wrapper) {
            syncCardFromCart(findCard(wrapper));
          });
        })
        .catch(function () {
          document.querySelectorAll(selector.wrapper).forEach(function (wrapper) {
            const card = findCard(wrapper);

            if (card && isAvailable(card)) {
              activate(card.wrapper);
              deactivate(card.quantityWrap);
              deactivate(card.view);
              deactivate(card.restock);
            }
          });
        });
    };

    const addToCart = function (variantId, quantity) {
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: Number(variantId),
            quantity: Number(quantity || 1)
          }]
        })
      }).then(function (response) {
        if (!response.ok) {
          return response.text().then(function (errorText) {
            throw new Error(errorText || 'Add to cart failed');
          });
        }

        return fetchCart();
      });
    };

    const changeCartLine = function (item, quantity) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({
          id: item.key,
          quantity: Number(quantity)
        })
      }).then(function (response) {
        if (!response.ok) {
          return response.text().then(function (errorText) {
            throw new Error(errorText || 'Cart change failed');
          });
        }

        return response.json().then(applyCartState);
      });
    };

    const setCartQuantity = function (variantId, quantity) {
      const numericVariantId = Number(variantId);
      const item = cartCache.get(numericVariantId);

      if (item) return changeCartLine(item, quantity);

      return fetchCart().then(function () {
        const latestItem = cartCache.get(numericVariantId);

        if (latestItem) return changeCartLine(latestItem, quantity);

        return addToCart(numericVariantId, quantity);
      });
    };

    if (document.documentElement.dataset.joyEnhancedCustomAtc !== 'true') {
      document.documentElement.dataset.joyEnhancedCustomAtc = 'true';

      document.addEventListener('click', function (event) {
        const button = event.target.closest(selector.button);

        if (!button) return;

        const card = findCard(button);
        const variantId = getVariantId(card);

        if (!card || !variantId) return;

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        if (!isAvailable(card)) {
          const productUrl = card.wrapper.dataset.productUrl || '';

          openJoyPdpNotifyOverlay(productUrl, variantId);
          return;
        }

        if (button.dataset.joyAdding === 'true') return;

        const originalText = button.textContent;
        button.dataset.joyAdding = 'true';
        button.disabled = true;
        button.textContent = 'Adding...';

        addToCart(variantId, 1)
          .then(function () {
            button.textContent = 'Added';
            syncCardFromCart(findCard(button));
          })
          .catch(function () {
            button.textContent = 'Try again';
          })
          .finally(function () {
            window.setTimeout(function () {
              button.textContent = originalText || 'Add to cart';
              button.disabled = false;
              button.dataset.joyAdding = 'false';
            }, 800);
          });
      }, true);

      const commitQuantity = function (card, desiredQuantity) {
        const variantId = getVariantId(card);

        if (!card || !variantId || Number.isNaN(desiredQuantity)) return;
        if (card.root.dataset.joyQtyBusy === 'true') return;

        setQuantityBusy(card, true);
        window.clearTimeout(quantityDebounce);

        quantityDebounce = window.setTimeout(function () {
          setCartQuantity(variantId, desiredQuantity)
            .then(function () {
              syncCardFromCart(findCard(card.root));
            })
            .catch(function () {
              syncAllCardsFromCart();
            })
            .finally(function () {
              setQuantityBusy(findCard(card.root), false);
            });
        }, 0);
      };

      document.addEventListener('click', function (event) {
        const button = event.target.closest(selector.quantityPlus + ', ' + selector.quantityMinus);

        if (!button || !button.closest(selector.quantityWrap)) return;

        const card = findCard(button);

        if (!card || !card.quantityInput) return;

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        if (card.root.dataset.joyQtyBusy === 'true') return;

        const input = card.quantityInput;
        const currentQuantity = Number(input.value || 0);
        const step = Number(input.getAttribute('step') || 1) || 1;
        const maxAttr = input.getAttribute('max');
        const hasMax = maxAttr !== null && maxAttr !== '';
        const max = hasMax ? Number(maxAttr) : Infinity;
        const direction = button.matches(selector.quantityPlus) ? 1 : -1;
        const desiredQuantity = Math.max(0, Math.min(max, currentQuantity + (direction * step)));

        input.value = String(desiredQuantity);
        input.dataset.joyIgnoreChangeUntil = String(Date.now() + 800);
        updateQuantityLabel(card, desiredQuantity);
        refreshQuantityButtons(card);
        commitQuantity(card, desiredQuantity);
      }, true);

      document.addEventListener('change', function (event) {
        const input = event.target;

        if (!(input instanceof HTMLInputElement) || !input.matches(selector.quantityInput)) return;
        if (!input.closest(selector.quantityWrap)) return;
        if (Number(input.dataset.joyIgnoreChangeUntil || 0) > Date.now()) return;

        const card = findCard(input);
        const maxAttr = input.getAttribute('max');
        const hasMax = maxAttr !== null && maxAttr !== '';
        const max = hasMax ? Number(maxAttr) : Infinity;
        const desiredQuantity = Math.max(0, Math.min(max, Number(input.value || 0)));

        input.value = String(desiredQuantity);
        updateQuantityLabel(card, desiredQuantity);
        refreshQuantityButtons(card);
        commitQuantity(card, desiredQuantity);
      }, true);

      document.addEventListener('change', function (event) {
        if (!event.target.closest('[data-joy-card-product-variant-picker]')) return;

        window.requestAnimationFrame(function () {
          syncAllCardsFromCart();
        });
      }, true);
    }

    syncAllCardsFromCart();
  }

  function initializeCardProductVariantEnhancers(root) {
    const scope = root || document;

    scope.querySelectorAll('[data-joy-card-variant-data]').forEach(function (script) {
      const listItem = script.closest('li');

      if (!listItem || listItem.dataset.joyCardVariantEnhancer === 'true') return;

      let data = null;

      try {
        data = JSON.parse(script.textContent || '{}');
      } catch (error) {
        return;
      }

      if (!data || !Array.isArray(data.variants) || data.variants.length < 2) return;

      const card = listItem.querySelector('.card-wrapper-os') || listItem;
      const priceElement = findCardPriceElement(card);
      const insertionTarget =
        card.querySelector('.quick-add.no-js-hidden') ||
        card.querySelector('.qty-atc-container') ||
        card.querySelector('.card-information') ||
        card;

      if (!priceElement || !insertionTarget) return;

      listItem.dataset.joyCardVariantEnhancer = 'true';
      priceElement.textContent = 'From ' + data.fromPrice;

      const priceWrapper = card.querySelector('.price');
      const compareAtPrice = card.querySelector('.price__sale .price-item--regular');

      if (priceWrapper) {
        priceWrapper.classList.remove('price--on-sale');
      }

      if (compareAtPrice) {
        compareAtPrice.textContent = '';
      }

      const picker = document.createElement('div');
      picker.className = 'joy-card-product-variant-picker';
      picker.setAttribute('data-joy-card-product-variant-picker', '');

      const label = document.createElement('label');
      label.className = 'joy-card-product-variant-picker__label';
      label.setAttribute('for', 'JoyCardVariant-' + data.productId);
      label.textContent = data.optionName || 'Variant';

      const selectWrap = document.createElement('div');
      selectWrap.className = 'joy-card-product-variant-picker__select-wrap';

      const select = document.createElement('select');
      select.id = 'JoyCardVariant-' + data.productId;
      select.className = 'joy-card-product-variant-picker__select';

      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = 'Select ' + String(data.optionName || 'variant').toLowerCase();
      placeholder.selected = true;
      placeholder.disabled = true;
      select.appendChild(placeholder);

      data.variants.forEach(function (variant) {
        const option = document.createElement('option');
        option.value = variant.id;
        option.textContent = formatVariantOptionText(variant);

        select.appendChild(option);
      });

      select.addEventListener('change', function () {
        const selected = data.variants.find(function (variant) {
          return String(variant.id) === String(select.value);
        });

        updateCardVariantState(listItem, data, selected);
      });

      selectWrap.appendChild(select);
      picker.appendChild(label);
      picker.appendChild(selectWrap);

      if (insertionTarget.classList && insertionTarget.classList.contains('quick-add')) {
        const inventoryMessage = insertionTarget.querySelector('.collection-product__inventory-os');

        if (inventoryMessage && inventoryMessage.nextSibling) {
          insertionTarget.insertBefore(picker, inventoryMessage.nextSibling);
        } else if (inventoryMessage) {
          insertionTarget.appendChild(picker);
        } else {
          insertionTarget.insertBefore(picker, insertionTarget.firstChild);
        }
      } else if (insertionTarget.classList && insertionTarget.classList.contains('qty-atc-container')) {
        insertionTarget.insertBefore(picker, insertionTarget.firstChild);
      } else {
        insertionTarget.appendChild(picker);
      }

      requireCardVariantSelection(listItem);
    });
  }

  function initializeCollection() {
    initializeTabs(document);
    initializeVariantForms(document);
    initializeCardProductVariantEnhancers(document);
    initializeEnhancedCustomAddToCartHandler();

    const productGrid = document.getElementById('ProductGridContainer');

    if (!productGrid || productGrid.dataset.joyObserverInitialized === 'true') return;

    productGrid.dataset.joyObserverInitialized = 'true';

    const observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
          if (!(node instanceof Element)) return;

          initializeTabs(node);
          initializeVariantForms(node);
          initializeCardProductVariantEnhancers(node);
          initializeEnhancedCustomAddToCartHandler();
        });
      });
    });

    observer.observe(productGrid, {
      childList: true,
      subtree: true
    });
  }

  document.addEventListener('keydown', function (event) {
    if (
      event.key === 'Escape' &&
      document.querySelector('[data-joy-pdp-notify-overlay]')
    ) {
      closeJoyPdpNotifyOverlay();
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCollection);
  } else {
    initializeCollection();
  }

  document.addEventListener('shopify:section:load', initializeCollection);
})();
</script>


