{% comment %}
  Order Support / Delivery Help section
{% endcomment %}

<section class="order-support section-{{ section.id }}">
  <div class="order-support__inner">

    {% if section.settings.deadline_heading != blank %}
      <div class="order-support__item">
        <div class="order-support__icon" aria-hidden="true">
          {% if section.settings.deadline_icon == 'calendar' %}
            <svg viewBox="0 0 32 32" role="presentation">
              <rect x="5" y="7" width="22" height="20" rx="2"></rect>
              <path d="M10 4v6M22 4v6M5 13h22"></path>
              <path d="M10 18h3M17 18h3M10 23h3"></path>
            </svg>
          {% else %}
            <svg viewBox="0 0 32 32" role="presentation">
              <path d="M5 7h22v18H5z"></path>
              <path d="M10 4v6M22 4v6M5 13h22"></path>
            </svg>
          {% endif %}
        </div>

        <div class="order-support__content">
          <h2>{{ section.settings.deadline_heading | escape }}</h2>
          {% if section.settings.deadline_text != blank %}
            <p>{{ section.settings.deadline_text }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.divider %}
      <div class="order-support__divider"></div>
    {% endif %}

    {% if section.settings.different_day_heading != blank %}
      <div class="order-support__item">
        <div class="order-support__icon order-support__icon--chat" aria-hidden="true">
          <svg viewBox="0 0 32 32" role="presentation">
            <path d="M5 8.5C5 6.6 6.6 5 8.5 5h15C25.4 5 27 6.6 27 8.5v9c0 1.9-1.6 3.5-3.5 3.5H14l-6.5 5v-5.7c-1.5-.4-2.5-1.8-2.5-3.3z"></path>
          </svg>
        </div>

        <div class="order-support__content">
          <h2>{{ section.settings.different_day_heading | escape }}</h2>
          {% if section.settings.different_day_text != blank %}
            <p>{{ section.settings.different_day_text }}</p>
          {% endif %}

          {% if section.settings.link_text != blank %}
            <a
              class="order-support__link"
              href="{{ section.settings.link_url }}"
              {% if section.settings.link_url == blank %}aria-disabled="true"{% endif %}
            >
              {{ section.settings.link_text | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .section-{{ section.id }} {
    font-family: inherit !important;
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }} .order-support__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.inner_padding }}px;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .order-support__item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .section-{{ section.id }} .order-support__icon {
    flex: 0 0 {{ section.settings.icon_size }}px;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin-top: 2px;
  }

  .section-{{ section.id }} .order-support__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ section.settings.icon_color }};
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .section-{{ section.id }} .order-support__content {
    min-width: 0;
    flex: 1 1 auto;
  }

  .section-{{ section.id }} .order-support__content h2 {
    margin: 0 0 5px;
    color: {{ section.settings.heading_color }};
    font-family: inherit !important;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .section-{{ section.id }} .order-support__content p {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: inherit !important;
    font-size: {{ section.settings.text_size }}px;
    font-weight: 400;
    line-height: 1.45;
  }

  .section-{{ section.id }} .order-support__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 7px;
    color: {{ section.settings.link_color }};
    font-family: inherit !important;
    font-size: {{ section.settings.link_size }}px;
    line-height: 1.3;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section-{{ section.id }} .order-support__link:hover {
    opacity: .75;
  }

  .section-{{ section.id }} .order-support__divider {
    height: 1px;
    margin: {{ section.settings.divider_spacing }}px 0;
    background: {{ section.settings.divider_color }};
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }

    .section-{{ section.id }} .order-support__inner {
      padding: {{ section.settings.mobile_inner_padding }}px;
    }

    .section-{{ section.id }} .order-support__item {
      gap: 13px;
    }

    .section-{{ section.id }} .order-support__icon {
      flex-basis: 27px;
      width: 27px;
      height: 27px;
    }

    .section-{{ section.id }} .order-support__content h2 {
      font-size: 17px;
    }

    .section-{{ section.id }} .order-support__content p {
      font-size: 12px;
    }

    .section-{{ section.id }} .order-support__link {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Order Support",
  "tag": "section",
  "class": "order-support-section",
  "settings": [
    {
      "type": "select",
      "id": "deadline_icon",
      "label": "First icon",
      "options": [
        { "value": "calendar", "label": "Calendar" },
        { "value": "calendar_simple", "label": "Simple calendar" }
      ],
      "default": "calendar"
    },
    {
      "type": "text",
      "id": "deadline_heading",
      "label": "First heading",
      "default": "Missed the order deadline?"
    },
    {
      "type": "textarea",
      "id": "deadline_text",
      "label": "First text",
      "default": "We accept late orders until 7am the morning after your usual cutoff. Select the same delivery day next week, then message us before the late order deadline to request delivery this week. We'll change the date for you.\n\nFreshly baked bread and Maleny milk may be unavailable as they need to be ordered in advance."
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "text",
      "id": "different_day_heading",
      "label": "Second heading",
      "default": "Prefer a different delivery day?"
    },
    {
      "type": "textarea",
      "id": "different_day_text",
      "label": "Second text",
      "default": "Message us with your postcode and preferred day. We can't promise it, but we'd love to know what works for you."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Send us a message"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F6F3E4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#18513D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#45685A"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#27705A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#14533E"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#BFC5B2"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "inner_padding",
      "label": "Inner padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_inner_padding",
      "label": "Mobile inner padding",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Order Support"
    }
  ]
}
{% endschema %}
