<section id="gm-note-section">
    <div class="page-width">
        <div class="gm-note-container">
            <div class="note__container">
            {{ section.settings.paragraph }}
            </div>
        </div>
    </div>
  
</section>



{% schema %}
  {
    "name": "GM Note Section",
    "settings": [
 
        {
            "type": "richtext",
            "id": "paragraph",
            "label": "Content"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 300,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 300,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
    {
      "name": "GM Note Section"

    }
  ]

  }
{% endschema %}

<style>
#gm-note-section .gm-note-container{
    border: 0;
}
#gm-note-section .gm-note-container .gm-note-container{
    text-align: center;
}
#gm-note-section .gm-note-container{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
}
#gm-note-section .gm-note-container .note__container p {
    text-align: center;
  line-height: 1.7em;
    color: #141414;
    opacity: .5;
      letter-spacing: -0.36px;
    font-size: 18px;
      max-width: 950px;
    margin: 0 auto;
}
#gm-note-section .gm-note-container .note__container {
    background: #fffaf5;
    margin:  80px 0;
    padding: 45px 20px;
}
  @media (max-width: 767px) {
    #gm-note-section .gm-note-container .note__container {
    margin: 40px 0;
}
  }
@media screen and (max-width: 425px) {
    .gm-note-container{
        padding-top: 30px;
        padding-bottom: 30px;
    }
}
</style>