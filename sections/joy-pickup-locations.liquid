
{% comment %}
  JOY WHOLEFOODS - PICKUP LOCATIONS
  Standalone Shopify OS 2.0 Section

  Features:
  - Existing visual layout
  - Dynamic pickup blocks
  - Optional live JSON endpoint
  - Suburb / postcode search
  - Day filtering
  - View all / show fewer
  - Google Maps directions
  - Mobile responsive
{% endcomment %}

<section
  id="joy-pickups-{{ section.id }}"
  class="joy-pickups-section"
  style="
    --jp-green: {{ section.settings.green }};
    --jp-cream: {{ section.settings.cream }};
    --jp-bg: {{ section.settings.background }};
    --jp-text: {{ section.settings.text_color }};
  "
>
  <div class="jp-container">

    <h2 class="jp-heading">
      {{ section.settings.heading | escape }}
    </h2>

    <div class="jp-filter-bar">
      <div class="jp-search-wrap">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>

        <input
          type="search"
          data-jp-search
          placeholder="Search suburb or postcode"
          aria-label="Search pickup locations"
        >
      </div>

      <div class="jp-day-filters" role="group" aria-label="Filter pickup locations by day">
        <button
          type="button"
          class="active"
          data-jp-day="all"
          aria-pressed="true"
        >
          All days
        </button>

        <button type="button" data-jp-day="wednesday" aria-pressed="false">
          Wednesday
        </button>

        <button type="button" data-jp-day="thursday" aria-pressed="false">
          Thursday
        </button>

        <button type="button" data-jp-day="friday" aria-pressed="false">
          Friday
        </button>

        <button type="button" data-jp-day="saturday" aria-pressed="false">
          Saturday
        </button>
      </div>
    </div>

    <p data-jp-status class="jp-status" hidden></p>

    <div class="jp-location-list" data-jp-list>

      {% for block in section.blocks %}
        {% if block.type == 'pickup' %}
          <article
            class="jp-location"
            data-jp-location
            data-day="{{ block.settings.day | downcase | escape }}"
            data-search="{{ block.settings.suburb | append: ' ' | append: block.settings.postcode | append: ' ' | append: block.settings.address | downcase | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="jp-location-info">
              <h3>{{ block.settings.suburb | escape }}</h3>

              <p>
                {{ block.settings.day | escape }}
                {% if block.settings.hours != blank %}
                  · {{ block.settings.hours | escape }}
                {% endif %}
              </p>

              <span>{{ block.settings.address | escape }}</span>
            </div>

            {% assign directions_url = block.settings.map_link %}

            {% if directions_url != blank %}
              <a
                class="jp-directions"
                href="{{ directions_url }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                Get directions
              </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    <p class="jp-empty" data-jp-empty hidden>
      No pickup locations match your search.
    </p>

    <button
      type="button"
      class="jp-view-all"
      data-jp-view-all
      hidden
    >
      View all locations →
    </button>

    {% if section.settings.note != blank %}
      <p class="jp-note">
        {{ section.settings.note | escape }}
      </p>
    {% endif %}

  </div>
</section>

<style>
#joy-pickups-{{ section.id }} {
  padding:
    {{ section.settings.padding_top }}px
    20px
    {{ section.settings.padding_bottom }}px;
  background: var(--jp-bg);
  color: var(--jp-text);
  font-family: 'DM Sans', sans-serif;
}

#joy-pickups-{{ section.id }} *,
#joy-pickups-{{ section.id }} *::before,
#joy-pickups-{{ section.id }} *::after {
  box-sizing: border-box;
}

#joy-pickups-{{ section.id }} [hidden] {
  display: none !important;
}

#joy-pickups-{{ section.id }} .jp-container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

#joy-pickups-{{ section.id }} .jp-heading {
  margin: 0 0 14px;
  color: var(--jp-green);
  font-family: 'Holiday Journey', cursive;
  font-size: clamp(26px, 2.6vw, 36px);
  font-weight: 400;
  line-height: 1.2;
}

#joy-pickups-{{ section.id }} .jp-filter-bar {
  display: grid;
  grid-template-columns: minmax(200px, 1fr) auto;
  gap: 12px;
  align-items: center;
  margin-bottom: 13px;
}

#joy-pickups-{{ section.id }} .jp-search-wrap {
  position: relative;
  min-width: 0;
}

#joy-pickups-{{ section.id }} .jp-search-wrap svg {
  position: absolute;
  width: 20px;
  height: 20px;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--jp-green);
}

#joy-pickups-{{ section.id }} .jp-search-wrap input {
  display: block;
  width: 100%;
  height: 46px;
  border: 1px solid #dce1de;
  border-radius: 10px;
  background: #fff;
  padding: 0 15px 0 45px;
  color: var(--jp-text);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  outline: none;
  box-shadow: none;
}

#joy-pickups-{{ section.id }} .jp-search-wrap input:focus {
  border-color: var(--jp-green);
}

#joy-pickups-{{ section.id }} .jp-day-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  align-items: center;
}

#joy-pickups-{{ section.id }} .jp-day-filters button {
  min-height: 44px;
  border: 1px solid #ded8cb;
  border-radius: 25px;
  background: var(--jp-cream);
  color: var(--jp-text);
  padding: 8px 17px;
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  cursor: pointer;
  transition: background .2s, color .2s;
}

#joy-pickups-{{ section.id }} .jp-day-filters button.active {
  color: #fff;
  background: var(--jp-green);
  border-color: var(--jp-green);
}

#joy-pickups-{{ section.id }} .jp-location-list {
  display: grid;
  gap: 8px;
}

#joy-pickups-{{ section.id }} .jp-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-width: 0;
  padding: 12px 18px;
  background: #fff;
  border: 1px solid #e1e5e3;
  border-radius: 9px;
}

#joy-pickups-{{ section.id }} .jp-location-info {
  min-width: 0;
}

#joy-pickups-{{ section.id }} .jp-location h3 {
  color: var(--jp-green);
  font-family: 'Holiday Journey', cursive;
  font-size: 19px;
  font-weight: 400;
  line-height: 1.2;
  margin: 0 0 4px;
}

#joy-pickups-{{ section.id }} .jp-location p {
  margin: 0 0 4px;
  color: var(--jp-text);
  font-size: 14px;
  line-height: 1.4;
}

#joy-pickups-{{ section.id }} .jp-location-info span {
  display: block;
  color: #526278;
  font-size: 13px;
  line-height: 1.4;
}

#joy-pickups-{{ section.id }} .jp-directions {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  color: var(--jp-green);
  font-size: 13px;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

#joy-pickups-{{ section.id }} .jp-directions svg {
  width: 20px;
  height: 20px;
}

#joy-pickups-{{ section.id }} .jp-view-all {
  display: block;
  width: 100%;
  min-height: 42px;
  margin-top: 10px;
  border: 1px solid var(--jp-green);
  border-radius: 25px;
  background: #fff;
  color: var(--jp-green);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background .2s;
}

#joy-pickups-{{ section.id }} .jp-view-all:hover {
  background: var(--jp-cream);
}

#joy-pickups-{{ section.id }} .jp-empty,
#joy-pickups-{{ section.id }} .jp-status {
  padding: 15px;
  text-align: center;
  color: var(--jp-text);
  font-size: 13px;
}

#joy-pickups-{{ section.id }} .jp-note {
  margin: 11px 0 0;
  color: #617087;
  font-size: 12px;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 990px) {
  #joy-pickups-{{ section.id }} .jp-filter-bar {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 749px) {
  #joy-pickups-{{ section.id }} {
    padding:
      {{ section.settings.mobile_padding_top }}px
      16px
      {{ section.settings.mobile_padding_bottom }}px;
  }

  #joy-pickups-{{ section.id }} .jp-day-filters {
    gap: 6px;
  }

  #joy-pickups-{{ section.id }} .jp-day-filters button {
    min-height: 40px;
    padding: 7px 12px;
    font-size: 12px;
  }

  #joy-pickups-{{ section.id }} .jp-location {
    padding: 12px 14px;
    gap: 12px;
  }

  #joy-pickups-{{ section.id }} .jp-location h3 {
    font-size: 17px;
  }
}

@media (max-width: 430px) {
  #joy-pickups-{{ section.id }} .jp-location {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

<script>
(function () {
  const root = document.getElementById(
    'joy-pickups-{{ section.id }}'
  );

  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const search = root.querySelector('[data-jp-search]');
  const list = root.querySelector('[data-jp-list]');
  const filters = Array.from(
    root.querySelectorAll('[data-jp-day]')
  );
  const viewAll = root.querySelector('[data-jp-view-all]');
  const empty = root.querySelector('[data-jp-empty]');
  const status = root.querySelector('[data-jp-status]');

  let locations = Array.from(
    root.querySelectorAll('[data-jp-location]')
  );
  let currentDay = 'all';
  let expanded = false;

  const visibleLimit =
    {{ section.settings.initial_locations | json }};

  function render() {
    const query = (search.value || '').trim().toLowerCase();

    const matching = locations.filter(item => {
      const dayMatches =
        currentDay === 'all' ||
        item.dataset.day === currentDay;

      const searchMatches =
        (item.dataset.search || '').includes(query);

      return dayMatches && searchMatches;
    });

    locations.forEach(item => {
      const index = matching.indexOf(item);

      item.hidden =
        index === -1 ||
        (!expanded && index >= visibleLimit);
    });

    empty.hidden = matching.length !== 0;
    viewAll.hidden = matching.length <= visibleLimit;

    viewAll.textContent = expanded
      ? 'Show fewer locations ↑'
      : 'View all ' + matching.length + ' locations →';
  }

  search.addEventListener('input', function () {
    expanded = false;
    render();
  });

  filters.forEach(button => {
    button.addEventListener('click', function () {
      currentDay = button.dataset.jpDay;
      expanded = false;

      filters.forEach(other => {
        const active = other === button;
        other.classList.toggle('active', active);
        other.setAttribute('aria-pressed', String(active));
      });

      render();
    });
  });

  viewAll.addEventListener('click', function () {
    expanded = !expanded;
    render();
  });

  render();

  /*
   * Optional JSON source.
   * Actual cart pickup app endpoint must be configured.
   * No live app data is invented.
   */

  const endpoint =
    {{ section.settings.locations_json_url | json }};

  if (!endpoint) return;

  status.hidden = false;
  status.textContent = 'Loading pickup locations…';

  fetch(endpoint, {
    headers: { 'Accept': 'application/json' }
  })
  .then(response => {
    if (!response.ok) {
      throw new Error('Location endpoint failed');
    }
    return response.json();
  })
  .then(json => {
    const records = Array.isArray(json)
      ? json
      : json.locations || json.pickup_locations || json.data;

    if (!Array.isArray(records)) {
      throw new Error('Unsupported location response');
    }

    const fragment = document.createDocumentFragment();
    let added = 0;

    records.forEach(record => {
      if (!record || typeof record !== 'object') return;

      const suburb = String(
        record.suburb || record.name || record.title || ''
      );
      if (!suburb) return;

      const address = String(
        record.address || record.full_address || ''
      );
      const postcode = String(
        record.postcode || record.zip || ''
      );
      const day = String(
        record.day || record.pickup_day || ''
      );
      const hours = String(
        record.hours || record.pickup_time || ''
      );
      const mapUrl = String(
        record.map_url || record.map_link || ''
      );

      const item = document.createElement('article');
      item.className = 'jp-location';
      item.setAttribute('data-jp-location', '');
      item.dataset.day = day.toLowerCase();
      item.dataset.search =
        [suburb, postcode, address].join(' ').toLowerCase();

      const info = document.createElement('div');
      info.className = 'jp-location-info';

      const heading = document.createElement('h3');
      heading.textContent = suburb;

      const times = document.createElement('p');
      times.textContent =
        [day, hours].filter(Boolean).join(' · ');

      const addressElement = document.createElement('span');
      addressElement.textContent = address;

      info.append(heading, times, addressElement);
      item.append(info);

      if (/^https:\/\//i.test(mapUrl)) {
        const link = document.createElement('a');
        link.className = 'jp-directions';
        link.href = mapUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Get directions →';
        item.append(link);
      }

      fragment.append(item);
      added++;
    });

    if (!added) {
      throw new Error('No valid locations found');
    }

    locations.forEach(item => item.remove());
    list.append(fragment);

    locations = Array.from(
      list.querySelectorAll('[data-jp-location]')
    );

    expanded = false;
    status.hidden = true;
    render();
  })
  .catch(error => {
    console.warn('Pickup locations:', error);
    status.textContent =
      'Live locations unavailable. Showing configured pickup points.';
    status.hidden = false;
  });
})();
</script>

{% schema %}
{
  "name": "Joy pickup locations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your local pick up point"
    },
    {
      "type": "text",
      "id": "locations_json_url",
      "label": "Locations JSON URL",
      "info": "Optional public JSON feed for dynamic locations. Leave blank to use blocks."
    },
    {
      "type": "range",
      "id": "initial_locations",
      "label": "Initially visible locations",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "note",
      "label": "Bottom note",
      "default": "Times shown are estimated driver arrival times. Please wait for your ready to collect SMS."
    },
    {
      "type": "color",
      "id": "green",
      "label": "Dark green",
      "default": "#064633"
    },
    {
      "type": "color",
      "id": "cream",
      "label": "Cream background",
      "default": "#f8f5ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#18253a"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "pickup",
      "name": "Pickup location",
      "settings": [
        {
          "type": "text",
          "id": "suburb",
          "label": "Suburb",
          "default": "Taringa"
        },
        {
          "type": "text",
          "id": "postcode",
          "label": "Postcode",
          "default": "4068"
        },
        {
          "type": "select",
          "id": "day",
          "label": "Pickup day",
          "options": [
            {"value": "Wednesday", "label": "Wednesday"},
            {"value": "Thursday", "label": "Thursday"},
            {"value": "Friday", "label": "Friday"},
            {"value": "Saturday", "label": "Saturday"}
          ],
          "default": "Wednesday"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Pickup hours",
          "default": "9am to noon"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "203 Taringa Parade"
        },
        {
          "type": "url",
          "id": "map_link",
          "label": "Google Maps URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Joy pickup locations",
      "blocks": [
        {
          "type": "pickup",
          "settings": {
            "suburb": "Taringa",
            "postcode": "4068",
            "day": "Wednesday",
            "hours": "9am to noon",
            "address": "203 Taringa Parade"
          }
        },
        {
          "type": "pickup",
          "settings": {
            "suburb": "Pimpama",
            "postcode": "4209",
            "day": "Thursday",
            "hours": "12:30pm to 3:30pm",
            "address": "48/7 Angela Way"
          }
        },
        {
          "type": "pickup",
          "settings": {
            "suburb": "Samford",
            "postcode": "4520",
            "day": "Saturday",
            "hours": "8am to 10am",
            "address": "6 Church Street"
          }
        }
      ]
    }
  ]
}
{% endschema %}
