{% comment %}
  Joy Pickup Locations — Bird data mapping, independent informational section.
  Location addresses below are from Bird advanced scripting snapshot supplied by store.
  NOT the Bird live location feed. Days/times must come from an approved JSON feed
  or from matching Theme Editor pickup blocks. Never updates Bird/cart.
{% endcomment %}
<section id="joy-pickups-{{ section.id }}" class="jpl-section" style="--jpl-green:{{ section.settings.green }};--jpl-cream:{{ section.settings.cream }};--jpl-bg:{{ section.settings.bg_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px">
 <div class="jpl-wrap">
  <h2>{{ section.settings.pickups_title | escape }}</h2>
  <div class="jpl-toolbar">
   <label class="jpl-search"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg><input type="search" data-search aria-label="Search suburb or postcode" placeholder="Search suburb or postcode"></label>
   <div class="jpl-days" role="group" aria-label="Filter pickup day">
    <button type="button" data-day="all" class="is-active" aria-pressed="true">All days</button>
    <button type="button" data-day="wednesday" aria-pressed="false">Wednesday</button>
    <button type="button" data-day="thursday" aria-pressed="false">Thursday</button>
    <button type="button" data-day="friday" aria-pressed="false">Friday</button>
    <button type="button" data-day="saturday" aria-pressed="false">Saturday</button>
   </div>
  </div>
  <div class="jpl-status" data-status role="status" aria-live="polite" hidden></div>
  <div class="jpl-list" data-list></div>
  <p class="jpl-empty" data-empty hidden>No matching pickup locations.</p>
  <button class="jpl-view" type="button" data-more hidden></button>
  {% if section.settings.pickups_note != blank %}<p class="jpl-note">{{ section.settings.pickups_note | escape }}</p>{% endif %}
  <script type="application/json" data-bird-snapshot>[{"id": "109014", "name": "NARANGBA", "address": "21 Matterhorn Drive, Narangba", "day": "", "hours": ""}, {"id": "109015", "name": "DAYBORO", "address": "3468 Mount Mee Road, Dayboro", "day": "", "hours": ""}, {"id": "109016", "name": "EATONS HILL", "address": "14 Queen Elizabeth Drive, Eatons Hill", "day": "", "hours": ""}, {"id": "109017", "name": "CAPALABA", "address": "69 Killarney Crescent, Capalaba", "day": "", "hours": ""}, {"id": "109018", "name": "WYNNUM WEST", "address": "1/203 Randall Road, Wynnum West", "day": "", "hours": ""}, {"id": "109019", "name": "CARINDALE", "address": "79 Kilmorey Street, Carindale", "day": "", "hours": ""}, {"id": "109020", "name": "BALMORAL", "address": "3 Walkers Drive, Balmoral", "day": "", "hours": ""}, {"id": "109021", "name": "ROCHEDALE SOUTH", "address": "6 Bawden Court, Rochedale South", "day": "", "hours": ""}, {"id": "109022", "name": "TARRAGINDI", "address": "27 Kogarah Street, Tarragindi", "day": "", "hours": ""}, {"id": "109023", "name": "SAMFORD", "address": "6 Church Street, Samford Village", "day": "", "hours": ""}, {"id": "109024", "name": "KEPERRA", "address": "58 Glengarry Rd, Keperra", "day": "", "hours": ""}, {"id": "109025", "name": "WOOLOOWIN", "address": "11 Owen Street, Wooloowin", "day": "", "hours": ""}, {"id": "109026", "name": "PIMPAMA", "address": "48/7 Angela Way, Pimpama", "day": "", "hours": ""}, {"id": "109027", "name": "EDENS LANDING", "address": "10 Jonath Court, Edens Landing", "day": "", "hours": ""}, {"id": "109028", "name": "KARANA DOWNS", "address": "2 Kyuna Court, Karana Downs", "day": "", "hours": ""}, {"id": "109029", "name": "ROCKLEA", "address": "34 Reginald Street, Rocklea", "day": "", "hours": ""}, {"id": "109030", "name": "ALDERLEY", "address": "100 Mornington Street, Alderley", "day": "", "hours": ""}, {"id": "109031", "name": "KEDRON", "address": "23 Eddowes Street, Kedron", "day": "", "hours": ""}, {"id": "109032", "name": "KENMORE", "address": "45 Twilight Street, Kenmore", "day": "", "hours": ""}, {"id": "109033", "name": "TARINGA", "address": "203 Taringa Parade, Taringa", "day": "", "hours": ""}, {"id": "109034", "name": "FOREST LAKE", "address": "10 Allen Close, Forest Lake", "day": "", "hours": ""}, {"id": "109035", "name": "PULLENVALE", "address": "2447 Moggill Road, Pullenvale", "day": "", "hours": ""}, {"id": "112786", "name": "BRIBIE ISLAND", "address": "10 Aylward Rd, Ningi", "day": "", "hours": ""}]</script>
  <script type="application/json" data-manual>{%- capture block_data -%}[
  {%- for block in section.blocks -%}{%- if block.type == 'pickup' -%}
  {"id":{{ block.settings.bird_id | json }},"name":{{ block.settings.suburb | json }},"address":{{ block.settings.address | json }},"postcode":{{ block.settings.postcode | json }},"day":{{ block.settings.day | json }},"hours":{{ block.settings.hours | json }},"map_url":{{ block.settings.map_link | json }}}{% unless forloop.last %},{% endunless %}
  {%- endif -%}{%- endfor -%}]{%- endcapture -%}{{ block_data | strip }}</script>
 </div>
</section>
<style>
#joy-pickups-{{ section.id }}{background:var(--jpl-bg);font-family:'DM Sans',sans-serif;color:#18253a}
#joy-pickups-{{ section.id }} *{box-sizing:border-box}
#joy-pickups-{{ section.id }} [hidden]{display:none!important}
#joy-pickups-{{ section.id }} .jpl-wrap{max-width:1200px;margin:auto}
#joy-pickups-{{ section.id }} h2,#joy-pickups-{{ section.id }} h3{font-family:'Holiday Journey',sans-serif;color:var(--jpl-green);font-weight:400}
#joy-pickups-{{ section.id }} h2{font-size:clamp(26px,2.6vw,36px);line-height:1.2;margin:0 0 14px}
#joy-pickups-{{ section.id }} .jpl-toolbar{display:grid;grid-template-columns:minmax(240px,1fr) auto;align-items:center;gap:12px;margin-bottom:13px}
#joy-pickups-{{ section.id }} .jpl-search{position:relative;display:block}
#joy-pickups-{{ section.id }} .jpl-search svg{position:absolute;left:14px;top:50%;width:20px;height:20px;transform:translateY(-50%);pointer-events:none;color:var(--jpl-green)}
#joy-pickups-{{ section.id }} .jpl-search input{width:100%;height:46px;padding:0 14px 0 44px;border:1px solid #dce1de;border-radius:10px;background:white;color:#18253a;font:inherit;outline:none}
#joy-pickups-{{ section.id }} .jpl-search input:focus{border-color:var(--jpl-green)}
#joy-pickups-{{ section.id }} .jpl-days{display:flex;gap:7px;flex-wrap:wrap}
#joy-pickups-{{ section.id }} .jpl-days button{background:var(--jpl-cream);border:1px solid #ded8cb;border-radius:24px;min-height:44px;padding:8px 17px;color:#18253a;cursor:pointer;font-size:13px}
#joy-pickups-{{ section.id }} .jpl-days button.is-active{background:var(--jpl-green);border-color:var(--jpl-green);color:white}
#joy-pickups-{{ section.id }} .jpl-list{display:grid;gap:8px}
#joy-pickups-{{ section.id }} .jpl-card{border:1px solid #e1e5e3;border-radius:9px;background:white;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:12px 18px}
#joy-pickups-{{ section.id }} .jpl-card h3{font-size:19px;line-height:1.2;margin:0 0 4px}
#joy-pickups-{{ section.id }} .jpl-card p{font-size:14px;margin:0 0 4px}
#joy-pickups-{{ section.id }} .jpl-card span{font-size:13px;color:#526278}
#joy-pickups-{{ section.id }} .jpl-card a{white-space:nowrap;color:var(--jpl-green);font-size:13px;font-weight:700;text-decoration:underline}
#joy-pickups-{{ section.id }} .jpl-view{margin-top:10px;width:100%;min-height:42px;border:1px solid var(--jpl-green);background:white;border-radius:24px;color:var(--jpl-green);font-weight:700;cursor:pointer}
#joy-pickups-{{ section.id }} .jpl-note{font-size:12px;color:#617087;text-align:center;margin:12px 0 0}
#joy-pickups-{{ section.id }} .jpl-status,#joy-pickups-{{ section.id }} .jpl-empty{font-size:13px;text-align:center;padding:12px}
@media(max-width:990px){#joy-pickups-{{ section.id }} .jpl-toolbar{grid-template-columns:1fr}}
@media(max-width:749px){#joy-pickups-{{ section.id }}{padding:{{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px!important}#joy-pickups-{{ section.id }} .jpl-days button{font-size:12px;min-height:40px;padding:7px 12px}#joy-pickups-{{ section.id }} .jpl-card{padding:12px}}
@media(max-width:430px){#joy-pickups-{{ section.id }} .jpl-card{align-items:flex-start;flex-direction:column;gap:8px}}
</style>
<script>
(function(){
 const root=document.getElementById('joy-pickups-{{ section.id }}');
 if(!root || root.dataset.initialized==='yes')return; root.dataset.initialized='yes';
 const input=root.querySelector('[data-search]'),list=root.querySelector('[data-list]'),empty=root.querySelector('[data-empty]'),more=root.querySelector('[data-more]'),status=root.querySelector('[data-status]'),btns=Array.from(root.querySelectorAll('[data-day]'));
 const parse=(sel)=>{try{return JSON.parse(root.querySelector(sel).textContent)}catch(e){return []}};
 const snapshot=parse('[data-bird-snapshot]'),manual=parse('[data-manual]');
 const endpoint={{ section.settings.locations_json_url | json }};
 const limit={{ section.settings.initial_locations | json }};
 let data=[],day='all',expanded=false;
 const string=x=>x===null||x===undefined?'':String(x);
 function normalize(entry){
  if(!entry||typeof entry!=='object')return null;
  const name=string(entry.name||entry.suburb||entry.title).trim();if(!name)return null;
  return {id:string(entry.id||entry.locationId),name,address:string(entry.address||entry.full_address),postcode:string(entry.postcode||entry.zip),day:string(entry.day||entry.pickup_day),hours:string(entry.hours||entry.pickup_time),map_url:string(entry.map_url||entry.map_link)};
 }
 function merge(){
  const byId=new Map();
  snapshot.concat(manual).forEach(raw=>{const rec=normalize(raw);if(!rec)return;const key=rec.id||rec.name.toLowerCase();byId.set(key,Object.assign({},byId.get(key)||{},Object.fromEntries(Object.entries(rec).filter(([k,v])=>v!==''))))});
  data=Array.from(byId.values());render();
 }
 function render(){
  const query=input.value.trim().toLowerCase();
  const matched=data.filter(x=>(day==='all'||x.day.toLowerCase().split(/[^a-z]+/).includes(day))&&[x.name,x.postcode,x.address].join(' ').toLowerCase().includes(query));
  list.replaceChildren();
  matched.slice(0,expanded?matched.length:limit).forEach(x=>{
   const article=document.createElement('article');article.className='jpl-card';
   const info=document.createElement('div');const h=document.createElement('h3');h.textContent=x.name;info.append(h);
   if(x.day||x.hours){const time=document.createElement('p');time.textContent=[x.day,x.hours].filter(Boolean).join(' · ');info.append(time)}
   const address=document.createElement('span');address.textContent=x.address;info.append(address);article.append(info);
   if(x.address){const a=document.createElement('a');a.textContent='♧ Get directions';a.target='_blank';a.rel='noopener noreferrer';a.href=/^https:\/\//.test(x.map_url)?x.map_url:'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(x.address+', Queensland, Australia');article.append(a)}
   list.append(article);
  });
  empty.hidden=matched.length>0;
  more.hidden=matched.length<=limit;
  more.textContent=expanded?'Show fewer locations ↑':'View all '+matched.length+' locations →';
  if(day!=='all' && !data.some(x=>x.day)){status.hidden=false;status.textContent='Pickup days are not included in the Bird location mapping. Connect a schedule feed or set days in the Theme Editor.'}else if(!endpoint){status.hidden=true}
 }
 input.addEventListener('input',()=>{expanded=false;render()});
 btns.forEach(b=>b.addEventListener('click',()=>{day=b.dataset.day;expanded=false;btns.forEach(other=>{const active=other===b;other.classList.toggle('is-active',active);other.setAttribute('aria-pressed',String(active))});render()}));
 more.addEventListener('click',()=>{expanded=!expanded;render()});
 merge();
 if(endpoint){status.hidden=false;status.textContent='Loading pickup locations…';
  fetch(endpoint,{headers:{Accept:'application/json'}}).then(r=>{if(!r.ok)throw new Error('Request failed');return r.json()}).then(json=>{
   const arr=Array.isArray(json)?json:json.locations||json.pickup_locations||json.data;
   if(!Array.isArray(arr))throw new Error('Unknown response shape');
   const cleaned=arr.map(normalize).filter(Boolean);if(!cleaned.length)throw new Error('Empty location list');
   data=cleaned;expanded=false;status.hidden=true;render();
  }).catch(e=>{status.hidden=false;status.textContent='Live location feed unavailable; showing Bird location mapping snapshot.';console.warn('Pickup location feed:',e)})
 }
})();
</script>
{% schema %}
{
  "name": "Joy pickup locations",
  "settings": [
    {
      "type": "text",
      "id": "pickups_title",
      "label": "Heading",
      "default": "Find your local pick up point"
    },
    {
      "type": "text",
      "id": "locations_json_url",
      "label": "Public locations JSON URL",
      "info": "Optional. Bird advanced scripting does not expose an endpoint. Only enter a verified public read-only feed URL."
    },
    {
      "type": "range",
      "id": "initial_locations",
      "label": "Initially visible locations",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "pickups_note",
      "label": "Note",
      "default": "Times shown are estimated driver arrival times. Please wait for your ready to collect SMS."
    },
    {
      "type": "color",
      "id": "green",
      "label": "Dark green",
      "default": "#086c3f"
    },
    {
      "type": "color",
      "id": "cream",
      "label": "Cream",
      "default": "#f8f5ed"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "pickup",
      "name": "Pickup location override",
      "settings": [
        {
          "type": "text",
          "id": "bird_id",
          "label": "Bird location ID (optional)"
        },
        {
          "type": "text",
          "id": "suburb",
          "label": "Suburb / location name",
          "default": "Taringa"
        },
        {
          "type": "text",
          "id": "postcode",
          "label": "Postcode"
        },
        {
          "type": "select",
          "id": "day",
          "label": "Pickup day",
          "options": [
            {
              "value": "Wednesday",
              "label": "Wednesday"
            },
            {
              "value": "Thursday",
              "label": "Thursday"
            },
            {
              "value": "Friday",
              "label": "Friday"
            },
            {
              "value": "Saturday",
              "label": "Saturday"
            }
          ],
          "default": "Wednesday"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Pickup hours"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Full address"
        },
        {
          "type": "url",
          "id": "map_link",
          "label": "Directions URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Joy pickup locations"
    }
  ]
}
{% endschema %}
