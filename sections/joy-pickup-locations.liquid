
{% comment %}
  Joy Wholefoods - Pickup Locations
  Search, day filters, view all, optional JSON feed
{% endcomment %}

<section
  id="joy-pickup-{{ section.id }}"
  class="joy-pickup-section"
  style="
    --jp-green: {{ section.settings.green }};
    --jp-cream: {{ section.settings.cream }};
    --jp-text: {{ section.settings.text_color }};
    --jp-bg: {{ section.settings.bg_color }};
  "
>
  <div class="jp-container">

    <h2 class="jp-heading">
      {{ section.settings.pickups_title }}
    </h2>

    <div class="jp-filters">

      <label class="jp-search">
        <span aria-hidden="true">⌕</span>
        <input
          type="search"
          data-pickup-search
          placeholder="Search suburb or postcode"
          aria-label="Search pickup locations"
        >
      </label>

      <div class="jp-days" role="group" aria-label="Pickup day">
        <button type="button" data-day="all" class="active">All days</button>
        <button type="button" data-day="wednesday">Wednesday</button>
        <button type="button" data-day="thursday">Thursday</button>
        <button type="button" data-day="friday">Friday</button>
        <button type="button" data-day="saturday">Saturday</button>
      </div>

    </div>

    <p class="jp-status" data-status hidden></p>

    <div class="jp-list" data-pickup-list>

      {% for block in section.blocks %}
        {% if block.type == 'pickup' %}
          <article
            class="jp-item"
            data-pickup
            data-day="{{ block.settings.day | downcase | escape }}"
            data-search="{{ block.settings.suburb | append: ' ' | append: block.settings.postcode | append: ' ' | append: block.settings.address | downcase | escape }}"
            {{ block.shopify_attributes }}
          >
            <div>
              <h3>{{ block.settings.suburb | escape }}</h3>
              <p>
                {{ block.settings.day | escape }}
                · {{ block.settings.hours | escape }}
              </p>
              <span>{{ block.settings.address | escape }}</span>
            </div>

            {% if block.settings.map_link != blank %}
              <a
                href="{{ block.settings.map_link }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                Get directions →
              </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}

    </div>

    <p class="jp-empty" data-empty hidden>
      No pickup locations match your search.
    </p>

    <button type="button" class="jp-view-all" data-show-all hidden>
      View all locations →
    </button>

    {% if section.settings.pickups_note != blank %}
      <p class="jp-note">
        {{ section.settings.pickups_note | escape }}
      </p>
    {% endif %}

  </div>
</section>

<style>
#joy-pickup-{{ section.id }} {
  background: var(--jp-bg);
  color: var(--jp-text);
  padding:
    {{ section.settings.padding_top }}px
    20px
    {{ section.settings.padding_bottom }}px;
}

#joy-pickup-{{ section.id }} *,
#joy-pickup-{{ section.id }} *::before,
#joy-pickup-{{ section.id }} *::after {
  box-sizing: border-box;
}

#joy-pickup-{{ section.id }} [hidden] {
  display: none !important;
}

#joy-pickup-{{ section.id }} .jp-container {
  max-width: 1200px;
  margin: 0 auto;
}

#joy-pickup-{{ section.id }} .jp-heading {
  font-size: clamp(25px, 2.5vw, 34px);
  font-weight: 800;
  color: var(--jp-green);
  margin: 0 0 14px;
  line-height: 1.2;
}

#joy-pickup-{{ section.id }} .jp-filters {
  display: grid;
  grid-template-columns: minmax(200px, 1fr) auto;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

#joy-pickup-{{ section.id }} .jp-search {
  position: relative;
  display: block;
}

#joy-pickup-{{ section.id }} .jp-search span {
  position: absolute;
  top: 50%;
  left: 15px;
  transform: translateY(-50%);
  font-size: 26px;
  pointer-events: none;
}

#joy-pickup-{{ section.id }} .jp-search input {
  width: 100%;
  height: 46px;
  padding: 0 15px 0 45px;
  border: 1px solid #dfe3e0;
  border-radius: 10px;
  background: #fff;
  color: var(--jp-text);
  font: inherit;
  box-shadow: none;
  outline: none;
}

#joy-pickup-{{ section.id }} .jp-search input:focus {
  border-color: var(--jp-green);
}

#joy-pickup-{{ section.id }} .jp-days {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
}

#joy-pickup-{{ section.id }} .jp-days button {
  min-height: 44px;
  padding: 9px 17px;
  border: 1px solid #ded8cc;
  border-radius: 25px;
  background: var(--jp-cream);
  color: var(--jp-text);
  font-size: 13px;
  font-weight: 400;
  cursor: pointer;
}

#joy-pickup-{{ section.id }} .jp-days button.active {
  background: var(--jp-green);
  border-color: var(--jp-green);
  color: #fff;
}

#joy-pickup-{{ section.id }} .jp-list {
  display: grid;
  gap: 9px;
}

#joy-pickup-{{ section.id }} .jp-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  min-width: 0;
  padding: 14px 19px;
  border: 1px solid #e0e4e2;
  border-radius: 9px;
  background: #fff;
}

#joy-pickup-{{ section.id }} .jp-item h3 {
  margin: 0 0 4px;
  color: var(--jp-green);
  font-size: 18px;
  line-height: 1.2;
  font-weight: 800;
}

#joy-pickup-{{ section.id }} .jp-item p {
  margin: 0 0 3px;
  font-size: 14px;
  line-height: 1.4;
}

#joy-pickup-{{ section.id }} .jp-item span {
  font-size: 13px;
  color: #526278;
}

#joy-pickup-{{ section.id }} .jp-item a {
  color: var(--jp-green);
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  text-decoration: underline;
}

#joy-pickup-{{ section.id }} .jp-view-all {
  display: block;
  width: 100%;
  min-height: 42px;
  margin-top: 12px;
  border: 1px solid var(--jp-green);
  border-radius: 25px;
  background: #fff;
  color: var(--jp-green);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}

#joy-pickup-{{ section.id }} .jp-view-all:hover {
  background: var(--jp-cream);
}

#joy-pickup-{{ section.id }} .jp-empty,
#joy-pickup-{{ section.id }} .jp-status {
  padding: 12px;
  font-size: 13px;
  text-align: center;
}

#joy-pickup-{{ section.id }} .jp-note {
  margin: 13px 0 0;
  color: #617087;
  text-align: center;
  font-size: 12px;
  line-height: 1.5;
}

@media (max-width: 990px) {
  #joy-pickup-{{ section.id }} .jp-filters {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 749px) {
  #joy-pickup-{{ section.id }} {
    padding:
      {{ section.settings.mobile_padding_top }}px
      16px
      {{ section.settings.mobile_padding_bottom }}px;
  }

  #joy-pickup-{{ section.id }} .jp-days {
    gap: 6px;
  }

  #joy-pickup-{{ section.id }} .jp-days button {
    padding: 8px 12px;
    font-size: 12px;
  }

  #joy-pickup-{{ section.id }} .jp-item {
    padding: 12px;
    gap: 8px;
  }

  #joy-pickup-{{ section.id }} .jp-item h3 {
    font-size: 16px;
  }
}

@media (max-width: 420px) {
  #joy-pickup-{{ section.id }} .jp-item {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

<script>
(function () {
  const root = document.getElementById(
    'joy-pickup-{{ section.id }}'
  );

  if (!root || root.dataset.initialized === 'true') return;

  root.dataset.initialized = 'true';

  const search = root.querySelector('[data-pickup-search]');
  const list = root.querySelector('[data-pickup-list]');
  const buttons = Array.from(root.querySelectorAll('[data-day]'));
  const showAll = root.querySelector('[data-show-all]');
  const empty = root.querySelector('[data-empty]');
  const status = root.querySelector('[data-status]');

  let pickups = Array.from(root.querySelectorAll('[data-pickup]'));
  let selectedDay = 'all';
  let expanded = false;

  const visibleLimit = {{ section.settings.initial_locations | json }};

  function update() {
    const query = (search.value || '').trim().toLowerCase();

    const matches = pickups.filter(item => {
      const matchDay =
        selectedDay === 'all' ||
        item.dataset.day === selectedDay;

      const matchSearch =
        (item.dataset.search || '').includes(query);

      return matchDay && matchSearch;
    });

    pickups.forEach(item => {
      const index = matches.indexOf(item);

      item.hidden =
        index === -1 ||
        (!expanded && index >= visibleLimit);
    });

    empty.hidden = matches.length > 0;
    showAll.hidden = matches.length <= visibleLimit;

    showAll.textContent = expanded
      ? 'Show fewer locations ↑'
      : 'View all ' + matches.length + ' locations →';
  }

  search.addEventListener('input', function () {
    expanded = false;
    update();
  });

  buttons.forEach(button => {
    button.addEventListener('click', function () {
      selectedDay = button.dataset.day;
      expanded = false;

      buttons.forEach(btn => {
        const active = btn === button;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      update();
    });
  });

  showAll.addEventListener('click', function () {
    expanded = !expanded;
    update();
  });

  update();

  // Optional public JSON feed.
  // Example:
  // [
  //   {
  //     "name": "Alderley",
  //     "address": "100 Mornington Street",
  //     "postcode": "4051",
  //     "day": "Wednesday",
  //     "hours": "9am to noon",
  //     "map_url": "https://example.com"
  //   }
  // ]

  const endpoint = {{ section.settings.locations_json_url | json }};

  if (!endpoint) return;

  status.hidden = false;
  status.textContent = 'Loading pickup locations…';

  fetch(endpoint, {
    headers: { Accept: 'application/json' }
  })
  .then(response => {
    if (!response.ok) throw new Error('Location feed unavailable');
    return response.json();
  })
  .then(json => {
    const locations = Array.isArray(json)
      ? json
      : json.locations || json.pickup_locations || json.data;

    if (!Array.isArray(locations)) {
      throw new Error('Invalid location data');
    }

    const fragment = document.createDocumentFragment();
    let validCount = 0;

    locations.forEach(location => {
      if (!location || typeof location !== 'object') return;

      const name = String(
        location.suburb || location.name || location.title || ''
      );

      if (!name) return;

      const address = String(
        location.address || location.full_address || ''
      );

      const postcode = String(
        location.postcode || location.zip || ''
      );

      const day = String(
        location.day || location.pickup_day || ''
      );

      const hours = String(
        location.hours || location.pickup_time || ''
      );

      const mapURL = String(
        location.map_url || location.map_link || ''
      );

      const item = document.createElement('article');
      item.className = 'jp-item';
      item.setAttribute('data-pickup', '');

      item.dataset.day = day.toLowerCase();
      item.dataset.search =
        [name, postcode, address].join(' ').toLowerCase();

      const details = document.createElement('div');
      const heading = document.createElement('h3');
      const time = document.createElement('p');
      const addressNode = document.createElement('span');

      heading.textContent = name;
      time.textContent = [day, hours].filter(Boolean).join(' · ');
      addressNode.textContent = address;

      details.append(heading, time, addressNode);
      item.append(details);

      if (/^https:\/\//i.test(mapURL)) {
        const link = document.createElement('a');
        link.href = mapURL;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Get directions →';
        item.append(link);
      }

      fragment.append(item);
      validCount++;
    });

    if (!validCount) {
      throw new Error('No valid locations');
    }

    pickups.forEach(item => item.remove());
    list.append(fragment);

    pickups = Array.from(list.querySelectorAll('[data-pickup]'));

    status.hidden = true;
    expanded = false;
    update();
  })
  .catch(error => {
    console.warn('Joy Pickup Locations:', error);
    status.textContent =
      'Live locations unavailable. Showing configured locations.';
    status.hidden = false;
  });
})();
</script>

{% schema %}
{
  "name": "Joy pickup locations",
  "settings": [
    {
      "type": "text",
      "id": "pickups_title",
      "label": "Heading",
      "default": "Find your local pick up point"
    },
    {
      "type": "text",
      "id": "locations_json_url",
      "label": "Locations JSON endpoint",
      "info": "Optional public JSON URL. Leave blank to use pickup blocks."
    },
    {
      "type": "range",
      "id": "initial_locations",
      "label": "Initially visible locations",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "pickups_note",
      "label": "Bottom note",
      "default": "Times shown are estimated driver arrival times. Please wait for your ready to collect SMS."
    },
    {
      "type": "color",
      "id": "green",
      "label": "Dark green",
      "default": "#064633"
    },
    {
      "type": "color",
      "id": "cream",
      "label": "Cream background",
      "default": "#f8f5ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#18253a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "pickup",
      "name": "Pickup location",
      "settings": [
        {
          "type": "text",
          "id": "suburb",
          "label": "Suburb",
          "default": "Taringa"
        },
        {
          "type": "text",
          "id": "postcode",
          "label": "Postcode",
          "default": "4068"
        },
        {
          "type": "select",
          "id": "day",
          "label": "Pickup day",
          "options": [
            {"value": "Wednesday", "label": "Wednesday"},
            {"value": "Thursday", "label": "Thursday"},
            {"value": "Friday", "label": "Friday"},
            {"value": "Saturday", "label": "Saturday"}
          ],
          "default": "Wednesday"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Pickup hours",
          "default": "9am to noon"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address",
          "default": "203 Taringa Parade"
        },
        {
          "type": "url",
          "id": "map_link",
          "label": "Directions URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Joy pickup locations",
      "blocks": [
        {
          "type": "pickup",
          "settings": {
            "suburb": "Taringa",
            "postcode": "4068",
            "day": "Wednesday",
            "hours": "9am to noon",
            "address": "203 Taringa Parade"
          }
        },
        {
          "type": "pickup",
          "settings": {
            "suburb": "Pimpama",
            "postcode": "4209",
            "day": "Thursday",
            "hours": "12:30pm to 3:30pm",
            "address": "48/7 Angela Way"
          }
        },
        {
          "type": "pickup",
          "settings": {
            "suburb": "Samford",
            "postcode": "4520",
            "day": "Saturday",
            "hours": "8am to 10am",
            "address": "6 Church Street"
          }
        }
      ]
    }
  ]
}
{% endschema %}
