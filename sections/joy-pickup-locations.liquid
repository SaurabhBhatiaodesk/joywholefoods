{% comment %}
  Joy Pickup Locations — LIVE Bird data.
  Locations (id, name, address, suburb, postcode) are fetched live from the Bird Pickup & Delivery API:
  POST https://picdel.birdchime.com/api/v3/pickup/locations
  New / removed locations and address / postcode changes update automatically.
  Pickup DAYS are derived live from POST /api/v3/pickup/calendar (next 28 days, per location, using a sample cart item).
  Bird returns full-day slots (00:00-23:59), so HOURS come from the snapshot below (matched by Bird ID) or from "Pickup location override" blocks.
  If the live API fails, the snapshot is shown as a fallback. Never updates Bird/cart.
{% endcomment %}
<section id="joy-pickups-{{ section.id }}" class="jpl-section" style="--jpl-green:{{ section.settings.green }};--jpl-cream:{{ section.settings.cream }};--jpl-bg:{{ section.settings.bg_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px">
 <div class="jpl-wrap">
  <h2>{{ section.settings.pickups_title | escape }}</h2>
  <div class="jpl-toolbar">
   <label class="jpl-search"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="7"/><path d="m16 16 5 5"/></svg><input type="search" data-search aria-label="Search suburb or postcode" placeholder="Search suburb or postcode"></label>
   <div class="jpl-days" role="group" aria-label="Filter pickup day">
    <button type="button" data-day="all" class="is-active" aria-pressed="true">All days</button>
    <button type="button" data-day="wednesday" aria-pressed="false">Wednesday</button>
    <button type="button" data-day="thursday" aria-pressed="false">Thursday</button>
    <button type="button" data-day="friday" aria-pressed="false">Friday</button>
    <button type="button" data-day="saturday" aria-pressed="false">Saturday</button>
   </div>
  </div>
  <div class="jpl-status" data-status role="status" aria-live="polite" hidden></div>
  <div class="jpl-list" data-list></div>
  <p class="jpl-empty" data-empty hidden>No matching pickup locations.</p>
  <button class="jpl-view" type="button" data-more hidden></button>
  {% if section.settings.pickups_note != blank %}<p class="jpl-note">{{ section.settings.pickups_note | escape }}</p>{% endif %}
  <script type="application/json" data-bird-snapshot>[{"id":"109014","name":"NARANGBA","address":"21 Matterhorn Drive, Narangba","day":"Friday","hours":"12:30pm - 3:30pm","postcode":"4504"},{"id":"109015","name":"DAYBORO","address":"3468 Mount Mee Road, Dayboro","day":"Friday","hours":"12:30pm - 3:30pm","postcode":"4521"},{"id":"109016","name":"EATONS HILL","address":"14 Queen Elizabeth Drive, Eatons Hill","day":"Friday","hours":"9am - 12pm","postcode":"4037"},{"id":"109017","name":"CAPALABA","address":"69 Killarney Crescent, Capalaba","day":"Friday","hours":"12:30pm - 3:30pm","postcode":"4157"},{"id":"109018","name":"WYNNUM WEST","address":"1/203 Randall Road, Wynnum West","day":"Friday","hours":"11am - 2pm","postcode":"4178"},{"id":"109019","name":"CARINDALE","address":"79 Kilmorey Street, Carindale","day":"Saturday","hours":"7am - 9am","postcode":"4152"},{"id":"109020","name":"BALMORAL","address":"3 Walkers Drive, Balmoral","day":"Saturday","hours":"7am - 9am","postcode":"4171"},{"id":"109021","name":"ROCHEDALE SOUTH","address":"6 Bawden Court, Rochedale South","day":"Saturday","hours":"8am - 10am","postcode":"4123"},{"id":"109022","name":"TARRAGINDI","address":"27 Kogarah Street, Tarragindi","day":"Saturday","hours":"7am - 9am","postcode":"4121"},{"id":"109023","name":"SAMFORD","address":"6 Church Street, Samford Village","day":"Saturday","hours":"8am - 10am","postcode":"4520"},{"id":"109024","name":"KEPERRA","address":"58 Glengarry Rd, Keperra","day":"Saturday","hours":"7am - 9am","postcode":"4054"},{"id":"109025","name":"WOOLOOWIN","address":"11 Owen Street, Wooloowin","day":"Wednesday","hours":"7am - 9am","postcode":"4030"},{"id":"109026","name":"PIMPAMA","address":"48/7 Angela Way, Pimpama","day":"Thursday","hours":"12:30pm - 3:30pm","postcode":"4209"},{"id":"109027","name":"EDENS LANDING","address":"10 Jonath Court, Edens Landing","day":"Thursday","hours":"9am - 12pm","postcode":"4207"},{"id":"109028","name":"KARANA DOWNS","address":"2 Kyuna Court, Karana Downs","day":"Thursday","hours":"12:30pm - 3:30pm","postcode":"4306"},{"id":"109029","name":"ROCKLEA","address":"34 Reginald Street, Rocklea","day":"Wednesday / Thursday","hours":"8am - 12pm","postcode":"4106"},{"id":"109030","name":"ALDERLEY","address":"100 Mornington Street, Alderley","day":"Wednesday","hours":"9am - 12pm","postcode":"4051"},{"id":"109031","name":"KEDRON","address":"23 Eddowes St, Kedron","day":"Wednesday","hours":"9am - 12pm","postcode":"4031"},{"id":"109032","name":"KENMORE","address":"45 Twilight Street, Kenmore","day":"","hours":"","postcode":"4069"},{"id":"109033","name":"TARINGA","address":"203 Taringa Parade, Taringa","day":"Wednesday","hours":"9am - 12pm","postcode":"4068"},{"id":"109034","name":"FOREST LAKE","address":"10 Allen Close, Forest Lake","day":"Thursday","hours":"9am - 12pm","postcode":"4078"},{"id":"109035","name":"PULLENVALE","address":"2447 Moggill Road, Pullenvale","day":"Wednesday","hours":"1pm - 4pm","postcode":"4069"},{"id":"112786","name":"BRIBIE ISLAND","address":"10 Aylward Rd, Ningi","day":"","hours":"","postcode":"4511"}]</script>
  <script type="application/json" data-manual>{%- capture block_data -%}[
  {%- for block in section.blocks -%}{%- if block.type == 'pickup' -%}
  {"id":{{ block.settings.bird_id | json }},"name":{{ block.settings.suburb | json }},"address":{{ block.settings.address | json }},"postcode":{{ block.settings.postcode | json }},"day":{{ block.settings.day | json }},"hours":{{ block.settings.hours | json }},"map_url":{{ block.settings.map_link | json }}}{% unless forloop.last %},{% endunless %}
  {%- endif -%}{%- endfor -%}]{%- endcapture -%}{{ block_data | strip }}</script>
 </div>
</section>

<style>
  #joy-pickups-{{ section.id }} {
    background: var(--jpl-bg);
    font-family: 'DM Sans', sans-serif;
    color: #18253a;
  }

  #joy-pickups-{{ section.id }} * {
    box-sizing: border-box;
  }

  #joy-pickups-{{ section.id }} [hidden] {
    display: none !important;
  }

  #joy-pickups-{{ section.id }} .jpl-wrap {
    max-width: 1200px;
    margin: auto;
  }

  #joy-pickups-{{ section.id }} h2,
  #joy-pickups-{{ section.id }} h3 {
    font-family: 'Holiday Journey', sans-serif;
    color: var(--jpl-green);
    font-weight: 400;
  }

  #joy-pickups-{{ section.id }} h2 {
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1.2;
    margin: 0 0 14px;
  }

  /* Toolbar */

  #joy-pickups-{{ section.id }} .jpl-toolbar {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 13px;
  }

  /* Search */

  #joy-pickups-{{ section.id }} .jpl-search {
    position: relative;
    display: block;
  }

  #joy-pickups-{{ section.id }} .jpl-search svg {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--jpl-green);
  }

  #joy-pickups-{{ section.id }} .jpl-search input {
    width: 100%;
    height: 46px;
    padding: 0 14px 0 44px;
    border: 1px solid #dce1de;
    border-radius: 10px;
    background: white;
    color: #18253a;
    font: inherit;
    outline: none;
  }

  #joy-pickups-{{ section.id }} .jpl-search input:focus {
    border-color: var(--jpl-green);
  }

  /* Day Filters */

  #joy-pickups-{{ section.id }} .jpl-days {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }

  #joy-pickups-{{ section.id }} .jpl-days button {
    background: var(--jpl-cream);
    border: 1px solid #ded8cb;
    border-radius: 24px;
    min-height: 44px;
    padding: 8px 17px;
    color: #18253a;
    cursor: pointer;
    font-size: 13px;
  }

  #joy-pickups-{{ section.id }} .jpl-days button.is-active {
    background: var(--jpl-green);
    border-color: var(--jpl-green);
    color: white;
  }

  /* Pickup List */

  #joy-pickups-{{ section.id }} .jpl-list {
    display: grid;
    gap: 8px;
  }

  /* Pickup Cards */

  #joy-pickups-{{ section.id }} .jpl-card {
    border: 1px solid #e1e5e3;
    border-radius: 9px;
    background: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 12px 18px;
  }

  #joy-pickups-{{ section.id }} .jpl-card h3 {
    font-size: 19px;
    line-height: 1.2;
    margin: 0 0 4px;
  }

  #joy-pickups-{{ section.id }} .jpl-card p {
    font-size: 14px;
    margin: 0 0 4px;
  }

  #joy-pickups-{{ section.id }} .jpl-card span {
    font-size: 13px;
    color: #526278;
  }

  #joy-pickups-{{ section.id }} .jpl-card a {
    white-space: nowrap;
    color: var(--jpl-green);
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
  }
  #joy-pickups-{{ section.id }} .jpl-card a span{
    color: var(--jpl-green);
    }

  /* View All Button */

  #joy-pickups-{{ section.id }} .jpl-view {
    margin-top: 10px;
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--jpl-green);
    background: white;
    border-radius: 24px;
    color: var(--jpl-green);
    font-weight: 700;
    cursor: pointer;
  }

  /* Notes */

  #joy-pickups-{{ section.id }} .jpl-note {
    font-size: 12px;
    color: #617087;
    text-align: center;
    margin: 12px 0 0;
  }

  /* Status and Empty State */

  #joy-pickups-{{ section.id }} .jpl-status,
  #joy-pickups-{{ section.id }} .jpl-empty {
    font-size: 13px;
    text-align: center;
    padding: 12px;
  }

  /* Tablet Responsive */

  @media (max-width: 990px) {
    #joy-pickups-{{ section.id }} .jpl-toolbar {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile Responsive */

  @media (max-width: 749px) {
    #joy-pickups-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px !important;
    }
    #joy-pickups-{{ section.id }} .jpl-search input {
        height: 39px;
    }
    #joy-pickups-{{ section.id }} .jpl-days button {
      font-size: 12px;
      min-height: auto;
      padding: 7px 12px;
    }

    #joy-pickups-{{ section.id }} .jpl-card {
      padding: 12px;
    }
  }

  /* Small Mobile Responsive */

  @media (max-width: 430px) {
    #joy-pickups-{{ section.id }} .jpl-card {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

<script>
(function(){
 const root=document.getElementById('joy-pickups-{{ section.id }}');
 if(!root || root.dataset.initialized==='yes')return; root.dataset.initialized='yes';
 const input=root.querySelector('[data-search]'),list=root.querySelector('[data-list]'),empty=root.querySelector('[data-empty]'),more=root.querySelector('[data-more]'),status=root.querySelector('[data-status]'),btns=Array.from(root.querySelectorAll('[data-day]'));
 const parse=(sel)=>{try{return JSON.parse(root.querySelector(sel).textContent)}catch(e){return []}};
 const snapshot=parse('[data-bird-snapshot]'),manual=parse('[data-manual]');
 const shop={{ section.settings.bird_shop | default: shop.permanent_domain | json }};
 const apiUrl='https://picdel.birdchime.com/api/v3/pickup/locations';
 const limit={{ section.settings.initial_locations | json }};
 let data=[],day='all',expanded=false;
 const string=x=>x===null||x===undefined?'':String(x);
 function buildAddress(entry){
  if(entry.address||entry.full_address)return string(entry.address||entry.full_address);
  const street=[entry.address1,entry.address2].map(string).map(s=>s.trim()).filter(Boolean).join(', ');
  const city=string(entry.city).trim();
  const parts=[street];
  if(city && !street.toLowerCase().includes(city.toLowerCase()))parts.push(city);
  return parts.filter(Boolean).join(', ');
 }
 function normalize(entry){
  if(!entry||typeof entry!=='object')return null;
  const name=string(entry.name||entry.suburb||entry.title).trim();if(!name)return null;
  return {id:string(entry.id||entry.locationId),name,address:buildAddress(entry),postcode:string(entry.postcode||entry.zip),day:string(entry.day||entry.pickup_day),hours:string(entry.hours||entry.pickup_time),map_url:string(entry.map_url||entry.map_link)};
 }
 const known=new Map(),knownByName=new Map();
 snapshot.forEach(raw=>{const rec=normalize(raw);if(rec){known.set(rec.id,rec);knownByName.set(rec.name.toLowerCase(),rec)}});
 const nonEmpty=obj=>Object.fromEntries(Object.entries(obj).filter(([k,v])=>v!==''));
 const sched=new Map();let liveCache=null;
 const dayNames=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
 const dayOrder=[1,2,3,4,5,6,0];
 function fmt24(t){const m=string(t).match(/^(\d{1,2}):(\d{2})$/);if(!m)return '';let h=+m[1];const min=m[2];const ap=h>=12?'pm':'am';h=h%12||12;return h+(min==='00'?'':':'+min)+ap}
 function scheduleFromCalendar(cal){
  const days=new Set();let hours='';
  (cal||[]).forEach(entry=>{
   const d=new Date(string(entry.date)+'T00:00:00Z');if(isNaN(d))return;
   days.add(d.getUTCDay());
   (entry.slots||[]).forEach(s=>{if(!hours && s.from && s.to && !(s.from==='00:00'&&/^23:5\d$/.test(s.to)))hours=fmt24(s.from)+' - '+fmt24(s.to)});
  });
  if(!days.size)return null;
  return {day:dayOrder.filter(n=>days.has(n)).map(n=>dayNames[n]).join(' / '),hours};
 }
 function isoDate(d){return d.toISOString().slice(0,10)}
 async function getSampleProduct(){
  const pid='{{ section.settings.sample_product_id }}',vid='{{ section.settings.sample_variant_id }}';
  if(pid&&vid)return {product_id:pid,variant_id:vid};
  const r=await fetch('/products.json?limit=1',{headers:{Accept:'application/json'}});
  const p=(await r.json()).products[0];
  return {product_id:String(p.id),variant_id:String(p.variants[0].id)};
 }
 async function enrichSchedules(){
  if(!liveCache)return;
  let item;try{item=await getSampleProduct()}catch(e){console.warn('Pickup schedule: no sample product',e);return}
  const start=new Date(),end=new Date(Date.now()+28*864e5);
  const pending=liveCache.filter(x=>/^\d+$/.test(x.id));
  const worker=async()=>{
   while(pending.length){
    const x=pending.shift();
    try{
     const r=await fetch('https://picdel.birdchime.com/api/v3/pickup/calendar',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({shop:shop,location_id:Number(x.id),start_date:isoDate(start),end_date:isoDate(end),shopping_cart:[{variant_id:item.variant_id,product_id:item.product_id,quantity:1}]})});
     if(!r.ok)continue;
     const s=scheduleFromCalendar((await r.json()).calendar);
     if(s){sched.set(x.id,s);build(liveCache)}
    }catch(err){console.warn('Pickup calendar:',err)}
   }
  };
  await Promise.all(Array.from({length:Math.min(6,pending.length)},()=>worker()));
 }
 function build(live){
  const byId=new Map();
  if(live){
   live.forEach(rec=>{const old=known.get(rec.id)||knownByName.get(rec.name.toLowerCase())||{};const s=sched.get(rec.id)||{};byId.set(rec.id||rec.name.toLowerCase(),Object.assign({},rec,{day:s.day||rec.day||old.day||'',hours:s.hours||rec.hours||old.hours||''}))});
  }else{
   known.forEach(rec=>byId.set(rec.id||rec.name.toLowerCase(),rec));
  }
  manual.forEach(raw=>{const rec=normalize(raw);if(!rec)return;const existing=[...byId.entries()].find(([key,v])=>key===rec.id||v.name.toLowerCase()===rec.name.toLowerCase());const key=existing?existing[0]:(rec.id||rec.name.toLowerCase());byId.set(key,Object.assign({},byId.get(key)||{},nonEmpty(rec)))});
  const order={'wednesday':0,'thursday':1,'friday':2,'saturday':3};
  const sortDay=x=>Math.min(...x.day.toLowerCase().split(/[^a-z]+/).map(k=>order[k]??9));
  data=Array.from(byId.values()).sort((a,b)=>sortDay(a)-sortDay(b)||a.name.localeCompare(b.name));
  render();
 }
 function formatHours(raw){
  const str=string(raw).trim().toLowerCase().replace(/12\s*noon/g,'12pm');
  const match=str.match(/^(\d{1,2}(?::\d{2})?)\s*(am|pm)?\s*[-–]\s*(\d{1,2}(?::\d{2})?)\s*(am|pm)$/);
  if(!match)return string(raw);
  return match[1]+(match[2]||match[4])+' - '+match[3]+match[4];
 }
 function displayAddress(x){
  const address=x.address.trim();
  if(!address)return '';
  if(!x.postcode || /\bQLD\s*\d{4}\s*$/i.test(address) || /,\s*\d{4}\s*$/.test(address))return address;
  return address+' QLD '+x.postcode;
 }
 function render(){
  const query=input.value.trim().toLowerCase();
  const matched=data.filter(x=>{const days=x.day.toLowerCase().split(/[^a-z]+/).filter(Boolean);return (day==='all'||days.includes(day))&&[x.name,x.postcode,x.address].join(' ').toLowerCase().includes(query)});
  list.replaceChildren();
  matched.slice(0,expanded?matched.length:limit).forEach(x=>{
   const article=document.createElement('article');article.className='jpl-card';
   const info=document.createElement('div');const h=document.createElement('h3');h.textContent=x.name;info.append(h);
   {const time=document.createElement('p');time.textContent=(x.day||x.hours)?[x.day,formatHours(x.hours)].filter(Boolean).join(' · '):'Pickup time to be confirmed';info.append(time)}
   const address=document.createElement('span');address.textContent=displayAddress(x);info.append(address);article.append(info);
   if(x.address){
    const a=document.createElement('a');
    a.target='_blank';a.rel='noopener noreferrer';
    a.href=/^https:\/\//.test(x.map_url)?x.map_url:'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(displayAddress(x)+', Australia');
    a.style.display='inline-flex';a.style.alignItems='center';a.style.gap='7px';
    a.innerHTML='<svg width="20" height="20" viewBox="-4 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="flex-shrink:0"><path fill="currentColor" transform="translate(-104 -411)" d="M116,426 C114.343,426 113,424.657 113,423 C113,421.343 114.343,420 116,420 C117.657,420 119,421.343 119,423 C119,424.657 117.657,426 116,426 L116,426 Z M116,418 C113.239,418 111,420.238 111,423 C111,425.762 113.239,428 116,428 C118.761,428 121,425.762 121,423 C121,420.238 118.761,418 116,418 L116,418 Z M116,440 C114.337,440.009 106,427.181 106,423 C106,417.478 110.477,413 116,413 C121.523,413 126,417.478 126,423 C126,427.125 117.637,440.009 116,440 L116,440 Z M116,411 C109.373,411 104,416.373 104,423 C104,428.018 114.005,443.011 116,443 C117.964,443.011 128,427.95 128,423 C128,416.373 122.627,411 116,411 L116,411 Z"/></svg><span>Get directions</span>';
    article.append(a);
   }
   list.append(article);
  });
  empty.hidden=matched.length>0 || !data.length;
  more.hidden=matched.length<=limit;
  more.textContent=expanded?'Show fewer locations ↑':'View all '+matched.length+' locations →';
 }
 input.addEventListener('input',()=>{expanded=false;render()});
 btns.forEach(b=>b.addEventListener('click',()=>{day=b.dataset.day;expanded=false;btns.forEach(other=>{const active=other===b;other.classList.toggle('is-active',active);other.setAttribute('aria-pressed',String(active))});render()}));
 more.addEventListener('click',()=>{expanded=!expanded;render()});

 status.hidden=false;status.textContent='Loading pickup locations…';
 fetch(apiUrl,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({shop:shop})})
  .then(r=>{if(!r.ok)throw new Error('Request failed '+r.status);return r.json()})
  .then(json=>{
   const arr=Array.isArray(json)?json:json.data||json.locations;
   if(!Array.isArray(arr))throw new Error('Unknown response shape');
   const cleaned=arr.map(normalize).filter(Boolean);
   if(!cleaned.length)throw new Error('Empty location list');
   status.hidden=true;liveCache=cleaned;build(cleaned);enrichSchedules();
  })
  .catch(e=>{status.hidden=false;status.textContent='Live location feed unavailable; showing saved pickup locations.';console.warn('Pickup location feed:',e);build(null)});
})();
</script>
{% schema %}
{
  "name": "Joy pickup locations",
  "settings": [
    {
      "type": "text",
      "id": "pickups_title",
      "label": "Heading",
      "default": "Find your local pick up point"
    },
    {
      "type": "text",
      "id": "bird_shop",
      "label": "Bird shop domain",
      "info": "Used for the live Bird API. Leave blank to use this store's myshopify domain automatically.",
      "default": "sprayfreefarmacy.myshopify.com"
    },
    {
      "type": "text",
      "id": "sample_product_id",
      "label": "Sample product ID (for live pickup days)",
      "info": "Optional. Bird's calendar API needs a cart item. Leave both blank to auto-use the first product of the store."
    },
    {
      "type": "text",
      "id": "sample_variant_id",
      "label": "Sample variant ID (for live pickup days)"
    },
    {
      "type": "range",
      "id": "initial_locations",
      "label": "Initially visible locations",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "pickups_note",
      "label": "Note",
      "default": "Times shown are estimated driver arrival times. Please wait for your ready to collect SMS."
    },
    {
      "type": "color",
      "id": "green",
      "label": "Dark green",
      "default": "#086c3f"
    },
    {
      "type": "color",
      "id": "cream",
      "label": "Cream",
      "default": "#f8f5ed"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 24
