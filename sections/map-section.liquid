{% assign locations_metafield_key = "pickup_locations" %}
{% assign ba_metafield_namespace = 'sf-ba-integration' %}
{% assign locations_metafield_namespace = "sf-ba-integration" %}
{% assign customer_meta_metafield_key = "ba-customer-meta" %}

{%- comment -%} Moved from layout/theme.liquid so Google Maps only loads on pages that show the map {%- endcomment -%}
<script src="//maps.googleapis.com/maps/api/js?key=AIzaSyCdj92JVDyKda9MkRc6IiN8ZUrAdMBnF0k&v=3.exp&libraries=places"></script>
<script src="{{ 'location-map.js' | asset_url }}" ></script>
<script>
  if(window.LOCATIONS_MAP !== undefined){
    window._locations = {{shop.metafields['sf-ba-integration']['pickup_locations'] | json}};
    LOCATIONS_MAP.icons.frozen = '{{ 'mapMarker-frozen.png' | asset_img_url: '20px' }}';
    LOCATIONS_MAP.icons.non_frozen = '{{ 'mapMarker.png' | asset_img_url: '20px' }}';
    LOCATIONS_MAP.icons.disabled = '{{ 'mapMarker-disabled.png' | asset_img_url: '20px' }}';

    if(window._locations) {
      if(Array.isArray(window._locations)){
        LOCATIONS_MAP.locations = window._locations;
      } else{
        LOCATIONS_MAP.locations = Object.values(window._locations);
      }
    }
  }
</script>

<div class="about background" ppp>
    <div class="about__container">
        <div class="about__heading">
            <h2 class="about__title">{{ section.settings.heading }}</h2>
        </div>
        <div class="about__description">
            {{ section.settings.paragraph }}
        </div>
        <div class="about__heading">
            <h6 class="sub__heading">{{ section.settings.subheading }}</h6>
        </div>

        <div data-code='{{ page.metafields.custom.sas }}' id="map" style="height: 400px;"></div>

        <script>
          if(window.LOCATIONS_MAP !== undefined){
            $(document).ready(function(){
              LOCATIONS_MAP.init(false);
            });
          }
          var codeValue = $('#map').data('code');
          if(codeValue) {
            window.codeValue = codeValue;
          }
        </script>

        <div class="about__description">
            {{ section.settings.paragraph2 }}
        </div>
    </div>
</div>

<script>
  if(window.LOCATIONS_MAP !== undefined){
    $(document).ready(function(){
      LOCATIONS_MAP.init(false);
    });
  }
</script>

{% schema %}
{
  "name": "Pickup location",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Select Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lorem ipsum"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Lorem ipsum"
    },
    {
      "type": "richtext",
      "id": "paragraph2",
      "label": "Paragraph"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Pickup location"
    }
  ]
}
{% endschema %}

<style>
  .about.background {
    background-color: {{ section.settings.bg_color }};
  }

  .about {
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
    padding-left: 120px;
    padding-right: 120px;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
  }

  /* Heading → Holiday, medium green, lighter weight */
  .about__title {
    color: #086C3F !important;
    font-family: 'Holiday Journey', cursive !important;
    font-size: 59px;
    font-style: normal;
    font-weight: 400 !important;
    line-height: 1.2;
    letter-spacing: 0;
    margin-top: 0;
    margin-bottom: 41px;
    text-rendering: optimizeLegibility;
  }

  /* Body → DM Sans */
  .about__description,
  .about__description p,
  .about__description span,
  .about__description div {
    color: #141414;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 145.3%;
    letter-spacing: -0.36px;
  }

  .about .about__container .about__description:nth-child(2) p:first-child {
    margin-bottom: 37px !important;
  }

  .about__container {
    max-width: 948px;
    margin: auto;
  }

  /* Subheading → DM Sans */
  .sub__heading {
    color: #043D22;
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 145.3%;
    letter-spacing: -0.36px;
    margin-bottom: 40px;
  }

  @media only screen and (max-width: 768px) {
    .about {
      padding-right: 30px;
      padding-left: 30px;
    }

    .about__title {
      font-size: 42px;
      line-height: 1.2;
    }
  }

  @media only screen and (max-width: 425px) {
    .about {
      padding-right: 22px;
      padding-left: 22px;
    }

    .about__title {
      font-size: 34px;
      line-height: 1.2;
    }

    .about__description,
    .about__description p,
    .about__description span,
    .about__description div {
      font-size: 16px;
    }
  }
</style>