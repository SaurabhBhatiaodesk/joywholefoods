 var COUNTER = {

    {% if openTime contains ':'%}
    open: {day: '{{openDay}}', hour: {{openTime | split: ':' | first}}, min: {{openTime | split: ':' | last}}},
    {% else %}
    open: {day: '{{openDay}}', hour: {{openTime | split: ':' | first}}, min: null},
    {% endif %}

    {% if closeTime contains ':'%}
    close: {day: '{{closeDay}}', hour: {{closeTime | split: ':' | first}}, min: {{closeTime | split: ':' | last}}},
    {% else %}
    close: {day: '{{closeDay}}', hour: {{closeTime | split: ':' | first}}, min: null},
    {% endif %}

    init: function() {

      // set selector
      COUNTER.timer = $('.timer');
      COUNTER.open_text = $('.countdownText .open');
      COUNTER.close_text = $('.countdownText .close');

      // set open and close time
      COUNTER.next_open = moment().day( COUNTER.open.day ).set({hour:0, minute:0, second:0, millisecond:0}).add(COUNTER.open.hour, 'h');
      COUNTER.next_close = moment().day( COUNTER.close.day ).set({hour:0, minute:0, second:0, millisecond:0}).add(COUNTER.close.hour, 'h');

      if(COUNTER.open.min){
        COUNTER.next_open.add(COUNTER.open.min, 'm');
      }
      if(COUNTER.close.min){
        COUNTER.next_close.add(COUNTER.close.min, 'm');
      }
      console.debug(COUNTER);
      // if time < now, add 7 days
      moment().isBefore( COUNTER.next_open ) ? COUNTER.next_open : COUNTER.next_open.add(7, 'd');
      moment().isBefore( COUNTER.next_close ) ? COUNTER.next_close : COUNTER.next_close.add(7, 'd');

      // countdown.setLabels(singular, plural, last, delim, empty, formatter);
      countdown.setLabels('||||', '||||', ' and ', ' ');

      COUNTER.is_open = COUNTER.next_open.isAfter( COUNTER.next_close );
      COUNTER.is_closed = !COUNTER.is_open;

      if( COUNTER.next_open.isAfter( COUNTER.next_close ) ) {
      // is NOW OPEN
        console.log('Store is Open');
        $('.announcement-msg').text('{{ section.blocks.first.settings.text | escape }} ');
        $('.template-product .product-popup-modal__opener').hide();
        
        $('.store-is-open').show();
        $('.store-is-close').hide();

      } else {
      // is NOW CLOSE
        console.log('Store is Close');
        $('.announcement-msg').text('{{ closeMsg | escape }} ');
        $('.quantity-atc-container, .qty-atc-container').hide();
        $('.customize-box__buttons').hide();
        $('.customize-box__btn-wrapper').hide();
        $('.collection').addClass('hidden-atc');
        
        $('.store-is-open').hide();
        $('.store-is-close').show();

      }
  
      setInterval(COUNTER.update_ui, 1000);

    },

    update_ui: function() {

      if( COUNTER.next_open.isAfter( COUNTER.next_close ) ) {
      // is NOW OPEN

		var readable_val = countdown( COUNTER.next_close.toDate(), null, countdown.DAYS | countdown.HOURS | countdown.MINUTES).toString();
        /*if( readable_val.indexOf('second') === -1 ) {

          readable_val += ' and 0 second';

        }*/

      	COUNTER.timer.text( readable_val );
        COUNTER.open_text.hide();
        COUNTER.close_text.show();

      } else {
      // is NOW CLOSE

        var readable_val = countdown( COUNTER.next_open.toDate(), null, countdown.DAYS | countdown.HOURS | countdown.MINUTES).toString();

        /*if( readable_val.indexOf('second') === -1) {

          readable_val += ' and 0 second';

        }*/

      	COUNTER.timer.text( readable_val );
      	COUNTER.open_text.show();
        COUNTER.close_text.hide();

      }

    },

  };

  // on document ready
  $(COUNTER.init);
  
</script>
