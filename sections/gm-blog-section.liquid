{% assign selected_blog = section.settings.blog %}
<div class="blog_section">
    <div class="blog_section__container">
        <div class="blog_section__head">
            <div class="blog_heading-container">
            <h3 class="blog_heading">{{ section.settings.blog_heading }}</h3>
            </div>
            <div class="blog_btn-container">
                <a href="{{ section.settings.button_link }}" class="btn-non-fill" aria-label="{{ 'blogs.article.read_more_title' | t: title: article.title }}">
                    {{ section.settings.blog_button }}
                </a>
            </div>
        </div>
        <div class="article__content">
            {% if selected_blog %}
                {% for article in selected_blog.articles limit: 3 %}
                    <div class="blog_article">
                        {% if article.image %}
                            <img loading="lazy" class="blog__image" height="{{ article.image.height }}" width="{{ article.image.width }}" src="{{ article.image.src | img_url: 'master' }}" alt="{{ article.image.alt }}">
                        {% endif %}
                      <h2 class="blog__title">{{ article.title }}</h2>
                       <p class="blog__tag">{{ article.excerpt }} | {{ article.tags }}</p> 
                      <a href="{{ article.url }}" class="btn" aria-label="{{ 'blogs.article.read_more_title' | t: title: article.title }}">
                        Learn More
                      </a>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
<style>
.blog_heading {
    color: #043D22;
    font-family: 'DM Sans 9pt', serif;
    font-size: 59px;
    font-style: normal;
    font-weight: 700;
    line-height: 111.3%;
    letter-spacing: -1.77px;
    margin: 0;
}
.blog_section__head {
    max-width: 1140px;
    margin: auto;
    display: flex;
    margin-bottom: 90px;
    align-items: center;
    justify-content: space-between;
}
.btn-non-fill {
    display: flex;
    padding: 19px 39px 21px 39px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans 9pt', sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 95.3%;
    letter-spacing: -0.6px;
    border-radius: 5px;
    color: #9BB83C;
    border: 1px solid #9BB83C;
    text-decoration: none;
}
.article__content {
    display: grid;
    max-width: 1140px;
    margin: auto;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr;
    grid-column-gap: 36.5px;
    grid-row-gap: 0px;
    padding: 0;
    justify-content: space-between;
}
.blog__image {
    max-width: 355.62px;
    width: 100%;
    height: 100%;
    max-height: 280.876px;
    object-fit: cover;
    margin-bottom: 35px;
    border-radius: 10px;
}
.blog__title {
    color: #043D22;
    font-family: 'DM Sans 9pt', serif;
    font-size: 23px;
    font-style: normal;
    font-weight: 700;
    line-height: 141.3%;
    letter-spacing: -0.25px;
    margin-bottom: 35px;
}
.blog__title {
    color: #043D22;
    font-family: 'DM Sans 9pt', serif;
    font-size: 23px;
    font-style: normal;
    font-weight: 700;
    line-height: 141.3%;
    letter-spacing: -0.25px;
    margin-bottom: 35px;
}
.blog__tag {
    color: #086C3F;
    font-family: 'DM Sans 9pt', sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 145.3%;
    letter-spacing: -0.4px;
    margin-bottom: 35px !important;
}
.blog__tag {
    color: #086C3F;
    font-family: 'DM Sans 9pt', sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 145.3%;
    letter-spacing: -0.4px;
    margin-bottom: 35px !important;
}
.btn {
    transition: all 0.2s ease-in-out;
    padding: 19px 39px 19px 39px;
    border-radius: 5px;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 95.3%;
    letter-spacing: -0.6px;
    background: #9BB83C;
    color: white;
    text-decoration: none;
}
.blog_section{
    padding-left: 55px;
    padding-right: 55px;
}
.blog_section__container{
    padding: 0 120px;
}

.blog_section {
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
}
@media only screen and (max-width: 1024px) {

    .blog_section__container{
        padding: 0;
    }
    .blog_heading  {
        font-size:40px;
    }
    .blog_section__head {
        margin: auto auto 50px;
    }
    .blog__image {
        margin-bottom: 20px;
    }
    .blog__title {
        font-size: 18px;
        margin-bottom: 14px;
    }

    .blog__tag {
        font-size: 16px;
    }

}
@media only screen and (max-width: 768px) {

    .blog_section__container{
        padding: 0;
    }
    .blog_heading {
        font-size:30px;
    }
    .article__content .blog_article:last-child {
        display:none;
    }
}
@media only screen and (max-width: 425px) {
    .blog_btn-container {
        width:100%;
    }
    .blog_section__head {
        flex-direction: column;
        row-gap: 24px;
    }
    .blog__image {
        max-width:100%;
    }
    .blog_section {
        padding-left: 22px;
        padding-right: 22px;
    }
    .blog_heading {
        font-size:34px !important;
        text-align: center;
    }
    .blog_section__container{
        padding: 0;
    }
    .article__content .blog_article:last-child {
        display:block;
    }
}
@media only screen and (max-width: 375px) {

    .blog_section__container{
        padding: 0;
    }
}
@media only screen and (max-width: 320px) {

    .blog_section__container{
        padding: 0;
    }
}
</style>
{% schema %}
  {
    "name": "GM Blog section",
    "settings": [
        {
            "type": "text",
            "id": "blog_heading",
            "label": "Heading",
            "default": "Quick links"
        },      
        {
            "type": "text",
            "id": "blog_button",
            "label": "Button label",
            "default": "View more"
        },   
        {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
        },             
        {
            "type": "blog",
            "id": "blog",
            "label": "Blog"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 300,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 300,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
    {
      "name": "GM Blog section"

    }
  ]
  }
{% endschema %}