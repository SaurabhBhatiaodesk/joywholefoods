<style>
    .card-waste__container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: 1fr;
        grid-column-gap: 10px;
        grid-row-gap: 0px;
      
    }
    @media only screen and (max-width: 1240px) { 
        .card-waste__container {
            display: grid;
            grid-template-columns: repeat(2, 2fr);
            grid-template-rows: 1fr;
            grid-column-gap: 10px;
            grid-row-gap: 10px;
          
        }
        .card-waste__container .card-waste__column:nth-child(2) .card-waste__arrow {
            display: none;
        }
      
      }
      @media only screen and (max-width: 600px) { 
        .card-waste__container {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            grid-template-rows: 1fr;
            grid-column-gap: 10px;
            grid-row-gap: 10px;
          
        }
        .card-waste__container .card-waste__column .card-waste__arrow {
            display: none;
        }
    }
    .card-waste__heading {
    font-family: 'DM Sans 9pt', serif;
    font-size: 59px;
    font-style: normal;
    font-weight: 700;
    line-height: 111.3%; /* 65.667px */
    letter-spacing: -1.77px;
      margin: 0;
}
h2.card-waste__heading {
    text-align: center;
}
@media only screen and (max-width: 768px) { 
    h2.card-waste__heading {
        font-size: 40px;
    }
}
.card-waste__heading-container {
margin-bottom:85.71px;
}

{%- if template contains 'product' -%}
    @media only screen and (max-width:1024px) { 
    .page-width.card-waste {
        padding: 0px 55px 45.51px !important;
    }
      .card-waste__heading-container {
            margin-bottom: 50px;
        }
    }
    @media only screen and (max-width:425px) { 
        .page-width.card-waste {
            padding: 55px 20px 0 !important;
        }
    }
{%- endif -%}

</style>

<div class="page-width card-waste">
    <div class="card-waste__heading-container">
        <h2 class="card-waste__heading">{{ section.settings.heading }}</h2>
    </div>
    <div class="card-waste__container"> 
    {% for block in section.blocks %}
        {% if block.type == 'Card' %}
            <div class="card-waste__column"> 
                <div class="card-waste__arrow">
                    {% render 'arrow-circle'%}
                </div>
                <div class="card-waste__img-container">
                    {% if block.settings.card_image != blank %}
                        <img class="card-waste__img" src="{{ block.settings.card_image | img_url: 'master' }}"width="{{ block.settings.card_image.width }}"height="{{ block.settings.card_image.heaight }}" loading="lazy" />
                    {% endif %} 
                </div>
                <div class="card-waste__text-container">
                    <h5 class="card-waste__text">{{ block.settings.card_title }}</h5>
                </div>
                <div class="card-waste__tag-container">
                    <h5 class="card-waste__tag">{{ block.settings.tag_day }}</h5>
                </div>
                <div class="card-waste__sub_container">
                    <h5 class="card-waste__sub_heading">{{ block.settings.sub_heading }}</h5>
                </div>
            </div> 
            {% assign countBlocks = section.blocks | where: 'type', 'Card' %}
            {% assign countBlockCount = countBlocks | size %} 
            {% if countBlockCount >= block.limit %}
            {% break %}
            {% endif %}
        {% endif %}
    {% endfor %}
    </div>
</div>
{% schema %}
{
  "name": "Waste cycle",
  "class": "Waste cycle",
  "settings": [
      {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lorem ipsum"
      },
      {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#043D22"
      },         
      {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 36
      },
      {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 300,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 36
      }
  ],
  "blocks":[
    {
        "type": "Card",
        "name": "Card",
        "limit": 4 , 
        "settings": [
            {
                "type": "image_picker",
                "id": "card_image",
                "label": "Image"  
            },
            {
                "type": "text",
                "id": "card_title",
                "label": "Card title",
                "default": "Lorem ipsum"
            },
            {
                "type": "text",
                "id": "tag_day",
                "label": "Day",
                "default": "Lorem ipsum"
            }, 
            {
                "type": "text",
                "id": "sub_heading",
                "label": "Sub Heading",
                "default": "Lorem ipsum"
            }
        ]
    }
  ],
  "presets": [
    {
        "name": "Waste cycle",
        "category": "Waste cycle"
    }
  ]
}
{% endschema %}  