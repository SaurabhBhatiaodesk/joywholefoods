{% schema %}
{
  "name": "table_columns",
  "settings": [
    {
      "type": "richtext",
      "id": "table_heading",
      "label": "table_heading"
    },
    {
      "type": "richtext",
      "id": "column_heading1",
      "label": "column_heading1"
    },
    {
      "type": "richtext",
      "id": "column_heading2",
      "label": "column_heading2"
    },
    {
      "type": "richtext",
      "id": "column_heading3",
      "label": "column_heading3"
    },
     {
      "type": "richtext",
      "id": "column_heading4",
      "label": "column_heading4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  
  "blocks": [
    {
      "type": "column",
      "name": "column",
      "settings": [
        {
          "type": "richtext",
          "id": "column_data1",
          "label": "column_data1"
        },
        {
          "type": "richtext",
          "id": "column_data2",
          "label": "column_data2"
        },
        {
          "type": "richtext",
          "id": "column_data3",
          "label": "column_data3"
        },
        {
          "type": "richtext",
          "id": "column_data4",
          "label": "column_data4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "table_columns",
      "settings": {
      },
      "blocks": [
        {
          "type": "column" 
        }
      ]
    }
  ]
}
{% endschema %}

