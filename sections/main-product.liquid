  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var sectionRoot = document.getElementById('MainProduct-{{ section.id }}');
      if (!sectionRoot) return;

      var productJsonEl = sectionRoot.querySelector('#JoyPDPProductJson-{{ section.id }}');
      var productData = null;

      try {
        productData = productJsonEl ? JSON.parse(productJsonEl.textContent || '{}') : null;
      } catch (error) {
        productData = null;
      }

      if (!productData || !productData.variants || !productData.variants.length) return;

      var priceContainer = sectionRoot.querySelector('#price-{{ section.id }}');
      var stickyPrice = sectionRoot.querySelector('[data-joy-pdp-sticky-price]');
      var perKiloEl = priceContainer ? priceContainer.querySelector('.product-price-per-kilo-under-main-price-os') : null;
      var perKiloHtml = perKiloEl ? perKiloEl.outerHTML : '';
      var moneyFormat = {{ shop.money_format | json }};
      var hasOnlyDefaultVariant = {{ product.has_only_default_variant | json }};
      var defaultPriceHtml = {{ product.price_min | money | json }};
      var defaultPriceText = hasOnlyDefaultVariant ? defaultPriceHtml : 'From ' + defaultPriceHtml;
      var lastSelectedVariant = null;
      var suppressPriceObserver = false;

      function formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, moneyFormat);
        }

        var value = (Number(cents || 0) / 100).toFixed(2);

        return moneyFormat
          .replace(/\{\{\s*amount\s*\}\}/, value)
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/, String(Math.round(Number(cents || 0) / 100)))
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, value.replace('.', ','));
      }

      function getVariantById(id) {
        if (!id) return null;
        return productData.variants.find(function (variant) {
          return String(variant.id) === String(id);
        }) || null;
      }

      function getPicker() {
        return (
          sectionRoot.querySelector('#variant-selects-{{ section.id }}') ||
          sectionRoot.querySelector('#variant-radios-{{ section.id }}') ||
          sectionRoot.querySelector('variant-selects[data-section="{{ section.id }}"]') ||
          sectionRoot.querySelector('variant-radios[data-section="{{ section.id }}"]')
        );
      }

      function getSelectedVariant() {
        var picker = getPicker();

        if (!picker) {
          var directInput = sectionRoot.querySelector('.product-variant-id, input[name="id"]');
          return directInput ? getVariantById(directInput.value) : null;
        }

        if (picker.tagName && picker.tagName.toLowerCase() === 'variant-selects') {
          var selectedOptions = Array.from(picker.querySelectorAll('select')).map(function (select) {
            return select.value;
          });

          if (selectedOptions.some(function (value) { return !value; })) return null;

          return productData.variants.find(function (variant) {
            return variant.options.every(function (option, index) {
              return String(option) === String(selectedOptions[index]);
            });
          }) || null;
        }

        var fieldsets = Array.from(picker.querySelectorAll('fieldset'));
        var radioOptions = fieldsets.map(function (fieldset) {
          var checked = fieldset.querySelector('input[type="radio"]:checked');
          return checked ? checked.value : null;
        });

        return productData.variants.find(function (variant) {
          return variant.options.every(function (option, index) {
            return String(option) === String(radioOptions[index]);
          });
        }) || null;
      }

      function updatePrice(variant) {
        if (!priceContainer || !variant) return;

        lastSelectedVariant = variant;

        var priceHtml = formatMoney(variant.price);
        var compareHtml = variant.compare_at_price && variant.compare_at_price > variant.price
          ? formatMoney(variant.compare_at_price)
          : '';

        suppressPriceObserver = true;

        if (compareHtml) {
          priceContainer.innerHTML =
            '<div class="price price--large price--on-sale joy-pdp-price" data-joy-pdp-price>' +
              '<div class="price__sale">' +
                '<span class="visually-hidden">Sale price</span>' +
                '<span class="price-item price-item--sale price-item--last">' + priceHtml + '</span>' +
                '<span class="visually-hidden">Regular price</span>' +
                '<span><s class="price-item price-item--regular">' + compareHtml + '</s></span>' +
              '</div>' +
            '</div>' +
            perKiloHtml;
        } else {
          priceContainer.innerHTML =
            '<div class="price price--large joy-pdp-price" data-joy-pdp-price>' +
              '<div class="price__regular">' +
                '<span class="price-item price-item--regular">' + priceHtml + '</span>' +
              '</div>' +
            '</div>' +
            perKiloHtml;
        }

        if (stickyPrice) stickyPrice.textContent = priceHtml;

        setTimeout(function () {
          suppressPriceObserver = false;
        }, 0);
      }

      function updateDefaultPrice() {
        if (!priceContainer) return;

        lastSelectedVariant = null;
        suppressPriceObserver = true;

        priceContainer.innerHTML =
          '<div class="price price--large joy-pdp-price" data-joy-pdp-price>' +
            '<div class="price__regular">' +
              '<span class="price-item price-item--regular">' + defaultPriceText + '</span>' +
            '</div>' +
          '</div>' +
          perKiloHtml;

        if (stickyPrice) stickyPrice.textContent = defaultPriceText;

        setTimeout(function () {
          suppressPriceObserver = false;
        }, 0);
      }

      function updateForms(variant) {
        if (!variant) return;

        sectionRoot.querySelectorAll('form[action*="/cart/add"], .custom-direct-cart-form').forEach(function (form) {
          var input = form.querySelector('input[name="id"], .product-variant-id');
          if (input) {
            input.value = variant.id;
            input.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });

        sectionRoot.querySelectorAll('pickup-availability').forEach(function (pickup) {
          pickup.setAttribute('data-variant-id', variant.id);
          if (variant.available) pickup.setAttribute('available', '');
          else pickup.removeAttribute('available');
        });
      }

      function triggerExistingNotifyPopup(variant) {
        var openers = Array.from(sectionRoot.querySelectorAll('modal-opener[data-modal^="#PopupModal"], .product-popup-modal__opener'));
        var openerToClick = openers.find(function (opener) {
          var text = (opener.textContent || '').toLowerCase();
          var modalSelector = opener.getAttribute('data-modal');
          var modal = modalSelector ? document.querySelector(modalSelector) : null;
          var modalText = modal ? (modal.textContent || '').toLowerCase() : '';

          return (
            text.indexOf('notify') !== -1 ||
            text.indexOf('newsletter') !== -1 ||
            text.indexOf('back in stock') !== -1 ||
            modalText.indexOf('newsletter') !== -1 ||
            modalText.indexOf('let you know') !== -1
          );
        }) || openers[0] || null;

        if (openerToClick) {
          var buttonInside = openerToClick.querySelector('button, a') || openerToClick;
          buttonInside.click();
          return true;
        }

        document.dispatchEvent(new CustomEvent('joy:notify-me:open', {
          detail: {
            productId: {{ product.id | json }},
            variantId: variant && variant.id ? variant.id : null
          }
        }));

        return false;
      }

      function getSelectPlaceholderText(select) {
        var labelText = '';
        var wrapper = select.closest('.product-form__input, fieldset');
        if (wrapper) {
          var label = wrapper.querySelector('.form__label, label, legend');
          if (label) labelText = label.textContent || '';
        }

        labelText = labelText.replace(':', '').replace(/\s+/g, ' ').trim().toLowerCase();
        if (!labelText) labelText = 'option';

        return 'Select ' + labelText;
      }

      function prepareSelectPlaceholders(shouldSelectPlaceholder) {
        var picker = getPicker();
        if (!picker || !picker.tagName || picker.tagName.toLowerCase() !== 'variant-selects') return;

        Array.from(picker.querySelectorAll('select')).forEach(function (select) {
          var placeholder = Array.from(select.options).find(function (option) {
            return option.value === '';
          });

          if (!placeholder) {
            placeholder = document.createElement('option');
            placeholder.value = '';
            select.insertBefore(placeholder, select.firstChild);
          }

          placeholder.textContent = getSelectPlaceholderText(select);
          placeholder.disabled = true;
          placeholder.hidden = false;

          if (shouldSelectPlaceholder) {
            select.value = '';
            select.classList.add('joy-pdp-select-placeholder-active');
          } else {
            select.classList.toggle('joy-pdp-select-placeholder-active', !select.value);
          }
        });
      }

      function syncPlaceholderClass() {
        var picker = getPicker();
        if (!picker || !picker.tagName || picker.tagName.toLowerCase() !== 'variant-selects') return;

        Array.from(picker.querySelectorAll('select')).forEach(function (select) {
          select.classList.toggle('joy-pdp-select-placeholder-active', !select.value);
        });
      }

      function syncFromCurrentSelection() {
        syncPlaceholderClass();
        var variant = getSelectedVariant();

        if (!variant) {
          updateDefaultPrice();
          return null;
        }

        updatePrice(variant);
        updateForms(variant);
        return variant;
      }

      function selectVariantFromUrl() {
        var params = new URLSearchParams(window.location.search);
        var variantId = params.get('variant');
        if (!variantId) return null;

        var variant = getVariantById(variantId);
        var picker = getPicker();

        if (!variant || !picker) return variant;

        picker.querySelectorAll('option[disabled]').forEach(function (option) {
          if (option.value !== '') option.disabled = false;
        });

        if (picker.tagName && picker.tagName.toLowerCase() === 'variant-selects') {
          Array.from(picker.querySelectorAll('select')).forEach(function (select, index) {
            if (variant.options[index] !== undefined) {
              select.value = variant.options[index];
              select.classList.toggle('joy-pdp-select-placeholder-active', !select.value);
              select.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        } else {
          variant.options.forEach(function (optionValue, index) {
            var fieldset = picker.querySelectorAll('fieldset')[index];
            if (!fieldset) return;

            var radio = Array.from(fieldset.querySelectorAll('input[type="radio"]')).find(function (input) {
              return String(input.value) === String(optionValue);
            });

            if (radio) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        }

        updatePrice(variant);
        updateForms(variant);
        return variant;
      }

      var picker = getPicker();
      var paramsForInitialVariant = new URLSearchParams(window.location.search);
      var shouldUsePlaceholderOnLoad = !paramsForInitialVariant.get('variant') && !productData.has_only_default_variant;

      prepareSelectPlaceholders(shouldUsePlaceholderOnLoad);

      if (picker) {
        picker.querySelectorAll('option[disabled]').forEach(function (option) {
          if (option.value !== '') option.disabled = false;
        });

        picker.addEventListener('change', function () {
          window.requestAnimationFrame(function () {
            syncPlaceholderClass();
            syncFromCurrentSelection();

            setTimeout(syncFromCurrentSelection, 80);
            setTimeout(syncFromCurrentSelection, 250);
            setTimeout(syncFromCurrentSelection, 600);
            setTimeout(syncFromCurrentSelection, 1200);
          });
        });
      }

      if (priceContainer && window.MutationObserver) {
        new MutationObserver(function () {
          if (suppressPriceObserver) return;

          if (lastSelectedVariant) {
            updatePrice(lastSelectedVariant);
          } else {
            syncFromCurrentSelection();
          }
        }).observe(priceContainer, { childList: true, subtree: true, characterData: true });
      }

      var selectedFromUrl = selectVariantFromUrl();
      var selectedNow = selectedFromUrl || (hasOnlyDefaultVariant ? syncFromCurrentSelection() : null);

      if (selectedNow) {
        setTimeout(function () {
          updatePrice(selectedNow);
          updateForms(selectedNow);

          var params = new URLSearchParams(window.location.search);
          if (params.get('notify') === 'true' && selectedNow.available === false) {
            triggerExistingNotifyPopup(selectedNow);
          }
        }, 350);
      }
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function isIE() {
        const ua = window.navigator.userAgent;
        const msie = ua.indexOf('MSIE ');
        const trident = ua.indexOf('Trident/');

        return msie > 0 || trident > 0;
      }

      if (!isIE()) return;
      const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id" data-productid="{{ product.id }}"]');
      const noScriptInputWrapper = document.createElement('div');
      const variantSwitcher =
        document.querySelector('variant-radios[data-section="{{ section.id }}"]') ||
        document.querySelector('variant-selects[data-section="{{ section.id }}"]');
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }}'
      ).textContent;
      variantSwitcher.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    });
  </script>



