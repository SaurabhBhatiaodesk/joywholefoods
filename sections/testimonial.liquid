      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#9bb83c"
    },
    {
      "type": "color",
