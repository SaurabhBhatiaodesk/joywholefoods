<div class="image-banner-with-list-wrapper"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | img_url: 'master'}}')"{% endif %}>
  <div class="image-banner-with-list featured-container">
    <div class="feature-image">
      <img src="{{ section.settings.image | img_url: 'master'}}" alt="{{ section.settings.image.alt }}" />
    </div>

    <div class="image-banner-with-list__item image-banner-with-list__text">
      {% if section.settings.title != blank %}
        <h2 class="featured__heading-title">{{ section.settings.title | escape }}</h2>
      {% endif %}

      <div class="rte rte-setting featured-row__subtext">
        {%- comment -%} Render ONLY list blocks first {%- endcomment -%}
        {% for block in section.blocks %}
          {% if block.type == 'List' %}
            <div class="list__column" {{ block.shopify_attributes }}>
              <div class="list-icon">
                {% render 'icon-check' %}
              </div>
              <div class="list-content">
                <h3 class="list__title">{{ block.settings.list_title }}</h3>
                <p class="list_description">{{ block.settings.list_description }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {%- comment -%} Then render the button block AFTER the list {%- endcomment -%}
        {% assign button_blocks = section.blocks | where: 'type', 'button' %}
        {% if button_blocks.size > 0 %}
          {% assign btn = button_blocks.first %}
          {% if btn.settings.button_label != blank and btn.settings.button_link != blank %}
            <div class="button-wrapper" {{ btn.shopify_attributes }}>
              <a href="{{ btn.settings.button_link }}" class="button button--primary">
                {{ btn.settings.button_label }}
              </a>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .image-banner-with-list .button-wrapper { margin-top: 1.5rem; }
  .image-banner-with-list .button-wrapper .button {
  color: #fff !important; 
}
</style>



{% schema %}
{
  "name": "Image banner with list",
  "class": "index-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Title"
    }
  ],
  "blocks": [
    {
      "type": "List",
      "name": "List",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "list_title",
          "label": "List title"
        },
        {
          "type": "text",
          "id": "list_description",
          "label": "List description"
        }
      ]
    },
    {
      "type": "button",
      "name": "Shop Now button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner with list",
      "blocks": [
        {
          "type": "List"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
