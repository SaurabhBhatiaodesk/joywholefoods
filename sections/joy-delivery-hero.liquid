@media(max-width:749px){#joy-delivery-{{ section.id }} .jd-result-card{padding:17px}}
</style>

<script>
(function(){
  const root=document.getElementById('joy-delivery-{{ section.id }}');
  if (!root || root.dataset.jdInitialized === 'true') return;
  root.dataset.jdInitialized='true';
  const form=root.querySelector('[data-postcode-form]');
  const input=form.querySelector('[name="postcode"]');
  const feedback=root.querySelector('[data-postcode-feedback]');
  const results=root.querySelector('[data-postcode-results]');
  const matched=root.querySelector('[data-result-match]');
  const fallback=root.querySelector('[data-result-fallback]');
  const toowoomba=root.querySelector('[data-result-toowoomba]');
  const areas=Array.from(root.querySelectorAll('[data-postcode-area]'));
  function reset(){
    feedback.hidden=true; feedback.textContent='';
    results.hidden=true; matched.hidden=true; fallback.hidden=true; toowoomba.hidden=true;
    input.setCustomValidity('');input.removeAttribute('aria-invalid');
  }
  input.addEventListener('input',reset);
  form.addEventListener('submit',function(event){
    event.preventDefault();
    const code=input.value.trim();
    reset();
    if (!/^\d{4}$/.test(code)) {
      input.setCustomValidity('Please enter a valid 4-digit Australian postcode.');
      input.setAttribute('aria-invalid','true');
      input.reportValidity();
      feedback.textContent='Please enter a valid four-digit postcode.';
      feedback.hidden=false;
      return;
    }
    const area=areas.find(function(el){
      return (el.dataset.codes || '').split(/[,;\s]+/).some(function(token){return token.trim()===code});
    });
    results.hidden=false;
    if(area){
      matched.hidden=false;
      matched.querySelector('[data-result-heading]').textContent=area.dataset.name || 'Delivery options';
      matched.querySelector('[data-result-postcodes]').textContent='Postcodes: '+area.dataset.codes;
      const message=area.querySelector('[data-area-description]');
      matched.querySelector('[data-result-message]').innerHTML=message ? message.innerHTML : '';
    }else{
      fallback.hidden=false;
    }
  });
})();
</script>
