{% comment %} Standalone Shopify section — Joy delivery hero {% endcomment %}
<section id="joy-delivery-{{ section.id }}" class="joy-delivery" style="--jd-green:{{ section.settings.green }};--jd-lime:{{ section.settings.lime }};--jd-cream:{{ section.settings.cream }};--jd-text:{{ section.settings.text_color }};--jd-bg:{{ section.settings.bg_color }};--jd-top:{{ section.settings.padding_top }}px;--jd-bottom:{{ section.settings.padding_bottom }}px">
<div class="jd-container">
    <header class="jd-hero">
      <h1>{{ section.settings.hero_title | escape }}</h1>
      <p>{{ section.settings.hero_text | escape | newline_to_br }}</p>
      <form class="jd-postcode" data-postcode-form>
        <label class="jd-visually-hidden" for="jd-postcode-{{ section.id }}">Enter your postcode</label>
        <span aria-hidden="true" class="jd-pin">⌖</span>
        <input id="jd-postcode-{{ section.id }}" name="postcode" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="Enter your postcode" required>
        <button type="submit">{{ section.settings.postcode_button | escape }} <span aria-hidden="true">→</span></button>
      </form>
      <p class="jd-check-feedback" data-postcode-feedback role="status" aria-live="polite" hidden></p>
      <div class="jd-postcode-results" data-postcode-results hidden aria-live="polite">
        <div class="jd-result-card" data-result-match hidden>
          <h2 data-result-heading></h2>
          <p class="jd-result-postcodes" data-result-postcodes></p>
          <div class="jd-result-message" data-result-message></div>
        </div>
        <div class="jd-result-card" data-result-fallback hidden>
          <h2>{{ section.settings.pickupLabel | escape }}</h2>
          <p class="jd-fallback-warning">{{ section.settings.pickupMessage }}</p>
          <div class="jd-result-message">{{ section.settings.pickupText }}</div>
        </div>
        <div class="jd-result-card" data-result-toowoomba hidden>
          <h2>Toowoomba &amp; surrounds</h2>
          <p class="jd-result-postcodes">Postcodes: 4350, 4358</p>
          <div class="jd-result-message"><p><strong>Monday / Wednesday / Friday delivery</strong></p><p>Your next delivery date is Monday.</p><p>Order by midnight for Monday, Wednesday or Friday. $50 minimum order. (Select your delivery day)</p><p><strong>FREE DELIVERY</strong></p><p>*Some 4352 suburbs including Cabarlah, Geham, Merrits Creek, Hampton and Pechey have a $5 delivery fee.</p><p>*Exclusions include Postmans Ridge and Murphys Creek.</p></div>
        </div>
      </div>
      <div data-postcode-data hidden>
        {% for block in section.blocks %}
          {% if block.type == 'postcode' and block.settings.postcodes != blank %}
            <div data-postcode-area data-codes="{{ block.settings.postcodes | escape }}" data-name="{{ block.settings.locationName | escape }}" {{ block.shopify_attributes }}>
              <div data-area-description>{% assign current_date = 'now' | date: '%d/%m/%Y' %}{{ block.settings.postcodeText | replace: '[date]', current_date }}</div>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    </header>


</div>
</section>
<style>

