/* Postcode results use the existing Joy hero visual language */
#joy-delivery-{{ section.id }} .jd-postcode-results{max-width:740px;margin:20px auto 0;text-align:left}
#joy-delivery-{{ section.id }} .jd-result-card{background:var(--jd-cream);border:1px solid #dfe3e0;border-radius:12px;padding:20px 24px}
#joy-delivery-{{ section.id }} .jd-result-card h2{font-size:clamp(22px,2.3vw,29px);margin:0 0 6px}
#joy-delivery-{{ section.id }} .jd-result-postcodes{font-size:13px;color:#516157;margin:0 0 13px}
#joy-delivery-{{ section.id }} .jd-result-message{font-size:15px;line-height:1.65;color:var(--jd-text)}
