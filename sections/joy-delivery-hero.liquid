#joy-delivery-{{ section.id }} .jd-interest>a,#joy-delivery-{{ section.id }} .jd-outline{border:1px solid var(--jd-green);border-radius:11px;text-decoration:none;padding:12px 22px;font-weight:750;text-align:center;font-size:14px}
