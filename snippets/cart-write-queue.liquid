{% doc %}
  Serializes theme and app cart requests, allowing an app's read/write continuation
  to finish before a waiting theme mutation. Render before app scripts.
{% enddoc %}
<script>
  (function () {
    if (window.__joyCartWriteQueue) return;
    window.__joyCartWriteQueue = true;
    var originalFetch = window.fetch;
    var transportQueue = Promise.resolve();
    var themeQueue = Promise.resolve();
    var storeDomain = {{ shop.permanent_domain | json }};
    var themeWritesPending = 0;
    var appInFlight = 0;
    var appQuietAt = 0;
    var APP_QUIET_MS = 1500;

    function requestKind(input, options) {
      try {
        var url = new URL(typeof input === 'string' || input instanceof URL ? input : input.url, location.href);
        if (url.origin !== location.origin && url.hostname !== storeDomain) return '';
        var method = String((options && options.method) || input.method || 'GET').toUpperCase();
        if (method === 'GET' || method === 'HEAD') return '';
        if (/\/cart\/(?:add|change|update|clear)(?:\.js|\.json)?\/?$/.test(url.pathname)) return 'theme';
        if (!/\/api\/[^/]+\/graphql\.json$/.test(url.pathname)) return '';
        var body = options && options.body;
        var query = typeof body === 'string' ? JSON.parse(body).query : '';
        if (/\bmutation\b/.test(query || '') && /\bcart[A-Z]\w*\s*\(/.test(query || '')) return 'app-write';
        if (!/\bmutation\b/.test(query || '') && /\bcart\s*\(/.test(query || '')) return 'app-read';
      } catch (_) {}
      return '';
    }

    function enqueueTransport(run) {
      var job = transportQueue.then(run);
      transportQueue = job.then(function () {}, function () {});
      return job;
    }

    function appBusy() {
      return appInFlight > 0 || Date.now() < appQuietAt;
    }

    function waitForApp() {
      return new Promise(function (resolve) {
        (function check() {
          if (!appBusy()) return resolve();
          window.setTimeout(check, 100);
        })();
      });
    }

    function runAppRequest(receiver, args, read) {
      // Only cart reads start a continuation window. An app write following such a
      // read extends it, but unrelated GraphQL queries never hold up Add to cart.
      var continuation = read || appBusy();
      appInFlight += 1;
      function finished() {
        appInFlight -= 1;
        if (continuation) appQuietAt = Date.now() + APP_QUIET_MS;
      }
      return Promise.resolve().then(function () {
        return originalFetch.apply(receiver, args);
      }).then(function (response) {
        // fetch resolves at response headers. On a slow connection the app may
        // still be downloading its cart, so don't start the grace period yet.
        // Observe a clone without consuming or replacing the caller's response.
        if (read && response && typeof response.clone === 'function') {
          try {
            var copy = response.clone();
            if (typeof copy.arrayBuffer === 'function') {
              Promise.resolve(copy.arrayBuffer()).then(finished, finished);
              return response;
            }
          } catch (_) {}
        }
        finished();
        return response;
      }, function (error) {
        finished();
        throw error;
      });
    }

    window.fetch = function (input, options) {
      var kind = requestKind(input, options);
      if (!kind) return originalFetch.apply(this, arguments);
      var receiver = this;
      var args = arguments;

      if (kind === 'theme') {
        themeWritesPending += 1;
        // Waiting must stay OUTSIDE the transport queue: an app continuation
        // needs that transport to finish before this theme request can proceed.
        var job = themeQueue.then(waitForApp).then(function () {
          return enqueueTransport(function () { return originalFetch.apply(receiver, args); });
        });
        themeQueue = job.then(function () {}, function () {});
        job.then(function () { themeWritesPending -= 1; }, function () { themeWritesPending -= 1; });
        return job;
      }

      if (themeWritesPending > 0 && (kind === 'app-read' || !appBusy())) {
        // A new read (or a write outside an active read/write burst) waits for
        // pending theme changes. Background reads cannot extend the old window.
        return themeQueue.then(function () {
          return enqueueTransport(function () { return runAppRequest(receiver, args, kind === 'app-read'); });
        });
      }

      return enqueueTransport(function () {
        return runAppRequest(receiver, args, kind === 'app-read');
      });
    };
  })();
</script>
