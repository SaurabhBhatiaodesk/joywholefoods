<script>
  (function () {
    if (new URLSearchParams(location.search).get('joy_cart_debug') !== '1') return;
    if (window.__joyCartRequestDebug) return;
    window.__joyCartRequestDebug = true;
    var sequence = 0;

    function cartPath(value) {
      try {
        var url = new URL(value, location.href);
        return url.origin === location.origin && /\/cart(?:\/(?:add|change|update|clear))?(?:\.js|\.json)?\/?$/.test(url.pathname)
          ? url.pathname : null;
      } catch (_) { return null; }
    }

    function start(method, path, transport) {
      var id = ++sequence;
      // Exclude request bodies, query strings, headers, cart tokens and customer data.
      console.info('[Joy transport]', JSON.stringify({ id: id, method: method,
        path: path, transport: transport, stage: 'start', caller: (new Error().stack || '')
          .split('\n').slice(2, 7).join('\n').replace(/\?[^)\s]*/g, '') }));
      return id;
    }

    var originalFetch = window.fetch;
    window.fetch = function (input, options) {
      var path = cartPath(typeof input === 'string' || input instanceof URL ? input : input.url);
      if (!path) return originalFetch.apply(this, arguments);
      var id = start((options && options.method) || input.method || 'GET', path, 'fetch');
      return originalFetch.apply(this, arguments).then(function (response) {
        console.info('[Joy transport]', JSON.stringify({ id: id, stage: 'end', status: response.status }));
        return response;
      }, function (error) {
        console.info('[Joy transport]', JSON.stringify({ id: id, stage: 'error' }));
        throw error;
      });
    };

    var originalOpen = XMLHttpRequest.prototype.open;
    var originalSend = XMLHttpRequest.prototype.send;
    var requests = new WeakMap();
    XMLHttpRequest.prototype.open = function (method, url) {
      requests.set(this, { method: method, path: cartPath(url) });
      return originalOpen.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function () {
      var request = requests.get(this);
      if (request && request.path) {
        var id = start(request.method, request.path, 'xhr');
        this.addEventListener('loadend', function () {
          console.info('[Joy transport]', JSON.stringify({ id: id, stage: 'end', status: this.status }));
        }, { once: true });
      }
      return originalSend.apply(this, arguments);
    };
  })();
</script>
