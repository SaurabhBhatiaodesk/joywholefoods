{%- comment -%}
  The scripts below are page-wide (they bind to every card on the page), so they only need to be
  output once. Collection grids pass skip_styles: true for every card after the first one.
  Other callers don't pass it, so they still output the scripts exactly as before.
{%- endcomment -%}
{%- unless skip_styles -%}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".gift-purchase").forEach((button) => {
      button.addEventListener("click", function (e) {
        e.preventDefault();
  
        if (button.classList.contains("loading")) return;
        button.classList.add("loading");
        button.disabled = true;
  
        const form = button.closest("form");
        if (!form) return;
  
        const formData = new FormData(form);
  
        fetch("/cart/add.js", {
          method: "POST",
          body: formData,
          headers: {
            "X-Requested-With": "XMLHttpRequest",
          },
        })
          .then((res) => {
            if (!res.ok) throw new Error("Add to cart failed");
            return res.json();
          })
          .then(() => {
            // ✅ Find the notification wrapper related to this button
            const productItem = button.closest("li");
            const notification = productItem?.querySelector(".custom-notification-wrapper");
            if (notification) {
              notification.classList.add("active");
            }
  
            // Redirect after short delay
            setTimeout(() => {
              button.disabled = false;
              window.location.href = "/collections/all";
            }, 1500);
          })
          .catch((err) => {
            console.error("Error:", err);
          })
          .finally(() => {
            button.classList.remove("loading");
          });
      });
    });
    
  });
</script>



