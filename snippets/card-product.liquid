  }

  .card-wrapper-os--homepage .joy-card-quantity-input-os {
    display: none !important;
  }

  .card-wrapper-os--homepage .joy-card-quantity-button-os:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media screen and (max-width: 749px) {
    .card-wrapper-os--homepage .quantity-selector-and-buyNow-wrapper-os,
    .card-wrapper-os--homepage .custom-addToCart-os,
    .card-wrapper-os--homepage .restocking-soon-product-os {
      width: calc(100% - 20px);
    }

    .card-wrapper-os--homepage .joy-card-quantity-control-os {
      grid-template-columns: 38px minmax(0, 1fr) 38px;
      height: 44px;
      min-height: 44px;
      display: flex !important;display: flex !important;
    }

    .card-wrapper-os--homepage .joy-card-quantity-button-os {
    width: 28px;
    min-width: 26px;
    height: 36px;
    }

    .card-wrapper-os--homepage .joy-card-quantity-value-os {
      gap: 3px;
      padding: 0 2px;
      font-size: 13px;
      line-height: 1.1;
      overflow: visible;
    font-size: 11px !important;
    }
