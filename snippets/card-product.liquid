<script>
  document.addEventListener("DOMContentLoaded", function () {
    const defaultAddToCartButton = document.querySelectorAll(".custom-default-addToCart-button-os");

    defaultAddToCartButton.forEach((button) => {
      button.addEventListener("click", function (e) {
        e.preventDefault();
    
        // Check if the button is already in a loading state
        if (button.classList.contains("loading")) {
          // console.log("Button is already loading, returning.");
          return;
        }
    
        button.classList.add("loading"); // Add loading class to show the process
        button.disabled = true; // Disable the button to prevent multiple clicks
    
        const form = button.closest("form");
        if (!form) {
          console.log("No form found, returning.");
          return;
        }
    
        const formData = new FormData(form);
        console.log("Form Data:", formData);
    
        // Add item to cart
        fetch("/cart/add.js", {
          method: "POST",
          body: formData,
          headers: {
            "X-Requested-With": "XMLHttpRequest",
          },
        })
          .then((res) => {
            // console.log("Response from /cart/add.js:", res);
            if (!res.ok) throw new Error("Add to cart failed");
            return res.json();
          })
          .then(() => {
            console.log("Fetching updated cart data...");
            return fetch('/cart.js');
          })
          .then((res) => res.json())
          .then((cart) => {
            // console.log("Cart data:", cart);
    
            // Update the cart item count in the header
            const cartCount = document.querySelector('.cart-count-bubble span');
            if (cartCount) {
              // console.log("Updating cart count:", cart.item_count);
              cartCount.textContent = cart.item_count; // Update the cart count bubble
            } else {
              console.log("No cart count element found.");
            }
    
            // Optional: Reset the button text after 2 seconds and enable it
            setTimeout(() => {
              // ✅ Find the notification wrapper related to this button
              const productItem = button.closest("li");
              const notification = productItem?.querySelector(".custom-notification-wrapper");
              if (notification) {
                notification.classList.add("active");
              }
              button.disabled = false;
              // alert("Product added to cart and didn't route");
            }, 1000);
          })
          .catch((err) => {
            console.error("Error:", err);
            button.textContent = 'Error';
            button.disabled = false; // Re-enable the button in case of an error
          })
          .finally(() => {
            button.classList.remove("loading"); // Remove loading class
            // console.log("Loading class removed, process complete.");
          });
      });
    });
    
  });
</script>
