<script>
  (function () {
    if (window.__joyCollectionKlaviyoNotifyInitialized) return;
    window.__joyCollectionKlaviyoNotifyInitialized = true;

    const KLAVIYO_FORM_ID = "SFmN7g";

    function removeOldNotifyOverlay() {
      document.querySelectorAll("[data-joy-pdp-notify-overlay], .joy-pdp-notify-overlay").forEach(function (overlay) {
        overlay.remove();
      });

      document.body.classList.remove("joy-pdp-notify-overlay-open");
    }

    function openKlaviyoForm(card) {
      removeOldNotifyOverlay();

      /*
       * Prefer Klaviyo's own Back in Stock trigger because it keeps
       * the correct product/variant context for the notification request.
       */
      const klaviyoTrigger = card ? card.querySelector(".klaviyo-bis-trigger") : null;

      if (klaviyoTrigger) {
        klaviyoTrigger.click();
        return;
      }

      /*
       * Fallback: directly open the live Klaviyo form if its injected
       * Back in Stock trigger has not loaded yet.
       */
      window._klOnsite = window._klOnsite || [];
      window._klOnsite.push(["openForm", KLAVIYO_FORM_ID]);
    }

    function syncNotifyLabels(root) {
      const scope = root || document;

      scope.querySelectorAll(".custom-addToCart-os").forEach(function (wrapper) {
        const button = wrapper.querySelector(".custom-add-to-cart-btn-os");
        if (!button) return;

        const available = wrapper.dataset.available === "true";

        button.textContent = available
          ? (button.dataset.addLabel || "Add to cart")
          : (button.dataset.notifyLabel || "Get notified");

        button.classList.toggle("is-notify", !available);
        button.disabled = false;
      });
    }

    /*
     * Window capture runs before the old document-level collection listener.
     * This prevents the "Loading notification form..." iframe from opening.
     */
    window.addEventListener("click", function (event) {
      const button = event.target.closest(".custom-add-to-cart-btn-os");
      if (!button) return;

      const wrapper = button.closest(".custom-addToCart-os");
      if (!wrapper || wrapper.dataset.available === "true") return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      const card = button.closest(".card-wrapper-os") || button.closest(".grid__item");

      openKlaviyoForm(card);
    }, true);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", function () {
        syncNotifyLabels(document);
        removeOldNotifyOverlay();
      }, { once: true });
    } else {
      syncNotifyLabels(document);
      removeOldNotifyOverlay();
    }
  })();
</script>


<script>
  (function () {
    if (window.__joyIsolatedCollectionQuantityInitialized) return;
    window.__joyIsolatedCollectionQuantityInitialized = true;

    var CONTROL_SELECTOR = '[data-joy-card-quantity-control]';
    var MINUS_SELECTOR = '[data-joy-card-quantity-minus]';
    var PLUS_SELECTOR = '[data-joy-card-quantity-plus]';
    var INPUT_SELECTOR = '[data-joy-card-quantity-input]';
    var LABEL_SELECTOR = '[data-joy-card-quantity-label]';
    var UNIT_SELECTOR = '[data-joy-card-quantity-unit]';
    var states = new WeakMap();
    var latestCart = null;
    var cartRequest = null;
    // Bumped every time an add/change request finishes. A /cart.js read that started
    // before a change finished may return the old cart, so it must not overwrite it.
    var cartChangeCount = 0;
    // Cart writes from all cards run one at a time. Shopify can lose an update when two
    // cart/add or cart/change requests overlap (one overwrites the other's quantity).
    var cartQueue = Promise.resolve();
    var cartWritesInFlight = 0;
    var lastCartWriteAt = 0;
    var gridObserver = null;

    function number(value, fallback) {
      var parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : fallback;
    }

    function getCard(control) {
      return control ? (control.closest('.card-wrapper-os') || control.closest('.grid__item')) : null;
    }

    function getQuantityWrapper(control) {
      return control ? control.closest('.quantity-selector-and-buyNow-wrapper-os') : null;
    }

    function getAddWrapper(control) {
      var card = getCard(control);
      return card ? card.querySelector('.custom-addToCart-os') : null;
    }

    function getCurrentVariantId(control) {
      var addWrapper = getAddWrapper(control);
      var variantId = addWrapper && addWrapper.dataset.variantId
        ? addWrapper.dataset.variantId
        : control.dataset.initialVariantId;

      return number(variantId, 0);
    }

    function getVariantData(control, variantId) {
      var item = control.closest('li');
      var script = item ? item.querySelector('[data-joy-card-variant-data]') : null;
      var parsed = null;

      if (script) {
        try {
          parsed = JSON.parse(script.textContent || '{}');
        } catch (error) {
          parsed = null;
        }
      }

      if (parsed && Array.isArray(parsed.variants)) {
        var variant = parsed.variants.find(function (entry) {
          return Number(entry.id) === Number(variantId);
        });

        if (variant) return variant;
      }

      return {
        id: variantId,
        inventoryQuantity: number(control.dataset.initialInventoryQuantity, 1000000),
        max: control.dataset.initialRuleMax === '' ? null : number(control.dataset.initialRuleMax, null),
        step: number(control.dataset.initialStep, 1),
        cartQuantity: number(control.dataset.initialCartQuantity, 0)
      };
    }

    function getState(control) {
      var state = states.get(control);

      if (!state) {
        state = {
          desired: null,
          confirmed: 0,
          pending: false,
          running: false,
          timer: null,
          version: 0,
          variantId: getCurrentVariantId(control)
        };
        states.set(control, state);
      }

      return state;
    }

    function getInput(control) {
      return control.querySelector(INPUT_SELECTOR);
    }

    function getDisplayedQuantity(control) {
      var input = getInput(control);
      return Math.max(0, number(input ? input.value : 0, 0));
    }

    function getMax(control, variantId) {
      var variant = getVariantData(control, variantId);
      var inventory = number(variant.inventoryQuantity, 1000000);
      var ruleMax = variant.max === null || variant.max === '' || typeof variant.max === 'undefined'
        ? Infinity
        : number(variant.max, Infinity);
      var inventoryMax = inventory > 0 && inventory < 1000000 ? inventory : Infinity;

      return Math.min(ruleMax, inventoryMax);
    }

    function getStep(control, variantId) {
      var variant = getVariantData(control, variantId);
      return Math.max(1, number(variant.step, 1));
    }

    function render(control, quantity) {
      var safeQuantity = Math.max(0, number(quantity, 0));
      var input = getInput(control);
      var label = control.querySelector(LABEL_SELECTOR);
      var count = label ? label.querySelector('span') : null;
      var unit = control.querySelector(UNIT_SELECTOR);
      var minus = control.querySelector(MINUS_SELECTOR);
      var plus = control.querySelector(PLUS_SELECTOR);
      var variantId = getCurrentVariantId(control);
      var max = getMax(control, variantId);

      if (input) input.value = String(safeQuantity);
      if (count) count.textContent = String(safeQuantity);
      if (unit) unit.textContent = safeQuantity === 1 ? 'item' : 'items';

      if (minus) {
        minus.disabled = safeQuantity <= 0;
        minus.classList.toggle('disabled', minus.disabled);
      }

      if (plus) {
        plus.disabled = Number.isFinite(max) && safeQuantity >= max;
        plus.classList.toggle('disabled', plus.disabled);
      }

      // These text updates are our own; don't let the grid observer treat them as new
      // cards and re-read the cart (that caused a /cart.js request loop several times a second).
      if (gridObserver) gridObserver.takeRecords();
    }

    function setControlVisibility(control, quantity) {
      var quantityWrapper = getQuantityWrapper(control);
      var addWrapper = getAddWrapper(control);
      var hasQuantity = Number(quantity) > 0;

      if (quantityWrapper) {
        quantityWrapper.classList.toggle('active', hasQuantity);
        quantityWrapper.setAttribute('aria-hidden', hasQuantity ? 'false' : 'true');
      }

      if (addWrapper) {
        addWrapper.classList.toggle('active', !hasQuantity);
        addWrapper.setAttribute('aria-hidden', hasQuantity ? 'true' : 'false');
      }
    }

    function updateCartBubble(cart) {
      if (!cart) return;

      var cartIcon = document.getElementById('cart-icon-bubble');
      if (!cartIcon) return;

      var count = number(cart.item_count, 0);
      var bubble = cartIcon.querySelector('.cart-count-bubble');

      if (count <= 0) {
        if (bubble) bubble.remove();
        return;
      }

      if (!bubble) {
        bubble = document.createElement('div');
        bubble.className = 'cart-count-bubble';
        bubble.innerHTML = '<span aria-hidden="true"></span><span class="visually-hidden"></span>';
        cartIcon.appendChild(bubble);
      }

      var visible = bubble.querySelector('span[aria-hidden="true"]') || bubble.querySelector('span');
      var hidden = bubble.querySelector('.visually-hidden');

      if (visible) visible.textContent = count < 100 ? String(count) : '';
      if (hidden) hidden.textContent = count + ' item' + (count === 1 ? '' : 's');
      bubble.style.display = '';
    }

    function setLatestCart(cart, dispatchEvents) {
      latestCart = cart;
      updateCartBubble(cart);

      if (dispatchEvents) {
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: { cart: cart, source: 'joy-isolated-card-quantity' }
        }));
        document.dispatchEvent(new CustomEvent('cart:refresh', {
          detail: { cart: cart, source: 'joy-isolated-card-quantity' }
        }));
      }

      return cart;
    }

    function fetchCart(force) {
      if (!force && latestCart) return Promise.resolve(latestCart);
      if (!force && cartRequest) return cartRequest;

      var changeCountAtStart = cartChangeCount;
      var request = fetch('/cart.js', {
        method: 'GET',
        headers: { Accept: 'application/json' }
      })
        .then(function (response) {
          if (!response.ok) throw new Error('Unable to read cart');
          return response.json();
        })
        .then(function (cart) {
          // An add/change was running or finished while this read was in flight: this copy
          // can be older than latestCart, so keep the newer cart instead (slow mobile networks).
          if ((changeCountAtStart !== cartChangeCount || cartWritesInFlight > 0) && latestCart) return latestCart;
          return setLatestCart(cart, false);
        })
        .finally(function () {
          if (cartRequest === request) cartRequest = null;
        });

      cartRequest = request;
      return request;
    }

    function findCartItem(cart, variantId) {
      if (!cart || !Array.isArray(cart.items)) return null;

      return cart.items.find(function (item) {
        return Number(item.variant_id) === Number(variantId);
      }) || null;
    }

    function syncControlFromCart(control, cart, force) {
      if (!control || !cart) return;

      var state = getState(control);
      var variantId = getCurrentVariantId(control);

      if (!force && (state.pending || state.running)) return;

      state.variantId = variantId;
      state.version += 1;

      var item = findCartItem(cart, variantId);
      var quantity = item ? number(item.quantity, 0) : 0;

      state.confirmed = quantity;
      state.desired = quantity;
      state.pending = false;

      render(control, quantity > 0 ? quantity : 1);
      setControlVisibility(control, quantity);
    }

    function syncAllControls(cart, force) {
      document.querySelectorAll(CONTROL_SELECTOR).forEach(function (control) {
        syncControlFromCart(control, cart, force);
      });
    }

    var queuedCartJobs = 0;

    function requestQuantity(variantId, quantity) {
      queuedCartJobs += 1;
      var job = cartQueue.then(function () {
        return runQuantityRequest(variantId, quantity);
      });
      cartQueue = job.catch(function () {}).then(function () {
        queuedCartJobs -= 1;
      });
      return job;
    }

    /* If the customer heads to the cart/checkout while card changes are still queued,
       wait for them to reach Shopify first (max 15s) so nothing is left behind. */
    document.addEventListener('click', function (event) {
      var link = event.target.closest('a[href]');
      if (!link || queuedCartJobs === 0) return;

      var href = link.getAttribute('href') || '';
      if (!/^(https?:\/\/[^/]+)?\/(cart|checkout)(\/|\?|#|$)/.test(href)) return;

      event.preventDefault();

      var waited = 0;
      var idleChecks = 0;
      (function waitForQueue() {
        idleChecks = queuedCartJobs === 0 ? idleChecks + 1 : 0;
        if (idleChecks >= 2 || waited >= 15000) {
          window.location.href = link.href;
          return;
        }
        waited += 250;
        window.setTimeout(waitForQueue, 250);
      })();
    }, true);

    function readCart() {
      return fetch('/cart.js', {
        method: 'GET',
        headers: { Accept: 'application/json' }
      }).then(function (response) {
        if (!response.ok) throw new Error('Unable to read cart');
        return response.json();
      });
    }

    // cart/add.js only returns the added lines, so merge them into the cart we have.
    function mergeAddedLines(cart, added) {
      var merged = Object.assign({}, cart, { items: (cart.items || []).slice() });

      (added.items || []).forEach(function (line) {
        var index = merged.items.findIndex(function (item) { return item.key === line.key; });
        if (index > -1) merged.items[index] = line;
        else merged.items.unshift(line);
      });

      merged.item_count = merged.items.reduce(function (sum, item) { return sum + number(item.quantity, 0); }, 0);
      merged.total_price = merged.items.reduce(function (sum, item) {
        return sum + number(item.final_line_price != null ? item.final_line_price : item.line_price, 0);
      }, 0);
      merged.items_subtotal_price = merged.total_price;
      return merged;
    }

    function postJson(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify(body)
      }).then(function (response) {
        if (!response.ok) {
          return response.text().then(function (message) {
            var error = new Error(message || 'Quantity update failed');
            error.status = response.status;
            throw error;
          });
        }
        return response.json();
      });
    }

    function writeQuantity(cart, variantId, quantity) {
      var item = findCartItem(cart, variantId);

      if (item) {
        return postJson('/cart/change.js', { id: item.key, quantity: quantity });
      }

      if (quantity <= 0) return Promise.resolve(cart);

      return postJson('/cart/add.js', {
        items: [{ id: variantId, quantity: quantity }]
      }).then(function (added) {
        return mergeAddedLines(cart, added);
      });
    }

    function runQuantityRequest(variantId, quantity) {
      cartWritesInFlight += 1;

      /* Jobs run one at a time, so the cart left by the previous job is current and we
         can write straight away. If that cart is missing or turns out to be stale (e.g.
         Bird/Joy Subscriptions changed a line key), read a fresh cart and try once more. */
      var start = latestCart ? Promise.resolve(latestCart) : readCart();

      return start.then(function (cart) {
        return writeQuantity(cart, variantId, quantity).catch(function (error) {
          if (!latestCart || (error.status && error.status >= 500)) throw error;
          return readCart().then(function (freshCart) {
            return writeQuantity(freshCart, variantId, quantity);
          });
        });
      }).then(function (cart) {
        cartWritesInFlight -= 1;
        cartChangeCount += 1;
        lastCartWriteAt = Date.now();
        return setLatestCart(cart, false);
      }, function (error) {
        cartWritesInFlight -= 1;
        cartChangeCount += 1;
        lastCartWriteAt = Date.now();
        throw error;
      });
    }

    function flush(control) {
      var state = getState(control);
      if (state.running || !state.pending) return;

      var variantId = getCurrentVariantId(control);
      var sentQuantity = Math.max(0, number(state.desired, 0));
      var sentVersion = state.version;

      if (!variantId) return;

      state.running = true;

      requestQuantity(variantId, sentQuantity)
        .then(function (cart) {
          setLatestCart(cart, true);

          var currentVariantId = getCurrentVariantId(control);
          var currentDesired = Math.max(0, number(state.desired, 0));

          /* A click happened while the previous request was running.
             Never paint the older response; immediately send the newest value. */
          if (
            currentVariantId !== variantId ||
            currentDesired !== sentQuantity ||
            state.version !== sentVersion
          ) {
            state.running = false;
            window.clearTimeout(state.timer);
            state.timer = window.setTimeout(function () {
              flush(control);
            }, 0);
            return;
          }

          var confirmedItem = findCartItem(cart, variantId);
          var confirmedQuantity = confirmedItem ? number(confirmedItem.quantity, 0) : 0;

          state.confirmed = confirmedQuantity;
          state.desired = confirmedQuantity;
          state.pending = false;
          state.running = false;

          /* Keep the optimistic value if Shopify accepted it. Only correct the
             number when Shopify itself clamps it because of stock/rules. */
          if (confirmedQuantity !== sentQuantity) {
            render(control, confirmedQuantity > 0 ? confirmedQuantity : 1);
          } else {
            render(control, sentQuantity > 0 ? sentQuantity : 1);
          }

          setControlVisibility(control, confirmedQuantity);
        })
        .catch(function () {
          state.running = false;

          fetchCart(true)
            .then(function (cart) {
              var item = findCartItem(cart, getCurrentVariantId(control));
              var confirmedQuantity = item ? number(item.quantity, 0) : 0;

              state.confirmed = confirmedQuantity;
              state.desired = confirmedQuantity;
              state.pending = false;

              render(control, confirmedQuantity > 0 ? confirmedQuantity : 1);
              setControlVisibility(control, confirmedQuantity);
            })
            .catch(function () {
              state.pending = false;
              state.desired = state.confirmed;
              render(control, state.confirmed > 0 ? state.confirmed : 1);
              setControlVisibility(control, state.confirmed);
            });
        });
    }

    function queue(control, quantity) {
      var state = getState(control);
      var variantId = getCurrentVariantId(control);
      var max = getMax(control, variantId);
      var safeQuantity = Math.max(0, Math.min(max, number(quantity, 0)));

      state.variantId = variantId;
      state.desired = safeQuantity;
      state.pending = true;
      state.version += 1;

      /* Update both the number and Add/quantity visibility immediately.
         Shopify is updated in the background and only corrects the UI if
         inventory or quantity rules reject the requested value. */
      render(control, safeQuantity);
      setControlVisibility(control, safeQuantity);

      window.clearTimeout(state.timer);
      if (!state.running) {
        state.timer = window.setTimeout(function () {
          flush(control);
        }, 0);
      }
    }

    function handleAddClick(event) {
      var button = event.target.closest('.custom-add-to-cart-btn-os');
      if (!button) return;

      var addWrapper = button.closest('.custom-addToCart-os');
      if (!addWrapper || addWrapper.dataset.available !== 'true') return;

      var card = button.closest('.card-wrapper-os') || button.closest('.grid__item');
      var control = card ? card.querySelector(CONTROL_SELECTOR) : null;
      if (!control) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      var state = getState(control);
      var current = state.pending && state.desired !== null
        ? number(state.desired, 0)
        : number(state.confirmed, 0);

      queue(control, current > 0 ? current : 1);
    }

    function handleQuantityClick(event) {
      var button = event.target.closest(MINUS_SELECTOR + ', ' + PLUS_SELECTOR);
      if (!button) return;

      var control = button.closest(CONTROL_SELECTOR);
      if (!control) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      var state = getState(control);
      var variantId = getCurrentVariantId(control);
      var current = state.pending && state.desired !== null
        ? number(state.desired, 0)
        : getDisplayedQuantity(control);
      var step = getStep(control, variantId);
      var direction = button.matches(PLUS_SELECTOR) ? 1 : -1;

      queue(control, current + (direction * step));
    }

    function handleVariantChange(event) {
      if (!event.target.closest('[data-joy-card-product-variant-picker]')) return;

      var item = event.target.closest('li');
      var control = item ? item.querySelector(CONTROL_SELECTOR) : null;
      if (!control) return;

      var state = getState(control);
      state.version += 1;
      state.pending = false;
      state.desired = null;
      window.clearTimeout(state.timer);

      window.setTimeout(function () {
        fetchCart(true).then(function (cart) {
          syncControlFromCart(control, cart, true);
        });
      }, 0);
    }

    function initialize() {
      fetchCart(true).then(function (cart) {
        syncAllControls(cart, true);
      });
    }

    document.addEventListener('click', handleAddClick, true);
    document.addEventListener('click', handleQuantityClick, true);
    document.addEventListener('change', handleVariantChange, true);

    /* Carts sent by other scripts (e.g. the collection section's own cart read) can be
       older than our last write if their request started first. Ignore them while our
       writes are queued and shortly after, so they can't undo a card change. */
    function acceptExternalCart(cart) {
      if (queuedCartJobs > 0 || cartWritesInFlight > 0 || Date.now() - lastCartWriteAt < 4000) return;
      setLatestCart(cart, false);
      syncAllControls(cart, false);
    }

    document.addEventListener('cart:updated', function (event) {
      if (event.detail && event.detail.source === 'joy-isolated-card-quantity') return;
      var cart = event.detail && event.detail.cart ? event.detail.cart : null;

      if (cart) acceptExternalCart(cart);
    });

    document.addEventListener('cart:refresh', function (event) {
      if (event.detail && event.detail.source === 'joy-isolated-card-quantity') return;
      var cart = event.detail && event.detail.cart ? event.detail.cart : null;

      if (cart) acceptExternalCart(cart);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
      initialize();
    }

    var grid = document.getElementById('ProductGridContainer');
    if (grid && window.MutationObserver) {
      var observerTimer = null;
      gridObserver = new MutationObserver(function () {
        window.clearTimeout(observerTimer);
        observerTimer = window.setTimeout(function () {
          fetchCart(true).then(function (cart) {
            syncAllControls(cart, false);
          });
        }, 60);
      });
      gridObserver.observe(grid, { childList: true, subtree: true });
    }
  })();
</script>
