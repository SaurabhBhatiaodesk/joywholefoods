    min-width: 0;
    height: 46px;
    min-height: 46px;
    border: 1px solid #8ecbb8;
    border-radius: 7px;
    background: #ffffff;
    overflow: hidden;
    box-sizing: border-box;
  }

  .card-wrapper-os--homepage .joy-card-quantity-button-os {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #3a9b79;
    cursor: pointer;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .card-wrapper-os--homepage .joy-card-quantity-button-os svg {
    display: block;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .card-wrapper-os--homepage .joy-card-quantity-value-os {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    padding: 0 4px;
    color: #00733f;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
