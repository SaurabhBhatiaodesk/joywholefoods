{%- capture card_display_title -%}{%- render 'product-display-title', product: card_product -%}{%- endcapture -%}
{% comment %}
  Renders a product card

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply to the product image card. Values are "arch", "blob", "chevronleft", "chevronright", "diamond", "parallelogram", and "round". (optional)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - show_quick_add: {Boolean} Show the quick add button.
  - section_id: {String} The ID of the section that contains this card.
  - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
  - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
  - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)

  Usage:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}


<style>
  /* Joy fix: keep all collection card action buttons aligned in the same row */
  #product-grid .card-wrapper-os,
  #product-grid .card-wrapper-os .card-wrapper,
  #product-grid .card-wrapper-os .card,
  #product-grid .product-card-wrapper {
    height: 100%;
  }

  #product-grid .card-wrapper-os .card {
    display: flex;
    flex-direction: column;
  }

  #product-grid .card-wrapper-os .product-notification {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    height: 100%;
  }

  #product-grid .card-wrapper-os .card__information {
    flex: 0 0 auto;
  }

  #product-grid .card-wrapper-os .qty-atc-container {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #product-grid .card-wrapper-os .quick-add.no-js-hidden,
  #product-grid .card-wrapper-os product-form,
  #product-grid .card-wrapper-os product-form form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #product-grid .card-wrapper-os .custom-addToCart-os,
  #product-grid .card-wrapper-os .swap-product-btn-os,
  #product-grid .card-wrapper-os .view-product-os,
  #product-grid .card-wrapper-os .restocking-soon-product-os {
    margin-top: auto;
    width: 100%;
  }

  #product-grid .card-wrapper-os .custom-add-to-cart-btn-os,
  #product-grid .card-wrapper-os .swap-product-btn-os {
    width: 100%;
    font-size: 16px;
  }
</style>

<style>
  /* Isolated collection-card quantity UI. It intentionally does not use
     quantity-input / quantity__button / quantity__input, so no theme or
     legacy quantity JavaScript can change the visible number. */
  #product-grid .card-wrapper-os .quantity-selector-and-buyNow-wrapper-os {
    width: 100%;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-control-os {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    width: 100%;
    min-width: 0;
    min-height: 46px;
    border: 1px solid #8ecbb8;
    border-radius: 7px;
    background: #ffffff;
    overflow: hidden;
    box-sizing: border-box;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-button-os {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #3a9b79;
    cursor: pointer;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-button-os svg {
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-button-os:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-value-os {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    padding: 0 4px;
    color: #00733f;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    user-select: none;
  }

  #product-grid .card-wrapper-os .joy-card-quantity-input-os {
    display: none !important;
  }
</style>

<style>
  /* Keep exactly one Back in Stock trigger on collection cards.
     The existing custom button opens the Klaviyo form; app/theme duplicates stay hidden. */
  #product-grid .card-wrapper-os .klaviyo-bis-trigger,
  #product-grid .card-wrapper-os .restocking-soon-product-os {
    display: none !important;
  }

  #product-grid .card-wrapper-os .custom-addToCart-os[data-available="false"] {
    display: block !important;
  }
</style>

