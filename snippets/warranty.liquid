<div class="warranty">
  <div class="warranty_swipe">
    <div class="swipe_group">
      {% if block.settings.warranty_icon1 != blank %}
      <div class="warranty_icon">
        <img src="{{ block.settings.warranty_icon1 | img_url: 'master' }}" alt="warranty_icon">
      </div>
      {% endif %}
      
      {% if block.settings.warranty_description1 != blank %}
       <div class="warranty_description">
        {{ block.settings.warranty_description1 }}
      </div>
      {% endif %}
    </div>

    <div class="swipe_group">
      {% if block.settings.warranty_icon2 != blank %}
      <div class="warranty_icon">
        <img src="{{ block.settings.warranty_icon2 | img_url: 'master' }}" alt="warranty_icon">
      </div>
      {% endif %}
      
      {% if block.settings.warranty_description2 != blank %}
       <div class="warranty_description">
        {{ block.settings.warranty_description2 }}
      </div>
      {% endif %}
    </div>

    <div class="swipe_group">
      {% if block.settings.warranty_icon3 != blank %}
      <div class="warranty_icon">
        <img src="{{ block.settings.warranty_icon3 | img_url: 'master' }}" alt="warranty_icon">
      </div>
      {% endif %}
      
      {% if block.settings.warranty_description3 != blank %}
       <div class="warranty_description">
        {{ block.settings.warranty_description3 }}
      </div>
      {% endif %}
    </div>

    <div class="swipe_group">
      {% if block.settings.warranty_icon4 != blank %}
      <div class="warranty_icon">
        <img src="{{ block.settings.warranty_icon4 | img_url: 'master' }}" alt="warranty_icon">
      </div>
      {% endif %}
      
      {% if block.settings.warranty_description4 != blank %}
       <div class="warranty_description">
        {{ block.settings.warranty_description4 }}
      </div>
      {% endif %}
    </div>

    {% comment %}
    <div class="swipe_group">
      {% if block.settings.warranty_icon5 != blank %}
      <div class="warranty_icon">
        <img src="{{ block.settings.warranty_icon5 | img_url: 'master' }}" alt="warranty_icon">
      </div>
      {% endif %}
      
      {% if block.settings.warranty_description5 != blank %}
       <div class="warranty_description">
        {{ block.settings.warranty_description5 }}
      </div>
      {% endif %}
    </div>
    {% endcomment %}
</div>
</div>
<script>
$(document).ready(function(){
      $('.warranty_swipe').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: true,
        dots: false,
        speed: 300,
        infinite: true,
        autoplaySpeed: 4000,
        autoplay: true,
        responsive: [
      {
        breakpoint: 991,
        settings: {
          slidesToShow: 1,
        }
      }
    ]
  });
});

</script>
<style>
